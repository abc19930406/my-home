---
export const prerender = true;
import { supabase } from '../lib/supabase-client';
import '../styles/japan.css';

// 1. Build Time: 靜態抓取所有分類與品項，確保極速載入
let initialCategories = [];
let initialItems = [];
let initialStatus = { japan_explore_public: false };

try {
  // 抓取分類
  const { data: catData, error: catError } = await supabase
    .from('japan_categories')
    .select('*')
    .order('sort_order', { ascending: true });
  
  if (!catError && catData) {
    initialCategories = catData;
  }

  // 抓取品項
  const { data: itemData, error: itemError } = await supabase
    .from('japan_items')
    .select('*')
    .order('created_at', { ascending: false });

  if (!itemError && itemData) {
    initialItems = itemData;
  }

  // 抓取狀態中的日本探索隱私設定
  const { data: statusData, error: statusError } = await supabase
    .from('status')
    .select('japan_explore_public')
    .eq('id', 1)
    .single();

  if (!statusError && statusData) {
    initialStatus = statusData;
  }
} catch (err) {
  console.warn('⚠️ Build Warning: 日本收藏 Supabase 讀取失敗，使用備用資料。', err);
}

// 備用資料 (以防資料庫在 build 時無法連線)
const fallbackCategories = [
  { id: 1, name: '藥妝', parent_id: null, sort_order: 1 },
  { id: 2, name: '零食', parent_id: null, sort_order: 2 },
  { id: 3, name: '伴手禮', parent_id: null, sort_order: 3 },
  { id: 4, name: '景點', parent_id: null, sort_order: 4 }
];

const categories = initialCategories.length > 0 ? initialCategories : fallbackCategories;
const items = initialItems;

---

  <div class="top-right-auth-container japan-top-auth">
    <div id="auth-guest" style="display: none;">
      <button id="btn-login-modal" class="btn-top-auth">🔑 登入</button>
    </div>
    <div id="auth-user" style="display: none;">
      <button id="btn-logout" class="btn-top-auth">登出</button>
    </div>
  </div>
  <!-- 全域背景覆蓋：確保 Layout 的深色背景被晨霧富士的粉藍灰覆蓋 -->
  <style is:global>
    html, body {
      background-color: #E8EEF5 !important;
      overflow: visible !important;
      height: auto !important;
    }
    body.modal-open {
      overflow: hidden !important;
    }
  </style>

  <div class="japan-body">
    <div class="japan-container">

      <!-- 國家切換器：每個國家獨立收藏世界，比照行程頁的 trip 切換 UI -->
      <section class="countries-scroll-container">
        <div class="countries-list" id="countries-tab-list">
          <!-- JS 動態渲染 -->
        </div>
        <button id="btn-manage-countries" class="btn-manage-countries admin-only" style="display: none;">
          <i class="ti ti-settings"></i> 管理國家
        </button>
      </section>

      <!-- 探索日本搜尋區 -->
      <section class="explore-section" id="explore-japan-section" data-explore-public={String(initialStatus.japan_explore_public)} style={initialStatus.japan_explore_public ? '' : 'display: none;'}>
        <div class="explore-header">
          <span class="explore-title-text">🔍 探索日本</span>
          <!-- 管理開關 (預設隱藏，登入後顯示) -->
          <div id="explore-toggle-container" class="admin-only explore-toggle-container" style="display: none;">
            <span id="explore-toggle-label" class="explore-toggle-label">私人</span>
            <label class="explore-switch">
              <input type="checkbox" id="explore-toggle-checkbox" />
              <span class="explore-switch-slider"></span>
            </label>
          </div>
        </div>
        <p class="explore-sub">搜尋最新網路資訊・網友熱門推薦</p>
        <div class="explore-input-row">
          <input type="text" id="explore-input" 
            placeholder="例如：最近熱門藥妝、京都必去景點..."/>
          <button id="explore-btn">搜尋</button>
        </div>
        <!-- 快速標籤 -->
        <div class="explore-tags">
          <span class="explore-tag">防曬推薦</span>
          <span class="explore-tag">京都景點</span>
          <span class="explore-tag">北海道零食</span>
          <span class="explore-tag">藥妝必買</span>
        </div>
        <!-- 結果區（預設隱藏） -->
        <div id="explore-results" style="display:none;"></div>
      </section>

      <!-- 2. 分類篩選列 -->
      <section class="japan-filter-bar">
        <!-- 收藏品即時搜尋框 -->
        <div class="collection-search-container">
          <div class="collection-search-wrapper">
            <i class="ti ti-search search-icon"></i>
            <input type="text" id="collection-search-input" placeholder="搜尋收藏品名或備註..." autocomplete="off" />
            <button type="button" id="btn-collection-search-clear" style="display: none;">✕</button>
          </div>
        </div>

        <div class="filter-row">
          <!-- 主分類標籤區 -->
          <div class="main-categories" id="main-categories-filter">
            <button class="tag-btn active" data-cat-id="all">全部</button>
            {categories.filter(c => c.parent_id === null).map(cat => (
              <button class="tag-btn" data-cat-id={cat.id}>{cat.name}</button>
            ))}
            <button class="tag-btn" data-cat-id="recommend">網友推薦</button>
          </div>

          <!-- 登入後管理按鈕 (預設隱藏)：管理分類僅管理員；新增品項對管理員與該國被授權朋友皆開放 -->
          <div class="admin-actions" id="collection-admin-actions" style="display: none;">
            <button id="btn-toggle-manage" class="btn-action admin-only" style="display: none;">
              <i class="ti ti-settings"></i> 管理分類
            </button>
            <button id="btn-open-add-modal" class="btn-action-primary" style="display: none;">
              <i class="ti ti-plus"></i> 新增品項
            </button>
          </div>
        </div>

        <!-- 子分類展開區 (JS 動態控制隱顯) -->
        <div class="sub-categories" id="sub-categories-filter" style="display: none;">
          <!-- JS 動態插入子分類標籤 -->
        </div>
      </section>

      <!-- 3. 管理分類面板 (點「管理分類」展開) -->
      <section id="manage-category-panel" class="manage-panel">
        <h3><i class="ti ti-category"></i> 分類管理面板</h3>
        <div class="category-rows" id="manage-category-rows">
          <!-- JS 動態生成主分類與對應的子分類列 -->
        </div>
        <div class="panel-footer">
          <button id="btn-add-main-cat" class="btn-dashed-add">
            <i class="ti ti-plus"></i> 新增主分類
          </button>
          <button id="btn-close-manage" class="btn-action-primary">完成</button>
        </div>
      </section>

      <!-- 4. 磚牆式卡片區 -->
      <main class="items-grid" id="japan-items-grid">
        {items.map(item => {
          // 找出分類名稱
          const cat = categories.find(c => c.id === item.category_id);
          const catName = cat ? cat.name : '未分類';
          return (
            <div 
              class="japan-card" 
              data-id={item.id} 
              data-category-id={item.category_id}
              data-name={item.name}
              data-note={item.note || ''}
              data-image-url={item.image_url || ''}
            >
              <!-- 登入後編輯/刪除圖示 -->
              <div class="card-admin-actions admin-only" style="display: none;">
                <button class="btn-card-icon btn-edit" title="編輯">
                  <i class="ti ti-pencil"></i>
                </button>
                <button class="btn-card-icon btn-delete" title="刪除">
                  <i class="ti ti-trash"></i>
                </button>
              </div>

              <!-- 照片區 -->
              <div class="card-img-wrap">
                {item.image_url ? (
                  <img src={item.image_url} alt={item.name} class="item-image" loading="lazy" />
                ) : (
                  <div class="card-img-placeholder">
                    <i class="ti ti-photo-off"></i>
                    <span>NO IMAGE</span>
                  </div>
                )}
              </div>

              <!-- 品項資訊 -->
              <div class="card-info">
                <div class="card-title-row">
                  <h4 class="card-title">{item.name}</h4>
                  <span class="card-tag">{catName}</span>
                </div>
                {item.note && <p class="card-note">{item.note}</p>}
              </div>
            </div>
          );
        })}
        {items.length === 0 && (
          <div class="empty-state" id="empty-state-msg">
            目前沒有任何收藏品項，登入後即可開始新增！
          </div>
        )}
      </main>

      <!-- 5. 新增/編輯 Modal -->
      <div id="item-modal" class="japan-modal-overlay modal-overlay">
        <div class="modal-box">
          <div class="modal-header">
            <h3 id="modal-title">新增品項</h3>
            <button id="btn-item-modal-close" class="btn-modal-close">&times;</button>
          </div>
          <form id="item-form">
            <div class="modal-body">
              <input type="hidden" id="form-item-id" />
              
              <!-- 品項名稱 -->
              <div class="form-group">
                <label for="form-item-name">品項名稱 <span style="color: var(--japan-danger)">*</span></label>
                <input type="text" id="form-item-name" required placeholder="請輸入品項名稱，例如：合利他命 EX Plus" />
              </div>

              <!-- 主分類下拉選單 -->
              <div class="form-group">
                <label for="form-main-cat">主分類</label>
                <select id="form-main-cat">
                  <option value="">請選擇主分類</option>
                  <!-- JS 動態插入 -->
                </select>
              </div>

              <!-- 子分類下拉選單 (選完主分類後動態顯示) -->
              <div class="form-group" id="form-sub-cat-group" style="display: none;">
                <label for="form-sub-cat">子分類</label>
                <select id="form-sub-cat">
                  <option value="">請選擇子分類</option>
                  <!-- JS 動態插入 -->
                </select>
              </div>

              <!-- 國家(新增時預設為目前切換中的國家，可調整；編輯時帶入該品項現有國家) -->
              <div class="form-group">
                <label for="form-item-country">國家</label>
                <select id="form-item-country">
                  <!-- JS 動態插入 -->
                </select>
              </div>

              <!-- 歸屬行程(選填，預設一般收藏；選項僅列出上方「國家」下的行程) -->
              <div class="form-group">
                <label for="form-item-trip">歸屬</label>
                <select id="form-item-trip">
                  <option value="">一般收藏</option>
                  <!-- JS 動態插入行程清單 -->
                </select>
              </div>

              <!-- 備註 -->
              <div class="form-group">
                <label for="form-item-note">備註</label>
                <textarea id="form-item-note" rows="3" placeholder="例如：代購熱門款、每日兩錠、購買地點等..."></textarea>
              </div>

              <!-- 照片上傳 -->
              <div class="form-group">
                <label>照片上傳</label>
                <div class="file-upload-wrap">
                  <i class="ti ti-cloud-upload upload-icon"></i>
                  <p class="upload-text">點擊或拖曳照片至此上傳</p>
                  <input type="file" id="form-item-image-file" accept="image/*" />
                </div>
                <input type="hidden" id="form-item-image-url" />
                <div class="upload-preview" id="image-upload-preview">
                  <!-- 上傳預覽圖 -->
                  <img src="" id="image-preview-img" alt="Preview" />
                  <button type="button" class="btn-remove-preview" id="btn-remove-image">&times;</button>
                </div>
              </div>
            </div>
            
            <div class="modal-footer">
              <button type="button" id="btn-modal-cancel" class="btn-action">取消</button>
              <button type="submit" id="btn-modal-save" class="btn-action-primary">儲存</button>
            </div>
          </form>
        </div>
      </div>



    </div>
  </div>

  <!-- Lightbox 圖片放大檢視 -->
  <div id="japan-lightbox" style="display:none;">
    <div id="japan-lightbox-overlay"></div>
    <img id="japan-lightbox-img" src="" alt="" />
    <button id="japan-lightbox-close">✕</button>
  </div>

  <!-- 網友推薦收藏分類選擇 Modal -->
  <div id="collect-modal" class="japan-modal-overlay modal-overlay" style="display:none;">
    <div class="modal-box">
      <div class="modal-header">
        <h3>📌 選擇收藏分類</h3>
        <button type="button" class="btn-modal-close" id="btn-collect-modal-close">&times;</button>
      </div>
      <div class="modal-body" style="padding: 24px;">
        <p style="margin: 0 0 16px 0; font-size: 0.9rem; color: var(--japan-text); line-height: 1.5;">請選擇要將「<span id="collect-item-name-preview" style="font-weight: 600; color: var(--japan-primary);"></span>」加入的分類：</p>
        <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
          <label for="collect-category-select" style="font-size: 0.85rem; font-weight: 500; color: var(--japan-text-muted);">選擇分類 <span style="color: var(--japan-danger)">*</span></label>
          <select id="collect-category-select" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(112, 144, 184, 0.3); font-family: inherit; font-size: 0.9rem; color: var(--japan-text); background: white; outline: none; transition: border-color 0.2s;">
            <option value="">-- 請選擇分類 --</option>
            <!-- JS 動態插入所有主分類與子分類 -->
          </select>
        </div>
      </div>
      <div class="modal-footer" style="padding: 20px 24px; border-top: 1px solid rgba(112, 144, 184, 0.15); display: flex; justify-content: flex-end; gap: 12px; background: rgba(100, 120, 160, 0.02);">
        <button type="button" id="btn-collect-cancel" class="btn-action">取消</button>
        <button type="button" id="btn-collect-confirm" class="btn-action-primary">確認收藏</button>
      </div>
    </div>
  </div>

  <!-- 國家管理 Modal（僅管理員） -->
  <div id="japan-country-modal" class="japan-modal-overlay modal-overlay" style="display:none;">
    <div class="modal-box">
      <div class="modal-header">
        <h3>🌏 管理國家</h3>
        <button type="button" class="btn-modal-close" id="btn-japan-country-close">&times;</button>
      </div>
      <div class="modal-body">
        <form id="japan-country-form">
          <input type="hidden" id="japan-country-id" />
          <div class="form-group">
            <label for="japan-country-name">國家名稱 <span style="color: var(--japan-danger)">*</span></label>
            <input type="text" id="japan-country-name" required placeholder="例如：韓國" />
          </div>
          <div class="form-group">
            <label for="japan-country-emoji">Emoji（選填）</label>
            <input type="text" id="japan-country-emoji" placeholder="🇰🇷" maxlength="8" />
          </div>
          <div class="country-form-actions">
            <button type="button" id="btn-japan-country-cancel-edit" class="btn-action" style="display: none;">取消編輯</button>
            <button type="submit" id="btn-japan-country-submit" class="btn-action-primary">新增國家</button>
          </div>
        </form>
        <div id="japan-countries-list" class="country-manage-list"></div>
      </div>
    </div>
  </div>

  <!-- 國家協作者管理 Modal（僅管理員，從國家管理清單的 👥 按鈕開啟） -->
  <div id="japan-country-collaborators-modal" class="japan-modal-overlay modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width: 420px;">
      <div class="modal-header">
        <h3>👥 <span id="country-collaborators-modal-title">管理協作者</span></h3>
        <button type="button" class="btn-modal-close" id="btn-japan-country-collaborators-close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="japan-country-collaborators-list" class="country-manage-list" style="margin-top: 0;"></div>
        <form id="add-country-collaborator-form" class="country-form-actions" style="margin-top: 16px; flex-wrap: wrap;">
          <input
            type="email"
            id="new-country-collaborator-email"
            placeholder="協作者 email"
            required
            autocomplete="off"
            style="flex: 1; min-width: 180px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--japan-border); font-family: inherit; font-size: 0.85rem;"
          />
          <button type="submit" class="btn-action-primary">＋ 新增</button>
        </form>
        <p style="font-size: 0.78rem; color: var(--japan-text-muted); margin-top: 10px; line-height: 1.5;">
          被授權的朋友登入後，可以在這個國家新增收藏品，並編輯/刪除自己新增的品項。
        </p>
      </div>
    </div>
  </div>

  <!-- 訪客登入 Modal -->
  <div id="auth-modal" class="japan-modal-overlay modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width: 400px;">
      <div class="modal-header">
        <h3>🔑 登入願望清單</h3>
        <button type="button" class="btn-modal-close" id="btn-auth-close">&times;</button>
      </div>
      <div class="modal-body auth-modal-content">
        <button type="button" id="btn-google-login" class="btn-google-auth">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="18" height="18" alt="Google">
          使用 Google 帳號登入
        </button>
        <div class="auth-divider">或</div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="auth-email" placeholder="輸入您的 Email" />
        </div>
        <div class="form-group">
          <label>密碼</label>
          <input type="password" id="auth-password" placeholder="輸入您的密碼" />
        </div>
        <button type="button" id="btn-email-login" class="btn-action-primary" style="width: 100%;">登入</button>
      </div>
    </div>
  </div>

  <!-- 願望清單名單 Modal -->
  <div id="wishlist-names-modal" class="japan-modal-overlay modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width: 400px;">
      <div class="modal-header">
        <h3>❤️ 想買清單</h3>
        <button type="button" class="btn-modal-close" id="btn-wishlist-names-close">&times;</button>
      </div>
      <div class="modal-body" id="wishlist-names-container">
        <!-- JS dynamically inserts names here -->
      </div>
    </div>
  </div>

  <!-- Toast 訊息通知 -->
  <div id="japan-toast" class="toast">已成功儲存</div>


<script>
  import { getSupabaseBrowserClient } from '../lib/supabase-browser.js';

  const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL || '';

  const supabase = getSupabaseBrowserClient();

  // 多國家擴充(MC-4)：行程→收藏單向連動，提前綁定監聽器(在任何 await 之前)，
  // 比照本專案 Race Condition 防護慣例；實際處理邏輯(applyTripCountryLink)在下方定義，
  // 因為是一般 function 宣告會被提升(hoisting)，此處引用時尚未執行到定義處也不影響
  window.addEventListener('trip-changed', (e) => {
    const { tripId, countryId } = e.detail || {};
    applyTripCountryLink(tripId, countryId);
  });

  const toast = document.getElementById('japan-toast');

  // 本地快取狀態
  let categoriesCache = [];
  let itemsCache = [];
  let allWishlistItems = [];
  let allowedUsersCache = [];
  let currentMainFilter = 'all';
  let currentSubFilter = 'all';
  let currentSearchQuery = '';
  let currentFriendFilter = 'all';
  let isAdminUser = false;
  let isAllowedUser = false;
  let currentUser = null;
  let tripsCache = [];
  // 多國家擴充(MC-2)：countries 快取、目前切換中的國家(預設 is_default 國家)、國家管理 Modal 編輯狀態
  let countriesCache = [];
  let selectedCountryId = null;
  let editingCountryId = null;
  // 多國家擴充(MC-5b)：目前登入者被授權新增品項的國家 id 集合(country_collaborators)，管理員不需要這份清單(恆通過)
  let myAuthorizedCountryIds = new Set();
  // 國家協作者管理 Modal 目前操作中的國家 id/名稱
  let managingCollaboratorsCountryId = null;
  // 探索/搜尋功能目前僅日本專屬(不做多國適配)，此區塊需同時滿足「公開或管理員」與「目前切換中的國家是日本」；
  // 快取 status.japan_explore_public 的查詢結果，切換國家時不必重查資料庫
  let exploreIsPublic = false;
  // trip_id -> { can_edit_wishlist, can_edit_itinerary }（V2 階段 4 任務三：協作者的行程收藏願望清單權限）
  // 本元件自己查一次，不與 TripPlanner.astro 共用快取
  let collaboratorTripPermissions = {};
  // 收藏依行程篩選：'all'(全部,預設) / 'general'(僅一般收藏) / 某個行程的 id(該行程＋一般收藏)
  // 獨立於「行程」分頁目前選中的行程，任何人(管理員、朋友、訪客)皆可使用
  let selectedTripFilterId = 'all';

  // --- Utility Functions ---
  function showToast(message) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2000);
  }

  // 是否可操作此品項的願望清單愛心/數量：管理員恆可；該品項所屬國家的被授權協作者恆可(不分是否歸屬行程，
  // 呼應 MC-5a can_wishlist_item() 新增的第四分支)；其餘一般收藏品(trip_id 為空)看白名單；
  // 行程收藏品看該行程 trip_collaborators 的 can_edit_wishlist
  function canWishlistItem(item) {
    if (isAdminUser) return true;
    if (!item) return false;
    if (myAuthorizedCountryIds.has(String(item.country_id))) return true;
    if (!item.trip_id) return isAllowedUser;
    const perm = collaboratorTripPermissions[item.trip_id];
    return !!(perm && perm.can_edit_wishlist);
  }

  // 是否可編輯/刪除此品項：管理員恆可；否則僅該品項的建立者本人可以(MC-5b 規則 2)
  function canEditOwnItem(item) {
    if (isAdminUser) return true;
    if (!item || !currentUser) return false;
    return item.created_by != null && String(item.created_by) === String(currentUser.id);
  }

  // 目前登入者是否為指定國家的被授權協作者(或管理員，恆可)
  function isAuthorizedForCountry(countryId) {
    if (isAdminUser) return true;
    if (!countryId) return false;
    return myAuthorizedCountryIds.has(String(countryId));
  }

  async function loadMyCountryCollaborations(email) {
    try {
      const { data, error } = await supabase
        .from('country_collaborators')
        .select('country_id')
        .ilike('user_email', email);
      if (error) throw error;
      myAuthorizedCountryIds = new Set((data || []).map(row => String(row.country_id)));
    } catch (err) {
      console.warn('⚠️ country_collaborators 查詢失敗（國家協作授權）：', err);
      myAuthorizedCountryIds = new Set();
    }
  }

  // 「新增品項」入口與管理分類按鈕的顯示：管理分類僅管理員(靠既有 admin-only 機制)；
  // 新增品項對管理員或目前切換中國家的被授權協作者開放，切換國家時需重新評估
  function updateCollectionAdminActionsUI() {
    const wrapper = document.getElementById('collection-admin-actions');
    const openAddBtn = document.getElementById('btn-open-add-modal');
    const canAdd = isAuthorizedForCountry(selectedCountryId);
    if (wrapper) wrapper.style.display = (isAdminUser || canAdd) ? 'flex' : 'none';
    if (openAddBtn) openAddBtn.style.display = (isAdminUser || canAdd) ? 'inline-flex' : 'none';
  }

  // 探索/搜尋功能目前僅日本專屬(不做多國適配)：用 is_default 判斷「目前切換中的國家是不是日本」，
  // 不寫死國名字串比對(國家名稱可被管理員改名，is_default 才是穩定的判斷依據)；
  // 非日本一律隱藏整塊，是日本才回到原本「管理員恆可見／訪客看公開開關」的邏輯
  function updateExploreSectionVisibility() {
    const exploreSection = document.getElementById('explore-japan-section');
    if (!exploreSection) return;
    const currentCountry = countriesCache.find(c => String(c.id) === String(selectedCountryId));
    const isJapan = !!(currentCountry && currentCountry.is_default);
    if (!isJapan) {
      exploreSection.style.display = 'none';
      return;
    }
    exploreSection.style.display = (isAdminUser || exploreIsPublic) ? 'block' : 'none';
  }

  async function loadCollaboratorPermissions(email) {
    try {
      const { data, error } = await supabase
        .from('trip_collaborators')
        .select('trip_id, can_edit_wishlist, can_edit_itinerary')
        .ilike('user_email', email);
      if (error) throw error;
      const map = {};
      (data || []).forEach(row => { map[row.trip_id] = row; });
      collaboratorTripPermissions = map;
    } catch (err) {
      console.warn('⚠️ trip_collaborators 查詢失敗（協作者權限）：', err);
      collaboratorTripPermissions = {};
    }
  }

  // --- 讀取資料庫快取與驗證 ---
  async function init(session = null) {
    // 1. 抓取資料以維持最新狀態
    const { data: cats } = await supabase.from('japan_categories').select('*').order('sort_order', { ascending: true });
    const { data: items } = await supabase.from('japan_items').select('*').order('created_at', { ascending: false });
    const { data: wishlists } = await supabase.from('wishlist_items').select('*');
    const { data: trips } = await supabase.from('trips').select('id, name, country_id').order('created_at', { ascending: true });

    categoriesCache = cats || [];
    itemsCache = items || [];
    allWishlistItems = wishlists || [];
    tripsCache = trips || [];

    // 多國家擴充(MC-2)：載入國家清單；首次載入時預設選中 is_default 國家(日本)，
    // 之後每次 init() 重跑(登入/登出、儲存後刷新)都保留使用者目前切換的國家，不重置
    await loadCountries();

    // 2. 身分驗證與即時探索隱私狀態檢查
    const { data: statusObj } = await supabase.from('status').select('japan_explore_public').eq('id', 1).single();
    const isPublic = statusObj ? !!statusObj.japan_explore_public : false;
    exploreIsPublic = isPublic; // 快取供 updateExploreSectionVisibility() 在切換國家時重用，不必重查資料庫

    if (session) {
      currentUser = session.user;
      if (currentUser.email === adminEmail) {
        isAdminUser = true;
        isAllowedUser = true;
        collaboratorTripPermissions = {};
        const { data: users } = await supabase.from('allowed_users').select('*');
        allowedUsersCache = users || [];
      } else {
        const { data: allowedUser, error: allowedError } = await supabase
          .from('allowed_users')
          .select('id')
          .ilike('email', currentUser.email)
          .single();

        if (allowedUser) {
          isAllowedUser = true;
          // 協作者權限查詢：與白名單機制各自獨立，行程收藏品的願望清單依此判斷
          await loadCollaboratorPermissions(currentUser.email);
          await loadMyCountryCollaborations(currentUser.email);
        } else {
          // 即使不在願望清單白名單，只要是任一國家的協作者也放行——country_collaborators
          // 是獨立授權機制，不依附 allowed_users 白名單(MC-5a 的 can_wishlist_item() 已允許
          // 國家協作者標願望，前端頁面守門也要跟著放行，否則會在能寫入前就先被踢出)
          await loadMyCountryCollaborations(currentUser.email);
          if (myAuthorizedCountryIds.size === 0) {
            alert('此功能僅限受邀用戶使用。');
            await supabase.auth.signOut();
            window.location.reload();
            return;
          }
        }
      }
    }

    updateHeaderAuthUI();

    const toggleCheckbox = document.getElementById('explore-toggle-checkbox');
    const toggleLabel = document.getElementById('explore-toggle-label');

    if (isAdminUser) {
      document.querySelectorAll('.admin-only').forEach(el => {
        el.style.display = 'flex';
      });
      const loginHint = document.getElementById('login-hint');
      if (loginHint) loginHint.style.display = 'none';

      // 載入管理選單與 Modal 相關下拉
      renderManageCategoryRows();
      populateMainCategoryDropdown();
      populateCountryDropdown(selectedCountryId);
      populateTripDropdown();

      // 初始化開關狀態
      if (toggleCheckbox) {
        toggleCheckbox.checked = isPublic;
      }
      if (toggleLabel) {
        toggleLabel.textContent = isPublic ? '公開' : '私人';
        if (isPublic) {
          toggleLabel.classList.add('is-public');
        } else {
          toggleLabel.classList.remove('is-public');
        }
      }

      // 監聽管理開關狀態變更
      toggleCheckbox?.addEventListener('change', async (e) => {
        const checked = e.target.checked;
        try {
          const { error } = await supabase
            .from('status')
            .update({ japan_explore_public: checked })
            .eq('id', 1);
            
          if (error) throw error;
          
          showToast(checked ? '探索功能已公開' : '探索功能已設為私人');
          
          if (toggleLabel) {
            toggleLabel.textContent = checked ? '公開' : '私人';
            if (checked) {
              toggleLabel.classList.add('is-public');
            } else {
              toggleLabel.classList.remove('is-public');
            }
          }
        } catch (err) {
          console.error('Failed to update explore visibility:', err);
          showToast('設定失敗，請稍後重試！');
          if (toggleCheckbox) {
            toggleCheckbox.checked = !checked;
          }
        }
      });
    }

    // 探索/搜尋功能僅日本專屬：不論管理員或訪客，只有目前切換中的國家是日本才顯示
    updateExploreSectionVisibility();

    // 3. 重繪篩選器與卡片 (確保 Client Side 最新)
    updateCollectionAdminActionsUI();
    renderFilterBar();
    filterAndRenderItems();
  }

  // --- 多國家擴充(MC-2)：countries 載入與切換器 ---
  async function loadCountries() {
    const { data, error } = await supabase.from('countries').select('*').order('sort_order', { ascending: true });
    if (error) { console.warn('loadCountries failed:', error); return; }
    countriesCache = data || [];
    if (!selectedCountryId || !countriesCache.some(c => String(c.id) === String(selectedCountryId))) {
      // 首次載入，或目前選中的國家已被刪除：回退到 is_default 國家(日本)
      const defaultCountry = countriesCache.find(c => c.is_default) || countriesCache[0];
      selectedCountryId = defaultCountry ? String(defaultCountry.id) : null;
    }
    renderCountrySwitcher();
  }

  function renderCountrySwitcher() {
    const container = document.getElementById('countries-tab-list');
    if (!container) return;
    container.innerHTML = countriesCache.map(c => `
      <button class="country-tab ${String(c.id) === String(selectedCountryId) ? 'active' : ''}" data-country-id="${c.id}">
        <span>${c.emoji || '🌍'}</span> ${c.name}
      </button>
    `).join('');

    container.querySelectorAll('.country-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.countryId;
        if (!id || id === selectedCountryId) return;
        selectedCountryId = id;
        // 國家是收藏的最上層維度：切換國家時，既有的「依行程篩選」重置為「全部」，
        // 在新國家範圍內重新運作(國家 → 該國行程 → 品項)
        selectedTripFilterId = 'all';
        renderCountrySwitcher();
        updateCollectionAdminActionsUI();
        updateExploreSectionVisibility();
        renderFilterBar();
        filterAndRenderItems();
      });
    });
  }

  // 多國家擴充(MC-4)：行程→收藏單向連動。切換行程時自動把國家切換器切到該行程所屬國家，
  // 並套用該行程的收藏篩選(沿用既有 V2 階段 3 的行程篩選邏輯，比對 id)。
  // 邊界：countryId 為空、或對應不到 countriesCache 內任何國家(例如收藏頁的 countries 還沒載入完成，
  // 或理論上不存在的情況)時，維持目前國家不動，不報錯不清空——只有真正找得到才切換。
  // 單向：這裡只有「行程→收藏」，收藏頁手動切換國家不會回頭觸發行程切換。
  function applyTripCountryLink(tripId, countryId) {
    if (!countryId) return;
    const countryExists = countriesCache.some(c => String(c.id) === String(countryId));
    if (!countryExists) return;

    selectedCountryId = String(countryId);
    selectedTripFilterId = tripId ? String(tripId) : 'all';
    renderCountrySwitcher();
    updateCollectionAdminActionsUI();
    updateExploreSectionVisibility();
    renderFilterBar();
    filterAndRenderItems();
  }

  function updateHeaderAuthUI() {
    const authGuest = document.getElementById('auth-guest');
    const authUser = document.getElementById('auth-user');
    
    if (isAdminUser) {
      if (authGuest) authGuest.style.display = 'none';
      if (authUser) authUser.style.display = 'block';
    } else if (isAllowedUser && currentUser) {
      if (authGuest) authGuest.style.display = 'none';
      if (authUser) authUser.style.display = 'block';
    } else {
      if (authGuest) authGuest.style.display = 'block';
      if (authUser) authUser.style.display = 'none';
    }
  }

  // --- 渲染分類篩選列 ---
  function renderFilterBar() {
    const mainContainer = document.getElementById('main-categories-filter');
    if (!mainContainer) return;

    // 保留 "全部"
    const activeId = currentMainFilter;
    const mainCats = categoriesCache.filter(c => c.parent_id === null);

    let html = `<button class="tag-btn ${activeId === 'all' ? 'active' : ''}" data-cat-id="all">全部</button>`;
    mainCats.forEach(cat => {
      html += `<button class="tag-btn ${String(cat.id) === String(activeId) ? 'active' : ''}" data-cat-id="${cat.id}">${cat.name}</button>`;
    });
    
    // 願望清單功能 (個人化)
    if (isAdminUser || isAllowedUser) {
      html += `<button class="tag-btn ${activeId === 'wishlist' ? 'active' : ''}" data-cat-id="wishlist">❤️ 我想買</button>`;
    }
    
    html += `<button class="tag-btn ${activeId === 'recommend' ? 'active' : ''}" data-cat-id="recommend">網友推薦</button>`;
    
    if (isAdminUser) {
      const uniqueEmails = [...new Set(allWishlistItems.map(w => w.user_email))];
      let friendOpts = '<option value="all">👥 朋友清單</option>';
      friendOpts += '<option value="__everyone__">所有人</option>';
      uniqueEmails.forEach(email => {
        const wItem = allWishlistItems.find(w => w.user_email === email);
        const name = wItem?.user_name || email;
        friendOpts += `<option value="${email}" ${currentFriendFilter === email ? 'selected' : ''}>${name}</option>`;
      });
      html += `<div class="friend-filter-container"><select class="friend-select" id="friend-filter-select">${friendOpts}</select></div>`;
    }

    // 收藏依行程篩選：任何人(管理員、朋友、訪客)皆可使用，與「行程」分頁目前選中的行程無關；
    // 國家為上層維度，此下拉只列出「目前切換中的國家」底下的行程(國家 → 該國行程 → 品項)
    const tripsInCountry = tripsCache.filter(trip => String(trip.country_id) === String(selectedCountryId));
    let tripFilterOpts = `<option value="all" ${selectedTripFilterId === 'all' ? 'selected' : ''}>全部</option>`;
    tripFilterOpts += `<option value="general" ${selectedTripFilterId === 'general' ? 'selected' : ''}>一般收藏</option>`;
    tripsInCountry.forEach(trip => {
      tripFilterOpts += `<option value="${trip.id}" ${selectedTripFilterId === String(trip.id) ? 'selected' : ''}>${trip.name}</option>`;
    });
    html += `<div class="trip-scope-filter-container"><select class="trip-scope-select" id="trip-scope-filter-select">${tripFilterOpts}</select></div>`;

    mainContainer.innerHTML = html;

    // 綁定主分類點擊事件
    mainContainer.querySelectorAll('.tag-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.dataset.catId || 'all';
        selectMainCategory(id);
      });
    });

    const friendSelect = document.getElementById('friend-filter-select');
    if (friendSelect) {
      friendSelect.addEventListener('change', (e) => {
        currentFriendFilter = e.target.value;
        filterAndRenderItems();
      });
    }

    const tripScopeSelect = document.getElementById('trip-scope-filter-select');
    if (tripScopeSelect) {
      tripScopeSelect.addEventListener('change', (e) => {
        selectedTripFilterId = e.target.value;
        filterAndRenderItems();
      });
    }

    // 渲染子分類
    renderSubFilterBar();
  }

  function renderSubFilterBar() {
    const subContainer = document.getElementById('sub-categories-filter');
    if (!subContainer) return;

    if (currentMainFilter === 'all' || currentMainFilter === 'recommend') {
      subContainer.style.display = 'none';
      subContainer.innerHTML = '';
      return;
    }

    let subs = [];

    if (currentMainFilter === 'wishlist') {
      // 國家為最上層維度：子分類選項只計算目前切換中國家的品項，與 filterAndRenderItems() 的範圍一致
      const itemsInCountry = itemsCache.filter(item => String(item.country_id) === String(selectedCountryId));
      let wishlistItems = [];
      if (isAdminUser) {
        wishlistItems = itemsInCountry.filter(item => item.owner_wishlist === true);
      } else if (isAllowedUser && currentUser) {
        const userWishlistIds = allWishlistItems
          .filter(w => w.user_id === currentUser.id)
          .map(w => String(w.japan_item_id));
        wishlistItems = itemsInCountry.filter(item => userWishlistIds.includes(String(item.id)));
      }
      const catIds = [...new Set(wishlistItems.map(item => String(item.category_id)))];
      subs = catIds.map(id => categoriesCache.find(c => String(c.id) === id)).filter(Boolean);
    } else {
      subs = categoriesCache.filter(c => String(c.parent_id) === String(currentMainFilter));
    }

    if (subs.length === 0) {
      subContainer.style.display = 'none';
      subContainer.innerHTML = '';
      return;
    }

    subContainer.style.display = 'flex';
    let html = `<button class="tag-btn sub-tag-btn ${currentSubFilter === 'all' ? 'active' : ''}" data-sub-id="all">全部</button>`;
    subs.forEach(sub => {
      html += `<button class="tag-btn sub-tag-btn ${String(sub.id) === String(currentSubFilter) ? 'active' : ''}" data-sub-id="${sub.id}">${sub.name}</button>`;
    });
    subContainer.innerHTML = html;

    // 綁定子分類點擊事件
    subContainer.querySelectorAll('.tag-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const subId = e.currentTarget.dataset.subId || 'all';
        currentSubFilter = subId;
        subContainer.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
        e.currentTarget.classList.add('active');
        filterAndRenderItems();
      });
    });
  }

  function selectMainCategory(id) {
    currentMainFilter = id;
    currentSubFilter = 'all'; // 重設子分類
    
    // 更新主分類樣式
    const mainContainer = document.getElementById('main-categories-filter');
    mainContainer?.querySelectorAll('.tag-btn').forEach(btn => {
      if (btn.dataset.catId === id) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    renderSubFilterBar();
    filterAndRenderItems();
  }

  function updateCardFooter(card, itemId) {
    if (!card) return;
    const cItem = itemsCache.find(i => String(i.id) === String(itemId));
    const isOwnerWishlisted = cItem ? cItem.owner_wishlist : false;
    const wItemsForFooter = allWishlistItems.filter(w => String(w.japan_item_id) === String(itemId));
    const peopleCount = wItemsForFooter.length + (isOwnerWishlisted ? 1 : 0);
    
    const infoDiv = card.querySelector('.card-info');
    if (!infoDiv) return;
    
    let footer = infoDiv.querySelector('.wishlist-footer');
    if (peopleCount > 0 && (isAdminUser || isAllowedUser)) {
      if (!footer) {
        footer = document.createElement('div');
        footer.className = 'wishlist-footer';
        footer.dataset.id = itemId;
        infoDiv.appendChild(footer);
      }
      footer.innerHTML = `❤️ ${peopleCount} 人想買`;
    } else {
      if (footer) footer.remove();
    }
  }

  // --- 卡片過濾與繪製 (磚牆式 Masonry) ---
  function filterAndRenderItems() {
    const grid = document.getElementById('japan-items-grid');
    if (!grid) return;

    let filtered = [...itemsCache];

    // 國家為最上層維度：每個國家獨立收藏世界，精確篩選出目前切換中的國家(比對 country_id，不做聯集)
    if (selectedCountryId) {
      filtered = filtered.filter(item => String(item.country_id) === String(selectedCountryId));
    }

    // 依行程篩選：獨立於「行程」分頁目前選中的行程，任何人皆可選擇
    if (selectedTripFilterId === 'general') {
      filtered = filtered.filter(item => !item.trip_id);
    } else if (selectedTripFilterId !== 'all') {
      filtered = filtered.filter(item => !item.trip_id || String(item.trip_id) === String(selectedTripFilterId));
    }
    // selectedTripFilterId === 'all'：不套用任何行程篩選

    if (currentMainFilter === 'wishlist') {
      if (isAdminUser) {
        filtered = filtered.filter(item => item.owner_wishlist === true);
      } else if (isAllowedUser && currentUser) {
        const userWishlistIds = allWishlistItems
          .filter(w => w.user_id === currentUser.id)
          .map(w => String(w.japan_item_id));
        filtered = filtered.filter(item => userWishlistIds.includes(String(item.id)));
      } else {
        filtered = [];
      }

      if (currentSubFilter !== 'all') {
        filtered = filtered.filter(item => String(item.category_id) === String(currentSubFilter));
      }
    } else if (currentMainFilter === 'recommend') {
      filtered = filtered.filter(item => item.note === '網友推薦');
    } else if (currentMainFilter !== 'all') {
      // 獲取該主分類下的所有子分類 ID
      const subIds = categoriesCache
        .filter(c => String(c.parent_id) === String(currentMainFilter))
        .map(c => String(c.id));
      
      if (currentSubFilter === 'all') {
        // 顯示主分類品項 + 所有子分類品項
        filtered = filtered.filter(item => 
          String(item.category_id) === String(currentMainFilter) || 
          subIds.includes(String(item.category_id))
        );
      } else {
        // 僅顯示特定子分類品項
        filtered = filtered.filter(item => String(item.category_id) === String(currentSubFilter));
      }
    }

    // 關鍵字即時模糊搜尋 (模糊比對 name 與 note)
    if (currentSearchQuery.trim()) {
      const q = currentSearchQuery.trim().toLowerCase();
      filtered = filtered.filter(item => {
        const nameMatch = item.name ? item.name.toLowerCase().includes(q) : false;
        const noteMatch = item.note ? item.note.toLowerCase().includes(q) : false;
        return nameMatch || noteMatch;
      });
    }
    
    // 朋友清單過濾 (僅管理員)
    if (isAdminUser && currentFriendFilter === '__everyone__') {
      const itemsWithWishlist = new Set(allWishlistItems.map(w => String(w.japan_item_id)));
      filtered = filtered.filter(item => itemsWithWishlist.has(String(item.id)) || item.owner_wishlist);
    } else if (isAdminUser && currentFriendFilter !== 'all') {
      const userWishlistIds = allWishlistItems
        .filter(w => w.user_email === currentFriendFilter)
        .map(w => String(w.japan_item_id));
      filtered = filtered.filter(item => userWishlistIds.includes(String(item.id)));
    }

    if (filtered.length === 0) {
      grid.innerHTML = `
        <div class="empty-state" id="empty-state-msg">
          此分類下目前沒有任何品項！
        </div>
      `;
      return;
    }

    let html = '';
    filtered.forEach(item => {
      const cat = categoriesCache.find(c => String(c.id) === String(item.category_id));
      const catName = cat ? cat.name : '未分類';
      const trip = item.trip_id ? tripsCache.find(t => String(t.id) === String(item.trip_id)) : null;
      const tripBadgeHtml = trip ? `<span class="card-trip-badge">${trip.name}</span>` : '';
      const imgTag = item.image_url
        ? `<img src="${item.image_url}" alt="${item.name}" class="item-image" loading="lazy" />` 
        : `
          <div class="card-img-placeholder">
            <i class="ti ti-photo-off"></i>
            <span>NO IMAGE</span>
          </div>
        `;

      const noteTag = item.note ? `<p class="card-note">${item.note}</p>` : '';

      const isOwnerWishlisted = item.owner_wishlist === true;
      let adminCheckboxHtml = '';
      if (isAdminUser) {
        adminCheckboxHtml = `
          <div class="wishlist-checkbox-admin ${isOwnerWishlisted ? 'active' : ''}" data-id="${item.id}" title="管理者願望清單">
            ${isOwnerWishlisted ? '❤️' : '🤍'}
          </div>
        `;
        if (isOwnerWishlisted) {
          adminCheckboxHtml += `
            <div class="quantity-adjuster admin" data-id="${item.id}" data-role="admin">
              <button class="btn-qty-minus" data-action="qty-minus" data-item-id="${item.id}" data-role="admin">-</button>
              <span>${item.owner_quantity || 1}</span>
              <button class="btn-qty-plus" data-action="qty-plus" data-item-id="${item.id}" data-role="admin">+</button>
            </div>
          `;
        }
      }

      let userCheckboxHtml = '';
      if (!isAdminUser && currentUser) {
        const userWishlistItem = allWishlistItems.find(w => String(w.japan_item_id) === String(item.id) && w.user_id === currentUser.id);
        const isUserWishlisted = !!userWishlistItem;
        const canEditThisItem = canWishlistItem(item);
        // 權限被撤後,即使不能再新增/調整,仍要讓使用者能看到並收回自己先前標過的
        // (DELETE 政策未變動,永遠允許收回;數量調整器則需要有權限才顯示,避免點了卻被 RLS 擋下)
        if (canEditThisItem || isUserWishlisted) {
          userCheckboxHtml = `
            <div class="wishlist-checkbox-user ${isUserWishlisted ? 'active' : ''}" data-id="${item.id}" title="加入我的清單">
              📌
            </div>
          `;
          if (isUserWishlisted && canEditThisItem) {
            userCheckboxHtml += `
              <div class="quantity-adjuster user" data-id="${item.id}" data-role="user">
                <button class="btn-qty-minus" data-action="qty-minus" data-item-id="${item.id}" data-role="user">-</button>
                <span>${userWishlistItem.quantity || 1}</span>
                <button class="btn-qty-plus" data-action="qty-plus" data-item-id="${item.id}" data-role="user">+</button>
              </div>
            `;
          }
        }
      }

      const wItemsForFooter = allWishlistItems.filter(w => String(w.japan_item_id) === String(item.id));
      const peopleCount = wItemsForFooter.length + (isOwnerWishlisted ? 1 : 0);
      let countHtml = '';
      if (isAdminUser || isAllowedUser) {
        if (peopleCount > 0) {
          countHtml = `<div class="wishlist-footer" data-id="${item.id}">❤️ ${peopleCount} 人想買</div>`;
        }
      }

      // 編輯/刪除鈕：管理員恆可；被授權朋友僅能對自己建立(created_by = 自己)的品項顯示，
      // 別人建立的品項(含管理員建立的)只能看與標願望，不顯示編輯/刪除
      const canEditThisCard = canEditOwnItem(item);

      html += `
        <div
          class="japan-card"
          data-id="${item.id}"
          data-category-id="${item.category_id}"
          data-name="${item.name}"
          data-note="${item.note || ''}"
          data-image-url="${item.image_url || ''}"
        >
          ${adminCheckboxHtml}
          ${userCheckboxHtml}
          <div class="card-admin-actions" style="display: ${canEditThisCard ? 'flex' : 'none'};">
            <button class="btn-card-icon btn-edit" title="編輯">
              <i class="ti ti-pencil"></i>
            </button>
            <button class="btn-card-icon btn-delete" title="刪除">
              <i class="ti ti-trash"></i>
            </button>
          </div>
          <div class="card-img-wrap">
            ${imgTag}
          </div>
          <div class="card-info">
            <div class="card-title-row">
              <h4 class="card-title">${item.name}</h4>
              <div class="card-tags-group">
                <span class="card-tag">${catName}</span>
                ${tripBadgeHtml}
              </div>
            </div>
            ${noteTag}
            ${countHtml}
          </div>
        </div>
      `;
    });

    grid.innerHTML = html;
  }

  // --- 管理分類面板渲染 ---
  function renderManageCategoryRows() {
    const container = document.getElementById('manage-category-rows');
    if (!container) return;

    const mainCats = categoriesCache.filter(c => c.parent_id === null);
    let html = '';

    mainCats.forEach(main => {
      const subs = categoriesCache.filter(c => String(c.parent_id) === String(main.id));
      let subTags = '';
      
      subs.forEach(sub => {
        subTags += `
          <span class="sub-manage-tag">
            ${sub.name}
            <button class="btn-remove-sub" data-sub-id="${sub.id}">&times;</button>
          </span>
        `;
      });

      html += `
        <div class="category-row" data-main-id="${main.id}">
          <div class="main-cat-title">
            <span>${main.name}</span>
            <button class="btn-delete-main" data-main-id="${main.id}" title="刪除此主分類及其子分類">
              <i class="ti ti-trash"></i>
            </button>
          </div>
          <div class="sub-tags-wrap">
            ${subTags}
            <button class="btn-dashed-add btn-add-sub-cat" data-parent-id="${main.id}">
              <i class="ti ti-plus"></i> 子分類
            </button>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;

    // 綁定刪除主分類事件
    container.querySelectorAll('.btn-delete-main').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.currentTarget.dataset.mainId;
        if (!id) return;
        if (confirm('確定要刪除此主分類嗎？這會連同其下的所有子分類一併刪除，且無法復原！')) {
          const { error } = await supabase.from('japan_categories').delete().eq('id', id);
          if (!error) {
            showToast('主分類已刪除');
            categoriesCache = categoriesCache.filter(c => String(c.id) !== String(id) && String(c.parent_id) !== String(id));
            renderManageCategoryRows();
            renderFilterBar();
            populateMainCategoryDropdown();
            filterAndRenderItems();
            triggerBuildWebhook();
          } else {
            alert('刪除失敗：' + error.message);
          }
        }
      });
    });

    // 綁定刪除子分類事件
    container.querySelectorAll('.btn-remove-sub').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.currentTarget.dataset.subId;
        if (!id) return;
        if (confirm('確定要刪除此子分類嗎？')) {
          const { error } = await supabase.from('japan_categories').delete().eq('id', id);
          if (!error) {
            showToast('子分類已刪除');
            categoriesCache = categoriesCache.filter(c => String(c.id) !== String(id));
            renderManageCategoryRows();
            renderFilterBar();
            populateMainCategoryDropdown();
            filterAndRenderItems();
            triggerBuildWebhook();
          } else {
            alert('刪除失敗：' + error.message);
          }
        }
      });
    });

    // 綁定新增子分類事件
    container.querySelectorAll('.btn-add-sub-cat').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const parentId = e.currentTarget.dataset.parentId;
        if (!parentId) return;
        const name = prompt('請輸入子分類名稱：');
        if (!name || name.trim() === '') return;

        const { data, error } = await supabase
          .from('japan_categories')
          .insert([{ name: name.trim(), parent_id: parseInt(parentId), sort_order: 10 }])
          .select()
          .single();

        if (!error && data) {
          showToast('已新增子分類');
          categoriesCache.push(data);
          renderManageCategoryRows();
          renderFilterBar();
          populateMainCategoryDropdown();
          triggerBuildWebhook();
        } else {
          alert('新增失敗：' + (error?.message || '未知錯誤'));
        }
      });
    });
  }

  // --- 新增主分類 ---
  const btnAddMainCat = document.getElementById('btn-add-main-cat');
  btnAddMainCat?.addEventListener('click', async () => {
    const name = prompt('請輸入主分類名稱：');
    if (!name || name.trim() === '') return;

    // 計算 sort_order
    const mainCats = categoriesCache.filter(c => c.parent_id === null);
    const maxSort = mainCats.reduce((max, c) => Math.max(max, c.sort_order || 0), 0);

    const { data, error } = await supabase
      .from('japan_categories')
      .insert([{ name: name.trim(), parent_id: null, sort_order: maxSort + 1 }])
      .select()
      .single();

    if (!error && data) {
      showToast('已新增主分類');
      categoriesCache.push(data);
      renderManageCategoryRows();
      renderFilterBar();
      populateMainCategoryDropdown();
      triggerBuildWebhook();
    } else {
      alert('新增失敗：' + (error?.message || '未知錯誤'));
    }
  });

  // --- Modal 表單連動與欄位處理 ---
  const mainCatSelect = document.getElementById('form-main-cat');
  const subCatGroup = document.getElementById('form-sub-cat-group');
  const subCatSelect = document.getElementById('form-sub-cat');

  function populateMainCategoryDropdown() {
    if (!mainCatSelect) return;
    const mainCats = categoriesCache.filter(c => c.parent_id === null);

    let html = '<option value="">請選擇主分類</option>';
    mainCats.forEach(cat => {
      html += `<option value="${cat.id}">${cat.name}</option>`;
    });
    mainCatSelect.innerHTML = html;
  }

  // --- 新增/編輯品項 Modal 的「歸屬」下拉：一般收藏 + 行程清單，僅列出指定國家底下的行程 ---
  function populateTripDropdown(countryId = selectedCountryId) {
    if (!tripSelect) return;
    const scopedTrips = tripsCache.filter(trip => String(trip.country_id) === String(countryId));
    let html = '<option value="">一般收藏</option>';
    scopedTrips.forEach(trip => {
      html += `<option value="${trip.id}">${trip.name}</option>`;
    });
    tripSelect.innerHTML = html;
  }

  // --- 新增/編輯品項 Modal 的「國家」下拉：管理員看得到全部國家；被授權協作者只看得到自己被授權的國家，
  // 避免選到自己沒有寫入權限的國家導致送出時被 RLS 擋下。若正在編輯的品項所屬國家不在授權清單內
  // (例如授權被收回)，仍強制併入選項，確保下拉一定有值可對應到該品項現有的國家，不會被悄悄改掉 ---
  function populateCountryDropdown(selectedId) {
    if (!countrySelect) return;
    let options = isAdminUser
      ? countriesCache
      : countriesCache.filter(c => myAuthorizedCountryIds.has(String(c.id)));
    if (selectedId && !options.some(c => String(c.id) === String(selectedId))) {
      const current = countriesCache.find(c => String(c.id) === String(selectedId));
      if (current) options = [...options, current];
    }
    countrySelect.innerHTML = options.map(c =>
      `<option value="${c.id}" ${String(c.id) === String(selectedId) ? 'selected' : ''}>${c.emoji ? c.emoji + ' ' : ''}${c.name}</option>`
    ).join('');
  }

  // ============================================================
  // 國家管理 CRUD(MC-2，僅管理員)：新增/編輯/刪除國家，比照短文分類管理的既有模式
  // ============================================================
  function resetCountryForm() {
    editingCountryId = null;
    document.getElementById('japan-country-form')?.reset();
    const submitBtn = document.getElementById('btn-japan-country-submit');
    if (submitBtn) submitBtn.textContent = '新增國家';
    const cancelBtn = document.getElementById('btn-japan-country-cancel-edit');
    if (cancelBtn) cancelBtn.style.display = 'none';
  }

  function renderCountriesManageList() {
    const container = document.getElementById('japan-countries-list');
    if (!container) return;
    container.innerHTML = countriesCache.map((c, idx) => `
      <div class="country-manage-row" data-id="${c.id}">
        <span class="country-manage-row-name">${c.emoji ? c.emoji + ' ' : ''}${c.name}${c.is_default ? '<em>（預設）</em>' : ''}</span>
        <div class="country-manage-row-actions">
          <button type="button" class="btn-country-up" data-id="${c.id}" ${idx === 0 ? 'disabled' : ''}>↑</button>
          <button type="button" class="btn-country-down" data-id="${c.id}" ${idx === countriesCache.length - 1 ? 'disabled' : ''}>↓</button>
          <button type="button" class="btn-country-collaborators" data-id="${c.id}" data-name="${c.name}" title="管理協作者">👥</button>
          <button type="button" class="btn-country-edit" data-id="${c.id}">編輯</button>
          <button type="button" class="btn-country-delete" data-id="${c.id}" ${c.is_default ? 'disabled title="預設國家不可刪除"' : ''}>刪除</button>
        </div>
      </div>
    `).join('');
  }

  function closeCountryModal() {
    const m = document.getElementById('japan-country-modal');
    if (m) {
      m.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
    resetCountryForm();
  }

  document.getElementById('btn-manage-countries')?.addEventListener('click', () => {
    const m = document.getElementById('japan-country-modal');
    if (!m) return;
    renderCountriesManageList();
    m.style.display = 'flex';
    document.body.classList.add('modal-open');
  });
  document.getElementById('btn-japan-country-close')?.addEventListener('click', closeCountryModal);
  document.getElementById('btn-japan-country-cancel-edit')?.addEventListener('click', resetCountryForm);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const m = document.getElementById('japan-country-modal');
    if (m && m.style.display === 'flex') closeCountryModal();
  });

  document.getElementById('japan-country-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('japan-country-name').value.trim();
    const emoji = document.getElementById('japan-country-emoji').value.trim();
    if (!name) return;

    if (editingCountryId) {
      const { data, error } = await supabase.from('countries').update({ name, emoji: emoji || null }).eq('id', editingCountryId).select();
      if (error) { alert('更新失敗：' + error.message); return; }
      if (!data || data.length === 0) { alert('沒有任何資料被更新，可能已被刪除或沒有權限。'); return; }
    } else {
      const maxOrder = countriesCache.reduce((max, c) => Math.max(max, c.sort_order || 0), 0);
      const { data, error } = await supabase.from('countries').insert({ name, emoji: emoji || null, sort_order: maxOrder + 1 }).select();
      if (error) { alert('新增失敗：' + error.message); return; }
      if (!data || data.length === 0) { alert('新增失敗，沒有取得新資料。'); return; }
    }
    resetCountryForm();
    await loadCountries();
    renderCountriesManageList();
    showToast('已儲存');
  });

  document.getElementById('japan-countries-list')?.addEventListener('click', async (e) => {
    const target = e.target;
    const editBtn = target.closest('.btn-country-edit');
    const deleteBtn = target.closest('.btn-country-delete');
    const upBtn = target.closest('.btn-country-up');
    const downBtn = target.closest('.btn-country-down');
    const collaboratorsBtn = target.closest('.btn-country-collaborators');

    if (collaboratorsBtn) {
      openCountryCollaboratorsModal(collaboratorsBtn.dataset.id, collaboratorsBtn.dataset.name);
      return;
    }

    if (editBtn) {
      const id = editBtn.dataset.id;
      const row = countriesCache.find(c => String(c.id) === String(id));
      if (!row) return;
      editingCountryId = row.id;
      document.getElementById('japan-country-name').value = row.name;
      document.getElementById('japan-country-emoji').value = row.emoji || '';
      const submitBtn = document.getElementById('btn-japan-country-submit');
      if (submitBtn) submitBtn.textContent = '儲存修改';
      const cancelBtn = document.getElementById('btn-japan-country-cancel-edit');
      if (cancelBtn) cancelBtn.style.display = 'inline-block';
      return;
    }

    if (deleteBtn) {
      if (deleteBtn.disabled) return;
      const id = deleteBtn.dataset.id;
      const row = countriesCache.find(c => String(c.id) === String(id));
      if (!row || !id) return;
      // 「日本」(is_default) 保護：無論底下有沒有資料，一律不可刪除，避免 MC-1 建立的
      // country_id DEFAULT(寫死指向這一列的 uuid)在它被刪除後變成懸空參照
      if (row.is_default) {
        alert(`預設國家（${row.name}）不可刪除。`);
        return;
      }
      const ok = confirm(`確定要刪除國家「${row.name}」嗎？`);
      if (!ok) return;
      const { data, error } = await supabase.from('countries').delete().eq('id', id).select();
      if (error) {
        // 23503 = FK ON DELETE RESTRICT 擋下：底下仍有收藏品或行程掛著這個國家，轉成友善提示
        if (error.code === '23503') {
          alert(`無法刪除「${row.name}」：這個國家底下仍有收藏品或行程，請先清空或轉移後再刪除。`);
        } else {
          alert('刪除失敗：' + error.message);
        }
        return;
      }
      if (!data || data.length === 0) {
        alert('沒有任何資料被刪除，可能已被刪除或沒有權限。');
        return;
      }
      showToast('國家已刪除');
      if (editingCountryId === id) resetCountryForm();
      await loadCountries();
      renderCountriesManageList();
      filterAndRenderItems();
      return;
    }

    if (upBtn || downBtn) {
      const id = (upBtn || downBtn).dataset.id;
      const idx = countriesCache.findIndex(c => String(c.id) === String(id));
      if (idx === -1) return;
      const swapIdx = upBtn ? idx - 1 : idx + 1;
      if (swapIdx < 0 || swapIdx >= countriesCache.length) return;
      const a = countriesCache[idx];
      const b = countriesCache[swapIdx];
      const [resA, resB] = await Promise.all([
        supabase.from('countries').update({ sort_order: b.sort_order }).eq('id', a.id).select(),
        supabase.from('countries').update({ sort_order: a.sort_order }).eq('id', b.id).select(),
      ]);
      if (resA.error || resB.error) {
        alert('排序更新失敗：' + (resA.error?.message || resB.error?.message));
        return;
      }
      await loadCountries();
      renderCountriesManageList();
    }
  });

  // ============================================================
  // 國家協作者管理 Modal(MC-5b，僅管理員)：比照 TripPlanner.astro 的 trip_collaborators 管理模式，
  // 但國家層級只有單一權限(能不能在此國新增品項)，不需要像行程協作者那樣的多個開關
  // ============================================================
  async function loadCountryCollaborators() {
    const listEl = document.getElementById('japan-country-collaborators-list');
    if (!listEl || !managingCollaboratorsCountryId) return;
    listEl.innerHTML = '<div class="empty-state">載入中...</div>';
    const { data, error } = await supabase
      .from('country_collaborators')
      .select('*')
      .eq('country_id', managingCollaboratorsCountryId)
      .order('created_at', { ascending: true });

    if (error) {
      listEl.innerHTML = '<div class="empty-state">載入協作者失敗</div>';
      console.error('載入國家協作者失敗:', error);
      return;
    }
    renderCountryCollaborators(data || []);
  }

  function renderCountryCollaborators(list) {
    const listEl = document.getElementById('japan-country-collaborators-list');
    if (!listEl) return;
    if (list.length === 0) {
      listEl.innerHTML = '<div class="empty-state">尚無協作者</div>';
      return;
    }
    listEl.innerHTML = list.map(c => `
      <div class="country-manage-row" data-id="${c.id}">
        <span class="country-manage-row-name">${c.user_email}</span>
        <div class="country-manage-row-actions">
          <button type="button" class="btn-country-collaborator-remove" data-id="${c.id}">移除</button>
        </div>
      </div>
    `).join('');
  }

  function openCountryCollaboratorsModal(countryId, countryName) {
    if (!countryId) return;
    managingCollaboratorsCountryId = countryId;
    const titleEl = document.getElementById('country-collaborators-modal-title');
    if (titleEl) titleEl.textContent = `管理協作者－${countryName || ''}`;
    const form = document.getElementById('add-country-collaborator-form');
    form?.reset();
    loadCountryCollaborators();
    const m = document.getElementById('japan-country-collaborators-modal');
    if (m) {
      m.style.display = 'flex';
      document.body.classList.add('modal-open');
    }
  }

  function closeCountryCollaboratorsModal() {
    const m = document.getElementById('japan-country-collaborators-modal');
    if (m) {
      m.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
    managingCollaboratorsCountryId = null;
  }

  document.getElementById('btn-japan-country-collaborators-close')?.addEventListener('click', closeCountryCollaboratorsModal);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const m = document.getElementById('japan-country-collaborators-modal');
    if (m && m.style.display === 'flex') closeCountryCollaboratorsModal();
  });

  document.getElementById('add-country-collaborator-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!managingCollaboratorsCountryId) return;
    const emailInput = document.getElementById('new-country-collaborator-email');
    const user_email = (emailInput.value || '').trim().toLowerCase();
    if (!user_email) return;

    const { data, error } = await supabase
      .from('country_collaborators')
      .insert([{ country_id: managingCollaboratorsCountryId, user_email }])
      .select();

    if (error) {
      alert('新增協作者失敗：' + error.message);
      return;
    }
    if (!data || data.length === 0) {
      alert('新增協作者失敗：沒有權限或資料未寫入');
      return;
    }
    emailInput.value = '';
    showToast('已新增協作者');
    await loadCountryCollaborators();
  });

  document.getElementById('japan-country-collaborators-list')?.addEventListener('click', async (e) => {
    const removeBtn = e.target.closest('.btn-country-collaborator-remove');
    if (!removeBtn) return;
    const id = removeBtn.dataset.id;
    if (!confirm('確定要移除這位協作者嗎？')) return;

    const { data, error } = await supabase
      .from('country_collaborators')
      .delete()
      .eq('id', id)
      .select();

    if (error) {
      alert('移除協作者失敗：' + error.message);
      return;
    }
    if (!data || data.length === 0) {
      alert('移除協作者失敗：沒有權限或資料不存在');
      return;
    }
    showToast('已移除協作者');
    await loadCountryCollaborators();
  });

  mainCatSelect?.addEventListener('change', () => {
    const mainId = mainCatSelect.value;
    updateSubCategoryDropdown(mainId);
  });

  function updateSubCategoryDropdown(mainId, selectedSubId = '') {
    if (!subCatSelect || !subCatGroup) return;

    if (!mainId) {
      subCatGroup.style.display = 'none';
      subCatSelect.innerHTML = '<option value="">請選擇子分類</option>';
      return;
    }

    const subs = categoriesCache.filter(c => String(c.parent_id) === String(mainId));
    if (subs.length === 0) {
      subCatGroup.style.display = 'none';
      subCatSelect.innerHTML = '<option value="">請選擇子分類</option>';
      return;
    }

    subCatGroup.style.display = 'block';
    let html = '<option value="">請選擇子分類</option>';
    subs.forEach(sub => {
      html += `<option value="${sub.id}" ${String(sub.id) === String(selectedSubId) ? 'selected' : ''}>${sub.name}</option>`;
    });
    subCatSelect.innerHTML = html;
  }

  // --- 照片上傳控制 ---
  const fileInput = document.getElementById('form-item-image-file');
  const imageUrlInput = document.getElementById('form-item-image-url');
  const previewDiv = document.getElementById('image-upload-preview');
  const previewImg = document.getElementById('image-preview-img');
  const btnRemoveImage = document.getElementById('btn-remove-image');

  fileInput?.addEventListener('change', async (e) => {
    const target = e.target;
    const file = target.files?.[0];
    if (!file) return;

    const uploadText = document.querySelector('.file-upload-wrap .upload-text');
    const uploadIcon = document.querySelector('.file-upload-wrap .upload-icon');
    
    if (uploadText) uploadText.textContent = '上傳中...';
    if (uploadIcon) uploadIcon.className = 'ti ti-loader-2 upload-icon animate-spin';

    try {
      // 檔名加上時間戳記防重複
      const ext = file.name.split('.').pop();
      const fileName = `item_${Date.now()}.${ext}`;
      
      const { data, error } = await supabase.storage
        .from('japan_images')
        .upload(fileName, file, {
          cacheControl: '3600',
          upsert: false
        });

      if (error) throw error;

      // 獲取公開連結
      const { data: { publicUrl } } = supabase.storage
        .from('japan_images')
        .getPublicUrl(fileName);

      imageUrlInput.value = publicUrl;
      if (previewImg) previewImg.src = publicUrl;
      if (previewDiv) previewDiv.style.display = 'block';
      showToast('照片上傳成功');
    } catch (err) {
      alert('照片上傳失敗：' + (err.message || err));
    } finally {
      if (uploadText) uploadText.textContent = '點擊或拖曳照片至此上傳';
      if (uploadIcon) uploadIcon.className = 'ti ti-cloud-upload upload-icon';
    }
  });

  btnRemoveImage?.addEventListener('click', () => {
    imageUrlInput.value = '';
    fileInput.value = '';
    if (previewDiv) previewDiv.style.display = 'none';
    if (previewImg) previewImg.src = '';
  });

  // --- Modal 控制開關 ---
  const modal = document.getElementById('item-modal');
  const modalTitle = document.getElementById('modal-title');
  const form = document.getElementById('item-form');
  const itemIdInput = document.getElementById('form-item-id');
  const itemNameInput = document.getElementById('form-item-name');
  const itemNoteInput = document.getElementById('form-item-note');
  const countrySelect = document.getElementById('form-item-country');
  const tripSelect = document.getElementById('form-item-trip');

  // 國家改變時，「歸屬」的行程下拉要重新限定在新選的國家範圍內；
  // 若原本選的行程不屬於新國家，重置為「一般收藏」，避免 item.country_id 與 item.trip_id 所屬國家對不上
  countrySelect?.addEventListener('change', () => {
    const newCountryId = countrySelect.value;
    const prevTripId = tripSelect ? tripSelect.value : '';
    populateTripDropdown(newCountryId);
    if (tripSelect) {
      const stillValid = prevTripId && tripsCache.some(trip => String(trip.id) === String(prevTripId) && String(trip.country_id) === String(newCountryId));
      tripSelect.value = stillValid ? prevTripId : '';
    }
  });

  function openModal(isEdit = false, item = null) {
    if (!modal) return;
    
    form.reset();
    itemIdInput.value = '';
    imageUrlInput.value = '';
    if (previewDiv) previewDiv.style.display = 'none';
    if (previewImg) previewImg.src = '';
    if (subCatGroup) subCatGroup.style.display = 'none';

    if (isEdit && item) {
      if (modalTitle) modalTitle.textContent = '編輯品項';
      itemIdInput.value = item.id;
      itemNameInput.value = item.name;
      itemNoteInput.value = item.note || '';
      imageUrlInput.value = item.image_url || '';
      // 國家帶入該品項現有國家，行程下拉隨之限定在同一國家範圍內，才能正確帶入現有的歸屬行程
      populateCountryDropdown(item.country_id);
      populateTripDropdown(item.country_id);
      if (tripSelect) tripSelect.value = item.trip_id ? String(item.trip_id) : '';

      if (item.image_url) {
        if (previewImg) previewImg.src = item.image_url;
        if (previewDiv) previewDiv.style.display = 'block';
      }

      // 計算所屬的父/子分類
      const currentCat = categoriesCache.find(c => String(c.id) === String(item.category_id));
      if (currentCat) {
        if (currentCat.parent_id === null) {
          // 主分類
          mainCatSelect.value = String(currentCat.id);
          updateSubCategoryDropdown(String(currentCat.id));
        } else {
          // 子分類
          mainCatSelect.value = String(currentCat.parent_id);
          updateSubCategoryDropdown(String(currentCat.parent_id), String(currentCat.id));
        }
      }
    } else {
      if (modalTitle) modalTitle.textContent = '新增品項';
      // 新增品項：國家預設為目前切換中的國家，行程下拉對應限定在該國範圍
      populateCountryDropdown(selectedCountryId);
      populateTripDropdown(selectedCountryId);
    }

    modal.style.display = 'flex';
    document.body.classList.add('modal-open');
  }

  function closeModal() {
    if (modal) {
      modal.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  }

  document.getElementById('btn-open-add-modal')?.addEventListener('click', () => openModal(false));
  document.getElementById('btn-item-modal-close')?.addEventListener('click', closeModal);
  document.getElementById('btn-modal-cancel')?.addEventListener('click', closeModal);

  // --- 管理面板顯隱 ---
  const managePanel = document.getElementById('manage-category-panel');
  document.getElementById('btn-toggle-manage')?.addEventListener('click', () => {
    if (!managePanel) return;
    const isShowing = managePanel.style.display === 'block';
    managePanel.style.display = isShowing ? 'none' : 'block';
    if (!isShowing) {
      managePanel.scrollIntoView({ behavior: 'smooth' });
    }
  });

  document.getElementById('btn-close-manage')?.addEventListener('click', () => {
    if (managePanel) managePanel.style.display = 'none';
  });

  // --- 表單提交儲存 ---
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('btn-modal-save');
    if (saveBtn) saveBtn.disabled = true;

    const id = itemIdInput.value;
    const name = itemNameInput.value.trim();
    const note = itemNoteInput.value.trim();
    const image_url = imageUrlInput.value;

    // 分類判定：若有選子分類，則用子分類 ID，否則用主分類 ID
    const mainId = mainCatSelect.value;
    const subId = subCatSelect.value;
    const category_id = subId ? parseInt(subId) : (mainId ? parseInt(mainId) : null);

    // 歸屬行程：空字串代表一般收藏，存 null
    const tripIdValue = tripSelect && tripSelect.value ? tripSelect.value : null;
    // 國家：下拉一律有值(populateCountryDropdown 已預先選好)，萬一沒有則退回目前切換中的國家
    const countryIdValue = countrySelect && countrySelect.value ? countrySelect.value : selectedCountryId;

    const itemData = {
      name,
      note: note || null,
      image_url: image_url || null,
      category_id,
      country_id: countryIdValue,
      trip_id: tripIdValue
    };

    try {
      let error;
      let returnedData = null;

      if (id) {
        // 編輯更新：加 .select() 檢查實際受影響筆數——RLS 擋下 UPDATE 不會回傳錯誤，只會影響 0 筆，
        // 若只看 error 會誤判成功(MC-5b 起被授權朋友只能改自己的品項，這個坑就真的可能踩到)
        const { data: updateData, error: err } = await supabase.from('japan_items').update(itemData).eq('id', id).select();
        error = err;
        if (!err && (!updateData || updateData.length === 0)) {
          error = { message: '沒有權限或資料不存在，未實際更新' };
        }
      } else {
        // 新增品項：一律帶 created_by = 自己(MC-5a 設計要求新寫入一律帶值)；
        // 管理員新增也一併記錄，維持資料一致性
        const { data, error: err } = await supabase
          .from('japan_items')
          .insert([{ ...itemData, created_by: currentUser?.id || null }])
          .select()
          .single();
        error = err;
        returnedData = data;
      }

      if (error) throw error;

      showToast(id ? '品項已成功更新' : '已成功新增收藏品項');
      closeModal();
      init(); // 重新讀取資料，重置快取並渲染
      triggerBuildWebhook();
    } catch (err) {
      alert('儲存失敗：' + (err.message || err));
    } finally {
      if (saveBtn) saveBtn.disabled = false;
    }
  });

  // --- 磚牆卡片點擊事件委派 (編輯 & 刪除) ---
  const itemsGrid = document.getElementById('japan-items-grid');
  itemsGrid?.addEventListener('click', async (e) => {
    const target = e.target;
    const btnEdit = target.closest('.btn-edit');
    const btnDelete = target.closest('.btn-delete');
    const btnWishlistAdmin = target.closest('.wishlist-checkbox-admin');
    const btnWishlistUser = target.closest('.wishlist-checkbox-user');
    const footerCount = target.closest('.wishlist-footer');
    const btnQtyMinus = target.closest('.btn-qty-minus') || target.closest('[data-action="qty-minus"]');
    const btnQtyPlus = target.closest('.btn-qty-plus') || target.closest('[data-action="qty-plus"]');

    if (btnQtyMinus || btnQtyPlus) {
      const btn = (btnQtyMinus || btnQtyPlus);
      const adjuster = target.closest('.quantity-adjuster');
      if (!adjuster && !btn) return;
      
      const id = btn.dataset.itemId || adjuster?.dataset.id;
      const role = btn.dataset.role || adjuster?.dataset.role;
      const span = adjuster ? adjuster.querySelector('span') : target.closest('.quantity-adjuster')?.querySelector('span');
      if (!id || !span) return;
      
      let currentQty = parseInt(span.textContent || '1');
      const newVal = btnQtyMinus ? Math.max(1, currentQty - 1) : currentQty + 1;
      
      if (currentQty === newVal) return;
      
      // 即時更新 UI
      span.textContent = String(newVal);
      
      // 背景更新資料庫與快取
      if (role === 'admin' && isAdminUser) {
        const cItem = itemsCache.find(i => String(i.id) === String(id));
        if (cItem) cItem.owner_quantity = newVal;
        supabase.from('japan_items').update({ owner_quantity: newVal }).eq('id', id).then(({error}) => {
          if (error) console.error('Admin quantity update failed', error);
        });
      } else if (role === 'user' && currentUser) {
        const wItem = allWishlistItems.find(w => String(w.japan_item_id) === String(id) && w.user_id === currentUser.id);
        if (wItem) wItem.quantity = newVal;
        
        supabase
          .from('wishlist_items')
          .update({ quantity: newVal })
          .eq('japan_item_id', parseInt(id))
          .eq('user_id', currentUser.id)
          .then(({ error }) => {
            if (error) {
              console.error('wishlist update error:', error.message, error.details, error.hint);
            }
          });
      }
      return;
    }

    // Admin toggles owner_wishlist
    if (btnWishlistAdmin) {
      const id = btnWishlistAdmin.dataset.id;
      const isActive = btnWishlistAdmin.classList.contains('active');
      const newVal = !isActive;
      
      const { error } = await supabase.from('japan_items').update({ owner_wishlist: newVal, owner_quantity: 1 }).eq('id', id);
      if (!error) {
        btnWishlistAdmin.classList.toggle('active');
        btnWishlistAdmin.innerHTML = newVal ? '❤️' : '🤍';
        const cItem = itemsCache.find(i => String(i.id) === String(id));
        if (cItem) {
          cItem.owner_wishlist = newVal;
          cItem.owner_quantity = 1;
        }
        const card = btnWishlistAdmin.closest('.japan-card');
        if (card) {
          if (newVal) {
            if (!card.querySelector(`.quantity-adjuster.admin[data-id="${id}"]`)) {
              const adj = document.createElement('div');
              adj.className = 'quantity-adjuster admin';
              adj.dataset.id = String(id);
              adj.dataset.role = 'admin';
              adj.innerHTML = `
                <button class="btn-qty-minus" data-action="qty-minus" data-item-id="${id}" data-role="admin">-</button>
                <span>1</span>
                <button class="btn-qty-plus" data-action="qty-plus" data-item-id="${id}" data-role="admin">+</button>
              `;
              btnWishlistAdmin.insertAdjacentElement('afterend', adj);
            }
          } else {
            const adj = card.querySelector(`.quantity-adjuster.admin[data-id="${id}"]`);
            if (adj) adj.remove();
          }
          updateCardFooter(card, String(id));
        }
        showToast(newVal ? '已加入您的願望清單' : '已從願望清單移除');
      } else {
        alert('操作失敗：' + error.message);
      }
      return;
    }

    // User toggles wishlist_items
    if (btnWishlistUser) {
      if (!currentUser) return;
      const id = btnWishlistUser.dataset.id;
      const isActive = btnWishlistUser.classList.contains('active');
      
      if (isActive) {
        // Delete
        const { error } = await supabase.from('wishlist_items')
          .delete()
          .eq('japan_item_id', id)
          .eq('user_id', currentUser.id);
          
        if (!error) {
          allWishlistItems = allWishlistItems.filter(w => !(String(w.japan_item_id) === String(id) && w.user_id === currentUser.id));
          btnWishlistUser.classList.remove('active');
          const card = btnWishlistUser.closest('.japan-card');
          if (card) {
            const adj = card.querySelector(`.quantity-adjuster.user[data-id="${id}"]`);
            if (adj) adj.remove();
            updateCardFooter(card, String(id));
          }
          showToast('已從我的清單移除');
        }
      } else {
        // Insert
        const newW = {
          japan_item_id: id,
          user_id: currentUser.id,
          user_email: currentUser.email,
          user_name: currentUser.user_metadata?.name || currentUser.email,
          quantity: 1
        };
        const { error } = await supabase.from('wishlist_items').insert([newW]);
        if (!error) {
          allWishlistItems.push(newW);
          btnWishlistUser.classList.add('active');
          const card = btnWishlistUser.closest('.japan-card');
          if (card) {
            if (!card.querySelector(`.quantity-adjuster.user[data-id="${id}"]`)) {
              const adj = document.createElement('div');
              adj.className = 'quantity-adjuster user';
              adj.dataset.id = String(id);
              adj.dataset.role = 'user';
              adj.innerHTML = `
                <button class="btn-qty-minus" data-action="qty-minus" data-item-id="${id}" data-role="user">-</button>
                <span>1</span>
                <button class="btn-qty-plus" data-action="qty-plus" data-item-id="${id}" data-role="user">+</button>
              `;
              btnWishlistUser.insertAdjacentElement('afterend', adj);
            }
            updateCardFooter(card, String(id));
          }
          showToast('已加入我的清單');
        } else {
          alert('操作失敗：' + error.message);
        }
      }
      return;
    }

    // Click footer count -> Show names (Admin only)
    if (footerCount) {
      if (isAdminUser) {
        const id = footerCount.dataset.id;
        const wItems = allWishlistItems.filter(w => String(w.japan_item_id) === String(id));
        const cItem = itemsCache.find(i => String(i.id) === String(id));
        const container = document.getElementById('wishlist-names-container');
        if (container) {
          let total = 0;
          let listHtml = '';
          
          if (cItem && cItem.owner_wishlist) {
            const q = cItem.owner_quantity || 1;
            total += q;
            listHtml += `<div class="wishlist-name-item">👤 你：${q} 個</div>`;
          }
          
          wItems.forEach(w => {
            const allowedUser = allowedUsersCache.find(u => u.email.toLowerCase() === w.user_email?.toLowerCase());
            const name = allowedUser?.display_name || w.user_name || w.user_email;
            const q = w.quantity || 1;
            total += q;
            listHtml += `<div class="wishlist-name-item">👤 ${name}：${q} 個</div>`;
          });
          
          listHtml += `
            <div style="border-top: 1px solid rgba(112, 144, 184, 0.2); margin: 8px 0; padding-top: 12px; font-weight: 600; color: var(--japan-primary); text-align: right;">
              合計：${total} 個
            </div>
          `;
          container.innerHTML = `<div class="wishlist-names-list">${listHtml}</div>`;
        }
        const m = document.getElementById('wishlist-names-modal');
        if (m) {
          m.style.display = 'flex';
          document.body.classList.add('modal-open');
        }
      }
      return;
    }

    if (btnEdit) {
      const card = btnEdit.closest('.japan-card');
      if (!card) return;
      // 從 itemsCache 取完整品項物件(含 trip_id、country_id、created_by)，而不是從卡片 dataset 重組——
      // dataset 沒有帶這些欄位，重組會遺漏，編輯時無法正確帶入現有的歸屬行程與國家
      const id = card.dataset.id;
      const item = itemsCache.find(i => String(i.id) === String(id));
      if (!item) return;
      // 按鈕本來就只在 canEditOwnItem(item) 為真時才會顯示，這裡再檢查一次防止 DOM 被竄改繞過
      if (!canEditOwnItem(item)) return;
      openModal(true, item);
    }

    if (btnDelete) {
      const card = btnDelete.closest('.japan-card');
      if (!card) return;
      const id = card.dataset.id;
      const item = itemsCache.find(i => String(i.id) === String(id));
      if (!item || !canEditOwnItem(item)) return;
      if (confirm('確定要刪除這個收藏品項嗎？此操作將無法復原。')) {
        // 加 .select() 檢查實際受影響筆數——RLS 擋下 DELETE 不會回傳錯誤，只會影響 0 筆
        const { data: deleteData, error } = await supabase.from('japan_items').delete().eq('id', id).select();
        if (!error && deleteData && deleteData.length > 0) {
          showToast('品項已成功刪除');
          card.remove();
          // 更新快取
          itemsCache = itemsCache.filter(item => String(item.id) !== String(id));
          if (itemsCache.length === 0) {
            init(); // 觸發 empty-state
          }
          triggerBuildWebhook();
        } else if (error) {
          alert('刪除失敗：' + error.message);
        } else {
          alert('沒有權限或資料不存在，未實際刪除');
        }
      }
    }
  });

  // --- Auth UI 控制 ---
  document.getElementById('btn-login-modal')?.addEventListener('click', () => {
    const m = document.getElementById('auth-modal');
    if (m) {
      m.style.display = 'flex';
      document.body.classList.add('modal-open');
    }
  });

  document.getElementById('btn-auth-close')?.addEventListener('click', () => {
    const m = document.getElementById('auth-modal');
    if (m) {
      m.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  });
  
  document.getElementById('btn-wishlist-names-close')?.addEventListener('click', () => {
    const m = document.getElementById('wishlist-names-modal');
    if (m) {
      m.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  });

  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  document.getElementById('btn-google-login')?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.href }
    });
  });

  document.getElementById('btn-email-login')?.addEventListener('click', async () => {
    const email = document.getElementById('auth-email').value;
    const password = document.getElementById('auth-password').value;
    if (!email || !password) return;
    
    const btn = document.getElementById('btn-email-login');
    btn.disabled = true;
    btn.textContent = '登入中...';
    
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      alert('登入失敗：' + error.message);
      btn.disabled = false;
      btn.textContent = '登入';
    } else {
      window.location.reload();
    }
  });

  // --- 背景靜默重新編譯觸發(改經後端 API 驗證管理員身分) ---
  // 依單一入口規則不得呼叫 getSession,token 取自 window.__latestAuthState 快照(只讀)
  async function triggerBuildWebhook() {
    try {
      const token = window.__latestAuthState?.session?.access_token;
      if (!token) return;
      await fetch('/api/trigger-deploy', {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + token },
      });
    } catch (err) {
      console.warn('Webhook trigger failed:', err);
    }
  }

  // --- 點擊照片放大檢視 (Lightbox) ---
  const lightbox = document.getElementById('japan-lightbox');
  const lightboxImg = document.getElementById('japan-lightbox-img');

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target.classList.contains('item-image')) {
      if (lightboxImg && lightbox) {
        lightboxImg.src = target.src;
        lightbox.style.display = 'flex';
        document.body.classList.add('modal-open');
      }
    }
    
    // 背景點擊關閉邏輯
    if (target.classList.contains('modal-overlay')) {
      if (target.id === 'japan-country-modal') {
        closeCountryModal();
      } else if (target.id === 'japan-country-collaborators-modal') {
        closeCountryCollaboratorsModal();
      } else if (target.id === 'auth-modal' || target.id === 'wishlist-names-modal' || target.id === 'item-modal' || target.id === 'collect-modal') {
        target.style.display = 'none';
        document.body.classList.remove('modal-open');
      }
    }
  });

  document.getElementById('japan-lightbox-overlay')?.addEventListener('click', () => {
    if (lightbox) {
      lightbox.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  });
  document.getElementById('japan-lightbox-close')?.addEventListener('click', () => {
    if (lightbox) {
      lightbox.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox) {
      lightbox.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
  });

  // --- 收藏品即時搜尋事件監聽 (Collection Real-time Search) ---
  const collectionSearchInput = document.getElementById('collection-search-input');
  const btnCollectionSearchClear = document.getElementById('btn-collection-search-clear');

  collectionSearchInput?.addEventListener('input', (e) => {
    const val = e.target.value;
    currentSearchQuery = val;
    
    // 控制清除按鈕的顯示/隱藏
    if (btnCollectionSearchClear) {
      btnCollectionSearchClear.style.display = val ? 'block' : 'none';
    }
    
    filterAndRenderItems();
  });

  btnCollectionSearchClear?.addEventListener('click', () => {
    if (collectionSearchInput) {
      collectionSearchInput.value = '';
    }
    currentSearchQuery = '';
    if (btnCollectionSearchClear) {
      btnCollectionSearchClear.style.display = 'none';
    }
    filterAndRenderItems();
    collectionSearchInput?.focus();
  });

  // ==========================================================
  // 探索日本搜尋與直接收藏邏輯 (Explore Japan Search & Direct Collect)
  // ==========================================================
  
  let pendingCollectItem = null;
  
  const exploreInput = document.getElementById('explore-input');
  const exploreBtn = document.getElementById('explore-btn');
  const exploreResults = document.getElementById('explore-results');
  const collectModal = document.getElementById('collect-modal');
  const collectSelect = document.getElementById('collect-category-select');
  const collectItemPreview = document.getElementById('collect-item-name-preview');
  const btnCollectConfirm = document.getElementById('btn-collect-confirm');

  // 1. 執行搜尋主邏輯
  async function executeExploreSearch(query) {
    if (!query.trim()) return;
    
    // UI Loading 狀態
    if (exploreBtn) exploreBtn.disabled = true;
    if (exploreInput) exploreInput.disabled = true;
    if (exploreResults) {
      exploreResults.style.display = 'block';
      exploreResults.innerHTML = `
        <div class="explore-loading">
          <div class="explore-spinner"></div>
          <span>🔍 正在為您搜尋日本熱門資訊與推薦...</span>
        </div>
      `;
    }

    try {
      const res = await fetch('/api/explore', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: query.trim() })
      });
      const data = await res.json();
      
      if (exploreResults) {
        if (data.items && data.items.length > 0) {
          let html = `
            <div class="explore-results-title">🔍 網路搜尋日本「${query}」推薦結果：</div>
            <div class="explore-results-list">
          `;
          data.items.forEach((item) => {
            html += `
              <div class="explore-card" data-name="${item.name.replace(/"/g, '&quot;')}" data-link="${item.link}" data-desc="${item.description.replace(/"/g, '&quot;')}">
                <div class="explore-card-content">
                  ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${item.name}" class="explore-thumb">` : ''}
                  <h4 class="explore-card-title">${item.name}</h4>
                  <p class="explore-card-desc">${item.description}</p>
                  <div class="explore-card-meta">
                    🌐 來源網站：<a href="${item.link}" target="_blank" rel="noopener noreferrer">${item.source}</a>
                  </div>
                </div>
                <button type="button" class="btn-explore-add">
                  <i class="ti ti-pin"></i> 收藏
                </button>
              </div>
            `;
          });
          html += `</div>`;
          exploreResults.innerHTML = html;
        } else {
          exploreResults.innerHTML = `
            <div class="explore-loading" style="color: var(--japan-text-muted);">
              <span>📭 沒有找到相關資訊，更換其他關鍵字試試看吧！</span>
            </div>
          `;
        }
      }
    } catch (err) {
      console.error('Search failed:', err);
      if (exploreResults) {
        exploreResults.innerHTML = `
          <div class="explore-loading" style="color: var(--japan-danger);">
            <span>⚠️ 搜尋發生錯誤，請稍後再試。</span>
          </div>
        `;
      }
    } finally {
      if (exploreBtn) exploreBtn.disabled = false;
      if (exploreInput) exploreInput.disabled = false;
    }
  }

  // 搜尋按鈕與 Enter 事件
  exploreBtn?.addEventListener('click', () => {
    executeExploreSearch(exploreInput.value);
  });
  exploreInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      executeExploreSearch(exploreInput.value);
    }
  });

  // 快速標籤點擊事件
  document.querySelectorAll('.explore-tag').forEach(tag => {
    tag.addEventListener('click', (e) => {
      const text = e.currentTarget.textContent || '';
      if (exploreInput) {
        exploreInput.value = text;
        executeExploreSearch(text);
      }
    });
  });

  // 2. 結果卡片點擊「收藏」事件 (委派)
  exploreResults?.addEventListener('click', (e) => {
    const target = e.target;
    const btnAdd = target.closest('.btn-explore-add');
    if (!btnAdd) return;

    const card = btnAdd.closest('.explore-card');
    if (!card) return;

    // 檢查權限：只有登入的 admin 才能新增收藏
    if (!isAdminUser) {
      showToast('⚠️ 請先登入管理員帳號以加入收藏！');
      return;
    }

    const name = card.dataset.name || '';
    const link = card.dataset.link || '';
    const description = card.dataset.desc || '';

    pendingCollectItem = { name, link, description };

    // 顯示 Modal
    if (collectItemPreview) {
      collectItemPreview.textContent = name;
    }
    populateCollectCategoryDropdown();
    if (collectModal) {
      collectModal.style.display = 'flex';
      document.body.classList.add('modal-open');
    }
  });

  // 3. 填充收藏分類下拉選單
  function populateCollectCategoryDropdown() {
    if (!collectSelect) return;
    
    // 清空，保留第一個預設選項
    collectSelect.innerHTML = '<option value="">-- 請選擇分類 --</option>';

    const mainCats = categoriesCache.filter(c => c.parent_id === null);
    mainCats.forEach(mainCat => {
      // 插入主分類作為標籤
      const mainOpt = document.createElement('option');
      mainOpt.value = String(mainCat.id);
      mainOpt.innerHTML = `🌟 主分類：${mainCat.name}`;
      collectSelect.appendChild(mainOpt);

      // 插入該主分類下的子分類
      const subCats = categoriesCache.filter(c => String(c.parent_id) === String(mainCat.id));
      subCats.forEach(subCat => {
        const subOpt = document.createElement('option');
        subOpt.value = String(subCat.id);
        subOpt.innerHTML = `    └─ 子分類：${subCat.name}`;
        collectSelect.appendChild(subOpt);
      });
    });
  }

  // 4. Modal 控制按鈕
  function closeCollectModal() {
    if (collectModal) {
      collectModal.style.display = 'none';
      document.body.classList.remove('modal-open');
    }
    pendingCollectItem = null;
    if (collectSelect) collectSelect.value = '';
  }

  document.getElementById('btn-collect-modal-close')?.addEventListener('click', closeCollectModal);
  document.getElementById('btn-collect-cancel')?.addEventListener('click', closeCollectModal);

  // 5. 確認收藏寫入 Supabase
  btnCollectConfirm?.addEventListener('click', async () => {
    if (!pendingCollectItem) return;
    
    const categoryId = collectSelect.value;
    if (!categoryId) {
      alert('請選擇要收藏的分類！');
      return;
    }

    if (btnCollectConfirm) btnCollectConfirm.disabled = true;

    try {
      const { error } = await supabase.from('japan_items').insert({
        category_id: parseInt(categoryId),
        name: pendingCollectItem.name,
        note: '網友推薦',
        image_url: '', // 網友推薦不帶實體圖片
        country_id: selectedCountryId // 探索區目前僅日本可見，此欄位理論上恆為日本，明確帶上避免依賴 DB 端 DEFAULT
      });

      if (!error) {
        // 加入收藏是全國家通用功能，訊息改中性文字，不寫死「日本」(即使此按鈕目前只會在探索區出現，僅限日本可觸發)
        showToast('🎉 已成功加入收藏！');
        closeCollectModal();
        init(); // 靜默刷新列表與快取
        triggerBuildWebhook(); // 觸發 Vercel 生產端重建
      } else {
        alert('收藏失敗：' + error.message);
      }
    } catch (err) {
      alert('收藏發生異常：' + (err.message || err));
    } finally {
      if (btnCollectConfirm) btnCollectConfirm.disabled = false;
    }
  });

  window.addEventListener('auth-state-changed', async (e) => {
    const { event, session } = e.detail;
    if (event === 'SIGNED_IN' || event === 'INITIAL_SESSION') {
      // OAuth 回調後 token 寫入完成，重新初始化
      await init(session);
    }
    if (event === 'SIGNED_OUT') {
      await init(null);
    }
  });

  if (window.__latestAuthState) {
    const { event, session } = window.__latestAuthState;
    if (event === 'SIGNED_IN' || event === 'INITIAL_SESSION') {
      init(session);
    } else if (event === 'SIGNED_OUT') {
      init(null);
    }
  }
</script>
