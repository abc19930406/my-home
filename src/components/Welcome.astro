---
/**
 * Welcome.astro — 首頁主體元件
 * 深木奶油風格 (Dark Wood Butter)
 */
import CardSection from './CardSection.astro';
import type { CardLink } from '../data/links';

import '../styles/status.css';
import { supabase } from '../lib/supabase-client';

interface Props {
  groupedCards: { name: string; cards: CardLink[] }[];
  initialStatus: {
    reading: string;
    music: string;
    mood: string;
    doing: string;
    updated_at: string;
    site_title?: string | null;
    site_subtitle?: string | null;
  };
}

const { groupedCards, initialStatus } = Astro.props;

// 主標題/副標題：存在 status 表(id=1)的 site_title/site_subtitle；讀取失敗、尚無資料或為空時回退預設值，不出現空白標題
const DEFAULT_TITLE = 'The Corner Table';
const DEFAULT_SUBTITLE = '一個安靜角落，存放思緒與生活';
const siteTitle = initialStatus.site_title?.trim() || DEFAULT_TITLE;
const siteSubtitle = initialStatus.site_subtitle?.trim() || DEFAULT_SUBTITLE;

// 格式化日期：5.13 更新
const formatShortDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return `${d.getMonth() + 1}.${d.getDate()} 更新`;
};
---

<div class="page-wrapper">

  <!-- ===== HEADER 頂部 ===== -->
  <header class="header">
    <div class="header-top">
      <div class="site-title-wrap">
        <h1 class="site-name" id="site-name">{siteTitle}</h1>
        <button id="edit-title-btn" class="title-edit-btn admin-only" style="display: none;" title="編輯標題">✏️</button>
      </div>
      <p class="site-meta">
        <span id="current-date"></span> ・ 台南 ・ 晴 29°C
      </p>
    </div>
    <p class="site-subtitle" id="site-subtitle">{siteSubtitle}</p>
    <div id="title-edit-form" class="title-edit-form" style="display: none;">
      <input type="text" id="input-site-title" class="title-input" maxlength="60" placeholder={DEFAULT_TITLE} value={siteTitle} />
      <input type="text" id="input-site-subtitle" class="title-input" maxlength="120" placeholder={DEFAULT_SUBTITLE} value={siteSubtitle} />
      <div class="title-edit-actions">
        <button type="button" id="cancel-title-btn" class="title-btn">取消</button>
        <button type="button" id="save-title-btn" class="title-btn title-btn-primary">儲存</button>
      </div>
    </div>
    <hr class="header-divider" />
  </header>

  <!-- ===== MAIN 主體：三個卡片分區 ===== -->
  <main class="main-content">
    <!-- ===== 現在狀態 (便條紙風格) ===== -->
    <section class="status-section">
      <div class="status-note" id="status-postit">
        <div class="status-tape"></div>
        
        <!-- 管理員編輯按鈕 -->
        <button id="edit-status-btn" class="status-edit-btn admin-only" style="display: none;" title="編輯狀態">
          <i class="ti ti-edit"></i>
        </button>

        <div class="status-fields" id="status-display">
          <div class="status-field">📖 <span id="display-reading">{initialStatus.reading}</span></div>
          <div class="status-field">🎵 <span id="display-music">{initialStatus.music}</span></div>
          <div class="status-field">💬 <span id="display-mood">{initialStatus.mood}</span></div>
          <div class="status-field">🔨 <span id="display-doing">{initialStatus.doing}</span></div>
        </div>

        <!-- 編輯模式 (預設隱藏) -->
        <div id="status-edit-form" class="status-fields" style="display: none;">
          <div class="status-field">📖 <input type="text" id="input-reading" class="status-input" value={initialStatus.reading} /></div>
          <div class="status-field">🎵 <input type="text" id="input-music" class="status-input" value={initialStatus.music} /></div>
          <div class="status-field">💬 <input type="text" id="input-mood" class="status-input" value={initialStatus.mood} /></div>
          <div class="status-field">🔨 <input type="text" id="input-doing" class="status-input" value={initialStatus.doing} /></div>
        </div>

        <div class="status-updated">
          <span id="status-updated-at">{formatShortDate(initialStatus.updated_at)}</span>
          <button id="save-status-btn" class="status-save-btn" style="display: none;">儲存</button>
        </div>
      </div>
    </section>

    {groupedCards.map(({ name, cards }) => (
      <CardSection section={name} cards={cards} />
    ))}
  </main>

  <!-- ===== FOOTER 底部 ===== -->
  <footer class="footer">
    <div class="footer-links">
      <span class="footer-link">GitHub</span>
      <span class="footer-sep">・</span>
      <span class="footer-link">Email</span>
      <span class="footer-sep">・</span>
      <a href="/login" class="footer-link" style="opacity: 0.5;">管理</a>
    </div>
    <p class="footer-copy">© 2026 <span id="footer-site-name">{siteTitle}</span></p>
  </footer>

</div>

<!-- 現在狀態管理邏輯 -->
<script>
import { getSupabaseBrowserClient } from '../lib/supabase-browser.js';
import { refreshCardsFromDb } from '../lib/live-cards';
import { initTitleEditor } from '../lib/title-editor';

(async () => {
  const supabase = getSupabaseBrowserClient();

  const adminEmail = (import.meta.env.PUBLIC_ADMIN_EMAIL || '').toLowerCase();

  // 1. 偵測登入狀態：必須比對管理員 email，不能只看有沒有 session(朋友登入也有 session)
  const { data: { session } } = await supabase.auth.getSession();
  const isAdmin = !!(session && adminEmail && (session.user?.email || '').toLowerCase() === adminEmail);
  if (isAdmin) {
    document.querySelectorAll('.admin-only').forEach(el => {
      // @ts-ignore
      el.style.display = el.tagName === 'BUTTON' ? 'flex' : 'block';
    });
  }

  // 2. 編輯與儲存邏輯
  const editBtn = document.getElementById('edit-status-btn');
  const saveBtn = document.getElementById('save-status-btn');
  const displayArea = document.getElementById('status-display');
  const editForm = document.getElementById('status-edit-form');
  const updatedAtEl = document.getElementById('status-updated-at');

  const inputs = {
    reading: document.getElementById('input-reading'),
    music: document.getElementById('input-music'),
    mood: document.getElementById('input-mood'),
    doing: document.getElementById('input-doing')
  };

  const displays = {
    reading: document.getElementById('display-reading'),
    music: document.getElementById('display-music'),
    mood: document.getElementById('display-mood'),
    doing: document.getElementById('display-doing')
  };

  if (editBtn) {
    editBtn.addEventListener('click', () => {
      displayArea.style.display = 'none';
      editForm.style.display = 'block';
      editBtn.style.display = 'none';
      saveBtn.style.display = 'inline-block';
    });
  }

  if (saveBtn) {
    saveBtn.addEventListener('click', async () => {
      const newData = {
        reading: inputs.reading.value,
        music: inputs.music.value,
        mood: inputs.mood.value,
        doing: inputs.doing.value,
        updated_at: new Date().toISOString()
      };

      // Optimistic UI
      Object.keys(newData).forEach(key => {
        if (displays[key]) displays[key].textContent = newData[key];
      });
      const d = new Date();
      updatedAtEl.textContent = `${d.getMonth() + 1}.${d.getDate()} 更新`;

      // 切換回顯示模式
      displayArea.style.display = 'block';
      editForm.style.display = 'none';
      editBtn.style.display = 'block';
      saveBtn.style.display = 'none';

      // 儲存至資料庫
      try {
        const { error } = await supabase
          .from('status')
          .update(newData)
          .eq('id', 1);

        if (error) throw error;

        // 背景觸發部署(改經後端 API 驗證管理員身分,hook 網址不再暴露於前端)
        const { data: { session: deploySession } } = await supabase.auth.getSession();
        if (deploySession) {
          fetch('/api/trigger-deploy', {
            method: 'POST',
            headers: { Authorization: 'Bearer ' + deploySession.access_token },
          }).catch(() => {});
        }
      } catch (err) {
        console.error('儲存失敗:', err);
        alert('儲存失敗，請檢查權限');
      }
    });
  }

  // 3. 主標題/副標題：讀取與管理員編輯，與管理頁共用同一份邏輯(src/lib/title-editor.ts)
  await initTitleEditor(supabase, { isAdmin });

  // 卡片：載入後重讀 cards 表原地更新，改完不需等重新部署；失敗保留靜態版
  refreshCardsFromDb(supabase);

  // 日期邏輯
  const dateEl = document.getElementById('current-date');
  if (dateEl) {
    const now = new Date();
    dateEl.textContent = now.toLocaleDateString('zh-TW', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      weekday: 'long',
    });
  }
})();
</script>

<style>
  @import "../styles/welcome.css";
</style>
