---
/**
 * CardSection.astro
 * 自動讀取 links.ts 資料並渲染分區卡片
 * 未來新增連結只需編輯 links.ts，不需要改動此元件
 */
import type { CardLink } from '../data/links';

interface Props {
  section: string;
  cards: CardLink[];
  isLoggedIn?: boolean;
}

const { section, cards, isLoggedIn = false } = Astro.props;
---

<!-- 分區標題 -->
<section class="card-section">
  <h2 class="section-title">— {section} —</h2>

  <!-- 卡片網格：桌面四欄、手機兩欄 -->
  <div class="card-grid">
    {cards.map((card) => (
      <div class={`card ${card.title === '旅行地圖' ? 'travel-map-card' : ''}`} id={card.title === '旅行地圖' ? 'travel-map-card' : undefined}>
        {/* 卡片頂部：圖示 + 標題 */}
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
            <i class={`ti ti-${card.icon} card-icon`}></i>
            {(card.url && card.title !== '旅行地圖') ? (
              <a href={card.url} class="card-title card-title--link">{card.title}</a>
            ) : (
              <span class="card-title">{card.title}</span>
            )}
          </div>
          {isLoggedIn && (
            <button 
              class="edit-btn" 
              data-id={card.id}
              data-title={card.title}
              data-desc={card.description}
              data-url={card.url}
              title="編輯卡片"
            >
              ✏️
            </button>
          )}
        </div>

        {/* 說明文字 */}
        <p class="card-desc">{card.description}</p>

        {/* 子連結（如知識庫的 Obsidian 筆記） */}
        {card.children && card.children.length > 0 && (
          <div class="card-children">
            {card.children.map((child) => (
              <a href={child.url} class="child-link" target="_blank" rel="noopener noreferrer">
                <span class="child-arrow">→</span> {child.title}
              </a>
            ))}
          </div>
        )}

        {/* 客製：旅行地圖的子選單 */}
        {card.title === "旅行地圖" && (
          <div class="submenu travel-submenu" id="travel-submenu" style="display:none;">
            <a href="/travel" class="travel-sub-link">🗺 旅行地圖</a>
            <a href="/japan" class="travel-sub-link">🇯🇵 日本收藏</a>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  /* === 分區容器 === */
  .card-section {
    margin-bottom: 3rem;
  }

  /* === 分區標題 === */
  .section-title {
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #8A6E52;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  /* === 卡片網格 === */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* === 卡片 === */
  .card {
    background: #3A2818;
    border: 1px solid #4A3525;
    border-radius: 10px;
    padding: 1.25rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: #C4956A;
    transform: translateY(-2px);
  }

  /* === 卡片頂部 === */
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card-icon {
    color: #C4956A;
    font-size: 20px;
    flex-shrink: 0;
  }

  .card-title {
    color: #F5E6CC;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* 有連結時的樣式 */
  .card-title--link {
    text-decoration: none;
    color: #F5E6CC;
    transition: color 0.2s ease;
  }

  .card-title--link:hover {
    color: #C4956A;
  }

  /* === 說明文字 === */
  .card-desc {
    color: #A08060;
    font-size: 0.75rem;
    line-height: 1.6;
    margin: 0;
  }

  /* === 子連結區塊 === */
  .card-children {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #4A3525;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .child-link {
    color: #C4956A;
    font-size: 0.75rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: opacity 0.2s ease;
  }

  .child-link:hover {
    opacity: 0.75;
  }

  .child-arrow {
    font-size: 0.625rem;
  }

  /* === 編輯按鈕 === */
  .edit-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    opacity: 0.3;
    transition: opacity 0.2s;
    font-size: 0.8rem;
    padding: 2px;
  }

  .edit-btn:hover {
    opacity: 1;
  }

  /* === 客製旅行地圖特殊樣式 === */
  .travel-map-card {
    cursor: pointer;
  }
  
  .travel-submenu {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed #4A3525;
    animation: slideDown 0.2s ease-out forwards;
  }
  
  .travel-sub-link {
    flex: 1;
    text-align: center;
    background: #2D1F12;
    color: #F5E6CC;
    text-decoration: none;
    padding: 8px;
    border-radius: 8px;
    font-size: 0.8rem;
    transition: background 0.2s;
  }
  
  .travel-sub-link:hover {
    background: #4A3525;
  }
  
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // 處理旅行地圖的點擊展開邏輯
  const travelCard = document.getElementById('travel-map-card');
  const travelSubmenu = document.getElementById('travel-submenu');

  if (travelCard && travelSubmenu) {
    travelCard.addEventListener('click', (e) => {
      // 避免點擊子連結本身時觸發收合
      if ((e.target as HTMLElement).closest('.travel-sub-link')) {
        return;
      }
      
      e.stopPropagation();
      const isHidden = travelSubmenu.style.display === 'none';
      travelSubmenu.style.display = isHidden ? 'flex' : 'none';
    });

    // 點擊卡片外部收合子選單
    document.addEventListener('click', (e) => {
      if (!travelCard.contains(e.target as Node)) {
        travelSubmenu.style.display = 'none';
      }
    });
  }
</script>
