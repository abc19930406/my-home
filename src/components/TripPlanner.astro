---
export const prerender = true;
import { supabase } from '../lib/supabase-client';
import '../styles/travel.css';

// 1. Build Time: 靜態抓取所有行程與景點資料，確保極速載入
let initialTrips = [];
let initialSpots = [];

try {
  // 抓取行程列表
  const { data: tripsData, error: tripsError } = await supabase
    .from('trips')
    .select('*')
    .order('created_at', { ascending: true });
  
  if (!tripsError && tripsData) {
    initialTrips = tripsData;
  }

  // 抓取景點列表
  const { data: spotsData, error: spotsError } = await supabase
    .from('spots')
    .select('*')
    .order('created_at', { ascending: false });

  if (!spotsError && spotsData) {
    initialSpots = spotsData;
  }
} catch (err) {
  console.warn('⚠️ Build Warning: 旅行地圖 Supabase 讀取失敗，使用備用資料。', err);
}

// 備用資料 (以防資料庫在 build 時無法連線)
const fallbackTrips = [
  { id: 'fallback-tokyo', name: '2026 東京行', description: '春櫻綻放與極致美食之旅', emoji: '🌸' }
];

const fallbackSpots = [
  {
    id: 'fallback-spot-1',
    trip_id: 'fallback-tokyo',
    name: '淺草寺',
    address: '東京都台東區淺草2-3-1',
    note: '早上八點前去人潮較少，雷門大燈籠很壯觀！',
    category: '景點',
    icon: '⛩️',
    status: 'visited',
    rating: 'recommend',
    lat: 35.7148,
    lng: 139.7967,
    images: [],
    open_hours: '06:00 - 17:00',
    price: '免費',
  }
];

const trips = initialTrips.length > 0 ? initialTrips : fallbackTrips;
const spots = initialSpots.length > 0 ? initialSpots : fallbackSpots;

const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? '';
const webhookUrl = import.meta.env.PUBLIC_VERCEL_DEPLOY_HOOK ?? '';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

  <!-- 全域背景覆蓋：確保 Layout 的深色背景被清新白底暖木色覆蓋 -->
  <style is:global>
    html, body {
      background-color: #FDFCF8 !important;
      overflow-y: auto !important;
      height: auto !important;
      color: #3D3530 !important;
    }
    body.modal-open {
      overflow: hidden !important;
    }
    .custom-map-marker.is-chain-store {
      opacity: 0.6;
    }
    .custom-map-marker.is-chain-store .marker-circle {
      transform: scale(0.65);
    }
    .custom-map-marker.is-chain-store:hover {
      opacity: 1;
    }
  </style>

  <div class="travel-body">
    <div class="travel-container">
      


      <!-- 2. 行程切換列 (橫向滾動) -->
      <section class="trips-scroll-container">
        <div class="trips-list" id="trips-tab-list">
          <!-- JS 動態或 HTML 靜態生成 -->
          {trips.map((trip, idx) => (
            <button 
              class={`trip-tab ${idx === 0 ? 'active' : ''}`} 
              data-trip-id={trip.id}
              data-trip-name={trip.name}
              data-trip-desc={trip.description || ''}
            >
              <span>{trip.emoji}</span> {trip.name}
            </button>
          ))}
        </div>
        
        <!-- ＋ 新增行程 (預設隱藏，登入後由 JS 顯示) -->
        <button id="btn-add-trip" class="btn-dashed-add-trip admin-only" style="display: none;">
          <i class="ti ti-plus"></i> 新增行程
        </button>
      </section>

      <!-- 2.5 行程模式切換列 -->
      <section class="mode-toggle-container" style="justify-content: space-between; align-items: center;">
        <div style="display: flex; gap: 12px;">
          <button id="btn-mode-map" class="mode-btn active">
            <i class="ti ti-map-2"></i> 地圖模式
          </button>
          <button id="btn-mode-itinerary" class="mode-btn">
            <i class="ti ti-calendar"></i> 行程模式
          </button>
        </div>
        <div class="top-right-auth-container" style="position: static; margin-left: auto;">
          <div id="top-auth-guest" style="display: none;">
            <button 
              type="button" 
              id="btn-top-login" 
              class="btn-top-auth"
              onclick="
                const m = document.getElementById('auth-modal');
                if (m) { m.style.display='flex'; document.body.classList.add('modal-open'); }
                else { window.location.href='/login'; }
              "
            >🔑 登入</button>
          </div>
          <div id="top-auth-user" style="display: none;">
            <button id="btn-top-logout" class="btn-top-auth">登出</button>
          </div>
        </div>
      </section>

      <!-- 2.5 搜尋列 -->
      <section class="travel-search-bar" style="position: relative;">
        <input 
          type="text" 
          id="travel-search-input" 
          placeholder="搜尋想去的景點、餐廳、住宿... (例如：清水寺)" 
          autocomplete="off"
        />
        <button id="travel-search-btn" class="search-btn">搜尋</button>
        <div id="travel-search-dropdown" class="search-dropdown" style="display: none;"></div>
      </section>

      <!-- 3. 篩選列 -->
      <section class="travel-filter-bar" style="flex-wrap: wrap;">
        <div style="display: flex; width: 100%; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <!-- 左側：搜尋框與類型標籤 -->
          <div class="filter-left" style="gap: 12px;">
            <div style="position: relative; display: inline-flex; align-items: center; min-width: 180px;">
              <input 
                type="text" 
                id="saved-spots-search" 
                placeholder="🔍 搜尋已儲存景點..." 
                style="width: 100%; padding: 6px 28px 6px 14px; border-radius: 16px; border: 1px solid var(--travel-border); font-size: 0.85rem; font-family: inherit; color: var(--travel-text); background: #FFFFFF; outline: none; box-shadow: var(--travel-shadow-sm); transition: border-color 0.2s;"
                autocomplete="off"
              />
              <button id="btn-clear-saved-search" style="position: absolute; right: 8px; background: none; border: none; font-size: 14px; color: #999; cursor: pointer; display: none; padding: 0;">✕</button>
            </div>
            
            <div id="category-filter-group" style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button class="filter-btn active" data-category="all">全部</button>
              <!-- JS 動態產生其他按鈕 -->
            </div>
          </div>

          <!-- 右側：狀態標籤 (想去、已去) + 新增景點按鈕 -->
          <div class="filter-right" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <label style="display: flex; align-items: center; gap: 4px; font-size: 0.85rem; color: var(--travel-text-muted); cursor: pointer; margin-right: 8px;">
              <input type="checkbox" id="toggle-chain-stores" /> 顯示連鎖店
            </label>
            <button class="filter-btn status-btn active" id="filter-status-want" data-status="want">想去</button>
            <button class="filter-btn status-btn" id="filter-status-visited" data-status="visited">已去</button>
            
            <!-- ＋ 新增景點 (預設隱藏，登入後由 JS 顯示) -->
            <button id="btn-open-spot-modal" class="btn-add-spot admin-only" style="display: none;">
              <i class="ti ti-plus"></i> 新增景點
            </button>
            
            <!-- ⚙️ 管理類型 (預設隱藏，登入後由 JS 顯示) -->
            <button id="btn-manage-types" class="btn-manage-types admin-only" style="display: none; background: transparent; border: 1px dashed var(--travel-border); color: var(--travel-text-muted); padding: 4px 12px; border-radius: 16px; font-size: 0.85rem; cursor: pointer;">
              <i class="ti ti-settings"></i> 管理類型
            </button>
          </div>
        </div>

        <!-- 第二層：子類型標籤 (新增，預設隱藏) -->
        <div class="filter-left" id="subcategory-filter-group" style="display: none; width: 100%; margin-top: 12px; gap: 8px; flex-wrap: wrap; padding-top: 12px; border-top: 1px dashed var(--travel-border);">
          <!-- JS 動態產生子按鈕 -->
        </div>
      </section>

      <!-- 4. Google Maps 地圖區塊 -->
      <div class="map-wrapper">
        <div id="travel-map" class="map-container"></div>
        <!-- 地圖提示文字 (預設隱藏，登入後由 JS 顯示) -->
        <div id="map-hint-banner" class="map-hint-banner admin-only" style="display: none;">
          <i class="ti ti-info-circle"></i> 點擊地圖任意位置可快速新增景點
        </div>
      </div>

      <!-- 5. 景點清單區 -->
      <section class="spots-list-section">
        <h3 class="spots-section-header">
          <span id="current-trip-title">景點清單</span>
          <button id="btn-edit-trip" class="admin-only" style="display: none; background: transparent; border: none; font-size: 1rem; cursor: pointer; color: var(--travel-text-muted); margin-left: 8px;" title="編輯行程">
            <i class="ti ti-pencil"></i>
          </button>
        </h3>
        <div class="spots-list" id="spots-cards-container">
          <!-- JS 將動態渲染過濾後的景點 -->
          <div class="empty-state">
            載入景點中...
          </div>
        </div>
      </section>

      <!-- 6. 行程模式 UI (預設隱藏) -->
      <section id="itinerary-mode-view" class="itinerary-container" style="display: none;">
        <div class="itinerary-sidebar">
          <div id="itinerary-days-list" style="display: flex; flex-direction: column; gap: 8px;">
            <!-- 動態生成天數按鈕 -->
          </div>
          <button id="btn-add-day" class="btn-add-day admin-only" style="display: none;">
            ＋ 新增一天
          </button>
        </div>
        <div class="itinerary-content">
          <h3 id="itinerary-day-title" style="margin: 0 0 12px 0; font-size: 1.2rem; color: var(--travel-text);">請選擇天數</h3>
          <div id="itinerary-spots-list" class="spots-list">
            <div class="empty-state">請先選擇左側天數</div>
          </div>
          <button id="btn-open-wishlist-modal" class="btn-add-itinerary-spot admin-only" style="display: none;">
            ＋ 從想去清單選擇
          </button>
        </div>
      </section>



    </div>
  </div>

  <!-- ==========================================
       彈出視窗：從想去清單選擇景點
       ========================================== -->
  <div id="wishlist-modal" class="travel-modal-overlay modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h3>＋ 新增景點至行程</h3>
        <button type="button" class="btn-modal-close" id="btn-wishlist-modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <input 
          type="text" 
          id="wishlist-search-input" 
          placeholder="搜尋景點名稱或備註..." 
          style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--travel-border); font-size: 0.9rem; color: var(--travel-text); background-color: #FFFFFF; outline: none; transition: border-color 0.2s ease; margin-bottom: 12px; box-sizing: border-box;"
          autocomplete="off"
        />
        <div id="wishlist-select-container" class="wishlist-select-list">
          <!-- JS 動態產生選項 -->
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================
       彈出視窗：景點詳情
       ========================================== -->
  <div id="spot-detail-modal" class="travel-modal-overlay modal-overlay">
    <div class="modal-box" style="max-width: 400px;">
      <div class="modal-header">
        <h3 id="spot-detail-title">景點名稱</h3>
        <button type="button" class="btn-modal-close" id="btn-spot-detail-close">&times;</button>
      </div>
      <div class="modal-body" id="spot-detail-body" style="padding: 20px; font-size: 14px; color: #5a4a35; line-height: 1.6;">
        <!-- JS 動態填入 -->
      </div>
    </div>
  </div>

  <!-- ==========================================
       彈出視窗 1：新增行程 Modal
       ========================================== -->
  <div id="trip-modal" class="travel-modal-overlay modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="trip-modal-title">＋ 新增旅行行程</h3>
        <button type="button" class="btn-modal-close" id="btn-trip-modal-close">&times;</button>
      </div>
      <form id="trip-form">
        <div class="modal-body">
          <input type="hidden" id="form-trip-id" />
          <!-- 行程名稱 -->
          <div class="form-group">
            <label for="trip-name">行程名稱 <span style="color: var(--color-danger)">*</span></label>
            <input type="text" id="trip-name" required placeholder="例如：2026 東京春櫻之旅" autocomplete="off" />
          </div>

          <!-- Emoji 選擇 -->
          <div class="form-group">
            <label>行程 Emoji</label>
            <div class="emoji-selector" id="trip-emoji-selector">
              <span class="emoji-option selected" data-emoji="🌸">🌸</span>
              <span class="emoji-option" data-emoji="🍵">🍵</span>
              <span class="emoji-option" data-emoji="🌊">🌊</span>
              <span class="emoji-option" data-emoji="⛩️">⛩️</span>
              <span class="emoji-option" data-emoji="🍁">🍁</span>
              <span class="emoji-option" data-emoji="🗼">🗼</span>
              <span class="emoji-option" data-emoji="✈️">✈️</span>
              <span class="emoji-option" data-emoji="🎒">🎒</span>
              <span class="emoji-option" data-emoji="🇯🇵">🇯🇵</span>
              <span class="emoji-option" data-emoji="🍜">🍜</span>
            </div>
            <input type="hidden" id="trip-selected-emoji" value="🌸" />
          </div>

          <!-- 行程描述 -->
          <div class="form-group">
            <label for="trip-description">描述</label>
            <textarea id="trip-description" rows="3" placeholder="簡短描述這趟行程的點滴與目的..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="btn-trip-cancel">取消</button>
          <button type="submit" class="btn-primary">儲存行程</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==========================================
       彈出視窗 2：新增/編輯景點 Modal
       ========================================== -->
  <div id="spot-modal" class="travel-modal-overlay modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="spot-modal-title">＋ 新增景點</h3>
        <button type="button" class="btn-modal-close" id="btn-spot-modal-close">&times;</button>
      </div>
      <form id="spot-form">
        <div class="modal-body">
          <input type="hidden" id="form-spot-id" />
          <input type="hidden" id="form-spot-place-id" />

          <!-- 景點名稱 -->
          <div class="form-group">
            <label for="spot-name">景點名稱 <span style="color: var(--color-danger)">*</span></label>
            <input type="text" id="spot-name" required placeholder="例如：雷門淺草寺" autocomplete="off" />
          </div>

          <!-- 類型選擇 -->
          <div class="form-group">
            <label for="spot-category">類型</label>
            <select id="spot-category">
              <!-- JS 動態插入 -->
            </select>
          </div>

          <!-- 子類型選擇 (動態顯示) -->
          <div class="form-group" id="spot-subtype-group" style="display: none;">
            <label for="spot-subtype">子類型</label>
            <select id="spot-subtype">
              <!-- JS 動態插入 -->
            </select>
          </div>

          <!-- 地址 (Geocoding 自動經緯度) -->
          <div class="form-group">
            <label for="spot-address">地址 <span style="color: var(--color-danger)">*</span></label>
            <input type="text" id="spot-address" required placeholder="請輸入完整地址，將自動定位經緯度" autocomplete="off" />
            <div id="geo-status" class="geo-status-indicator" style="display: none;"></div>
            <input type="hidden" id="spot-lat" />
            <input type="hidden" id="spot-lng" />
          </div>

          <!-- 開放時間 -->
          <div class="form-group">
            <label for="spot-hours">開放時間</label>
            <input type="text" id="spot-hours" placeholder="例如：06:00 - 17:00 或 24小時" autocomplete="off" />
          </div>

          <!-- 價格 -->
          <div class="form-group">
            <label for="spot-price">價格</label>
            <input type="text" id="spot-price" placeholder="例如：門票 ¥600 或 免費" autocomplete="off" />
          </div>

          <!-- 備註 -->
          <div class="form-group">
            <label for="spot-note">備註</label>
            <textarea id="spot-note" rows="3" placeholder="填寫一些旅行備註、心得、排隊攻略..."></textarea>
          </div>

          <!-- 狀態：想去 / 已去 -->
          <div class="form-group">
            <label for="spot-status">狀態</label>
            <select id="spot-status">
              <option value="want">想去</option>
              <option value="visited">已去</option>
            </select>
          </div>

          <!-- 評價 (已去才顯示) -->
          <div class="form-group" id="spot-rating-group" style="display: none;">
            <label for="spot-rating">評價</label>
            <select id="spot-rating">
              <option value="">-- 選擇評價 --</option>
              <option value="recommend">🌟 推薦 (超值必訪)</option>
              <option value="maybe">☕ 有空可去 (順路造訪)</option>
              <option value="not_recommend">💔 不推 (雷區避坑)</option>
            </select>
          </div>

          <!-- 照片上傳 -->
          <div class="form-group">
            <label>照片上傳</label>
            <div class="file-upload-wrap">
              <i class="ti ti-cloud-upload upload-icon"></i>
              <p class="upload-text">點擊或拖曳照片至此上傳</p>
              <input type="file" id="spot-image-file" accept="image/*" multiple />
            </div>
            <div class="upload-preview-container" id="spot-image-previews">
              <!-- JS 動態插入照片預覽與刪除按鈕 -->
            </div>
          </div>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="btn-cancel-spot">取消</button>
          <button type="button" class="btn-primary" id="btn-save-spot">儲存景點</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==========================================
       彈出視窗 3：管理景點類型 Modal
       ========================================== -->
  <div id="type-management-modal" class="travel-modal-overlay modal-overlay">
    <div class="modal-box" style="max-width: 400px;">
      <div class="modal-header">
        <h3>⚙️ 管理景點類型</h3>
        <button type="button" class="btn-modal-close" id="btn-type-modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <ul id="type-list-container" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
          <!-- JS 動態渲染 -->
        </ul>
        <hr style="margin: 16px 0; border: none; border-top: 1px dashed var(--travel-border);" />
        <form id="add-type-form" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
          <input type="text" id="new-type-emoji" placeholder="圖示 (如 🗼)" required style="width: 80px;" autocomplete="off" />
          <input type="text" id="new-type-name" placeholder="類型名稱" required style="flex: 1;" autocomplete="off" />
          <label style="display: flex; align-items: center; gap: 4px; font-size: 0.85rem; cursor: pointer; white-space: nowrap;">
            <input type="checkbox" id="new-type-chain" /> 連鎖店
          </label>
          <button type="submit" class="btn-primary" style="padding: 0 16px; white-space: nowrap;">新增</button>
        </form>
      </div>
    </div>
  </div>
  <!-- Toast 訊息通知 -->
  <div id="toast" class="toast">已成功儲存</div>

  <!-- Lightbox 圖片放大檢視 -->
  <div id="lightbox" style="display:none;">
    <div id="lightbox-overlay"></div>
    <img id="lightbox-img" src="" alt="" />
    <button id="lightbox-close">✕</button>
  </div>

<!-- IIFE 客戶端互動與 Supabase 連線邏輯 -->
<script define:vars={{ webhookUrl, mapsKey, supabaseUrl, supabaseAnonKey }}>
  (async () => {
    // 1. 動態從 CDN 匯入 Supabase 核心並初始化
    const waitForSharedSupabase = () => new Promise(resolve => {
      if (window.sharedSupabase) return resolve(window.sharedSupabase);
      const check = setInterval(() => {
        if (window.sharedSupabase) {
          clearInterval(check);
          resolve(window.sharedSupabase);
        }
      }, 50);
    });
    const supabase = await waitForSharedSupabase();

    // 2. 動態載入 Google Maps Script
    const googleMapsPromise = new Promise((resolve, reject) => {
      console.log("🗺️ [Google Maps Loader] 開始動態載入 Google 地圖 Script...");
      if (window.google && window.google.maps) {
        console.log("🗺️ [Google Maps Loader] 偵測到 Google 地圖物件已存在，直接 resolve。");
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${mapsKey}&loading=async&callback=__googleMapsReady`;
      script.async = true;
      script.defer = true;
      window.__googleMapsReady = () => {
        console.log("🗺️ [Google Maps Loader] Script 載入完成且 callback 觸發成功！");
        resolve();
      };
      script.onerror = (err) => {
        console.error("❌ [Google Maps Loader] 地圖 Script 動態載入失敗，請確認網路或 API Key 設定！", err);
        reject(err);
      };
      document.head.appendChild(script);
    });

    // 靜態資料 Fallback 控制
    const deployWebhookUrl = webhookUrl;
    const googleMapsKey = mapsKey;
    const toast = document.getElementById('toast');

    // 全域快取狀態
    let tripsCache = [];
    let spotsCache = [];
    let spotTypesCache = [];
    let spotSubtypesCache = [];
    let currentTripId = '';
    let selectedCategoryFilter = 'all';
    let selectedSubcategoryFilter = 'all';
    let selectedStatusFilter = 'want'; // 預設篩選「想去」
    let showChainStores = false;
    let isAdminUser = false;
    const adminEmail = window.__ADMIN_EMAIL__ || '';

    // 上傳圖片的暫存陣列 (以 URL 字串儲存)
    let uploadedImagesCache = [];

    // Google Maps 物件快取
    let googleMap = null;
    let mapMarkers = [];
    let searchMarkers = []; // 頂部搜尋的標記
    let openInfoWindow = null; // 指向當前開啟的氣泡視窗
    let openAddSpotModal = null; // 全域新增景點 Modal 控制器

    // Helper: 將網址轉為超連結
    function linkifyText(text) {
      if (!text) return text;
      const urlRegex = new RegExp('(https?:\\/\\/[^\\s]+)', 'g');
      return text.replace(urlRegex, function(url) {
        return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline; opacity: 0.8;">' + url + '</a>';
      });
    }

    // 動態渲染首頁上方篩選列
    window.renderCategoryFilters = function() {
      const catGroup = document.getElementById('category-filter-group');
      if (!catGroup) return;
      let html = `<button class="filter-btn ${selectedCategoryFilter === 'all' ? 'active' : ''}" data-category="all">全部</button>`;
      spotTypesCache.forEach(type => {
        html += `<button class="filter-btn ${selectedCategoryFilter === type.id ? 'active' : ''}" data-category="${type.id}">${type.name}</button>`;
      });
      catGroup.innerHTML = html;
      
      renderSubcategoryFilters();
    };

    // 動態渲染第二層(子類型)篩選列
    window.renderSubcategoryFilters = function() {
      const subGroup = document.getElementById('subcategory-filter-group');
      if (!subGroup) return;
      
      if (selectedCategoryFilter === 'all') {
        subGroup.style.display = 'none';
        return;
      }
      
      const subtypes = spotSubtypesCache.filter(st => st.spot_type_id === selectedCategoryFilter);
      if (subtypes.length === 0) {
        subGroup.style.display = 'none';
        return;
      }
      
      subGroup.style.display = 'flex';
      let html = `<button class="filter-btn ${selectedSubcategoryFilter === 'all' ? 'active' : ''}" data-subcategory="all" style="font-size: 0.85em; padding: 4px 12px; border-radius: 14px;">全部</button>`;
      subtypes.forEach(st => {
        html += `<button class="filter-btn ${selectedSubcategoryFilter === st.id ? 'active' : ''}" data-subcategory="${st.id}" style="font-size: 0.85em; padding: 4px 12px; border-radius: 14px;">${st.emoji} ${st.name}</button>`;
      });
      subGroup.innerHTML = html;
    };

    // 動態渲染新增/編輯景點 Modal 內的下拉選單
    window.renderSpotCategoryOptions = function() {
      const select = document.getElementById('spot-category');
      if (!select) return;
      const val = select.value;
      let html = '';
      spotTypesCache.forEach(type => {
        html += `<option value="${type.id}">${type.emoji} ${type.name}</option>`;
      });
      select.innerHTML = html;
      if (val) select.value = val;
      
      renderSpotSubcategoryOptions();
    };
    
    // 動態渲染 Modal 內的子類型下拉選單
    window.renderSpotSubcategoryOptions = function() {
      const catSelect = document.getElementById('spot-category');
      const subGroup = document.getElementById('spot-subtype-group');
      const subSelect = document.getElementById('spot-subtype');
      
      if (!catSelect || !subGroup || !subSelect) return;
      
      const typeId = catSelect.value;
      const subtypes = spotSubtypesCache.filter(st => st.spot_type_id === typeId);
      
      if (subtypes.length === 0) {
        subGroup.style.display = 'none';
        subSelect.innerHTML = '<option value="">無子類型</option>';
        subSelect.value = '';
      } else {
        subGroup.style.display = 'block';
        const currentVal = subSelect.value;
        let html = '<option value="">-- 不指定子類型 --</option>';
        subtypes.forEach(st => {
          html += `<option value="${st.id}">${st.emoji} ${st.name}</option>`;
        });
        subSelect.innerHTML = html;
        if (currentVal && subtypes.some(st => st.id === currentVal)) {
          subSelect.value = currentVal;
        } else {
          subSelect.value = '';
        }
      }
    };

    // 清除頂部搜尋的標記
    function clearSearchMarkers() {
      searchMarkers.forEach(m => m.setMap(null));
      searchMarkers = [];
    }

    // 綁定全域搜尋加入行程方法 (對齊使用者的參數順序：name, address, lat, lng)
    window.addSpotFromSearch = (name, address, lat, lng, placeId) => {
      // 關閉氣泡
      if (openInfoWindow) {
        openInfoWindow.close();
        openInfoWindow = null;
      }
      // 開啟新增景點 Modal，自動填入資料
      if (openAddSpotModal) {
        openAddSpotModal({ lat, lng, address, name, place_id: placeId });
      }
    };

    // --- Utility: 顯示 Toast 訊息 ---
    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2000);
    }

    // --- Trigger Build Webhook 觸發 Vercel 自動重構 ---
    async function triggerBuildWebhook() {
      if (!deployWebhookUrl) return;
      try {
        await fetch(deployWebhookUrl, { method: 'POST' });
        console.log('🚀 已成功發送重新編譯 Hook');
      } catch (err) {
        console.warn('⚠️ 無法發送編譯 Hook：', err);
      }
    }

    // --- 初始化地圖 ---
    async function initGoogleMap() {
      const mapElement = document.getElementById('travel-map');
      if (!mapElement || !window.google || !window.google.maps) {
        console.warn('⚠️ Google Maps API 未載入完成，稍後重新嘗試。');
        return;
      }

      // 預設中心點：日本東京 (35.6762, 139.6503)
      googleMap = new window.google.maps.Map(mapElement, {
        center: { lat: 35.6762, lng: 139.6503 },
        zoom: 12,
        mapId: 'DEMO_MAP_ID',
        disableDefaultUI: false,
        zoomControl: true,
        mapTypeControl: false,
        streetViewControl: false
      });

      // 暴露給外部 (trip.astro) 使用，用於 tab 切換時重新計算大小
      window.travelMap = googleMap;
      window.resizeTravelMap = () => {
        if (googleMap) {
          window.google.maps.event.trigger(googleMap, 'resize');
          if (typeof filterAndRenderSpots === 'function') {
            filterAndRenderSpots(true);
          }
        }
      };

      // 點擊地圖事件：關閉氣泡 ＋ 管理員點擊新增
      googleMap.addListener('click', async (e) => {
        if (openInfoWindow) {
          openInfoWindow.close();
          openInfoWindow = null;
        }

        // 只有管理員可以點擊地圖新增景點
        if (!isAdminUser) return;

        const lat = e.latLng.lat();
        const lng = e.latLng.lng();

        const geocoder = new window.google.maps.Geocoder();
        // 使用 zh-TW 語言，優先取得繁體中文地址
        geocoder.geocode({ location: { lat, lng }, language: 'zh-TW' }, (results, status) => {
          if (status === 'OK' && results[0]) {
            openAddSpotModal({
              lat,
              lng,
              address: results[0].formatted_address,
              name: '' // 點擊地圖新增，名稱保持空白
            });
          } else {
            // 若解析失敗，依然允許帶入經緯度新增，地址留空
            openAddSpotModal({
              lat,
              lng,
              address: '',
              name: ''
            });
          }
        });
      });

      // 初始化搜尋功能 (Places API New - searchByText)
      try {
        console.log("🔍 [Places API (New)] 開始載入新版 Places Library...");
        const [{ Place, AutocompleteSuggestion }, { AdvancedMarkerElement }] = await Promise.all([
          window.google.maps.importLibrary("places"),
          window.google.maps.importLibrary("marker")
        ]);
        
        if (!Place || !AutocompleteSuggestion || !AdvancedMarkerElement) {
          console.error("❌ [Places API (New)] Library 未能從 Google Maps SDK 載入！");
        } else {
          console.log("🟢 [Places API (New)] Library 載入成功，準備綁定搜尋功能...");
          
          const input = document.getElementById('travel-search-input');
          const searchBtn = document.getElementById('travel-search-btn');
          const dropdown = document.getElementById('travel-search-dropdown');
          const searchContainer = document.querySelector('.travel-search-bar');
          
          if (input && searchBtn && dropdown) {
          
            // Helper: 計算地圖當前對角線一半長度為半徑 (公尺)
            function calculateRadius(map) {
              const bounds = map.getBounds();
              if (!bounds) return 5000;
              const ne = bounds.getNorthEast();
              const sw = bounds.getSouthWest();
              const latDiff = Math.abs(ne.lat() - sw.lat());
              const lngDiff = Math.abs(ne.lng() - sw.lng());
              return Math.min(Math.sqrt(latDiff*latDiff + lngDiff*lngDiff) * 111000 / 2, 50000);
            }

            // 行為 1：打字即時聯想
            let debounceTimer;
            input.addEventListener('input', () => {
              clearTimeout(debounceTimer);
              const val = input.value.trim();
              if (val.length < 2) {
                dropdown.style.display = 'none';
                dropdown.innerHTML = '';
                return;
              }
              
              debounceTimer = setTimeout(async () => {
                try {
                  const { suggestions } = await AutocompleteSuggestion.fetchAutocompleteSuggestions({
                    input: val,
                    locationBias: {
                      center: googleMap.getCenter(),
                      radius: calculateRadius(googleMap)
                    },
                    language: 'zh-TW'
                  });
                  
                  dropdown.innerHTML = '';
                  
                  if (!suggestions || suggestions.length === 0) {
                    dropdown.style.display = 'none';
                    return;
                  }
                  
                  suggestions.slice(0, 5).forEach((suggestion) => {
                    const text = suggestion.placePrediction.text.toString();
                    
                    const item = document.createElement('div');
                    item.className = 'search-result-item';
                    item.innerHTML = `<div class="search-result-name">${text}</div>`;
                    
                    item.addEventListener('click', async () => {
                      dropdown.style.display = 'none';
                      input.value = text;
                      
                      try {
                        const place = suggestion.placePrediction.toPlace();
                        await place.fetchFields({ fields: ['displayName', 'formattedAddress', 'location', 'id'] });
                        
                        if (!place.location) return;
                        
                        const lat = place.location.lat();
                        const lng = place.location.lng();
                        const displayName = place.displayName || '';
                        const formattedAddress = place.formattedAddress || '';
                        const placeId = place.id || '';
                        
                        // 清除上次搜尋標記
                        searchMarkers.forEach(m => m.map = null);
                        searchMarkers = [];
                        if (openInfoWindow) openInfoWindow.close();
                        
                        googleMap.setCenter(place.location);
                        googleMap.setZoom(15);
                        
                        const pin = new window.google.maps.marker.PinElement({
                          background: "#4A90D9",
                          borderColor: "white",
                          glyphColor: "white",
                          scale: 1.2
                        });
                        
                        const marker = new AdvancedMarkerElement({
                          map: googleMap,
                          position: place.location,
                          title: displayName,
                          content: pin.element
                        });
                        
                        searchMarkers.push(marker);
                        
                        const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(displayName)}&query_place_id=${placeId}`;
                        
                        const iw = new window.google.maps.InfoWindow({
                          content: `
                            <div style="font-family:serif;padding:8px;min-width:180px;">
                              <div style="font-weight: bold; margin-bottom: 4px;">${place.displayName}</div>
                              <div style="font-size: 12px; color: #666; margin-bottom: 10px;">${place.formattedAddress}</div>
                              <div style="display:flex;gap:8px;">
                                <button onclick="window.addSpotFromSearch(
                                  '${String(place.displayName).replace(/'/g, "\\'")}',
                                  '${String(place.formattedAddress).replace(/'/g, "\\'")}',
                                  ${lat},
                                  ${lng},
                                  '${placeId}'
                                )" style="
                                  background:#8B7355;color:white;border:none;
                                  padding:6px 14px;border-radius:16px;
                                  font-size:12px;cursor:pointer;
                                  flex: 1;
                                ">＋ 加入行程</button>
                                <a href="${mapsUrl}" target="_blank" style="
                                  background:white;color:#8B7355;border:1px solid #8B7355;
                                  padding:5px 14px;border-radius:16px;
                                  font-size:12px;cursor:pointer;text-decoration:none;
                                  display:inline-flex;align-items:center;justify-content:center;
                                  flex: 1;
                                ">🗺 Google Maps</a>
                              </div>
                            </div>
                          `
                        });
                        
                        marker.addEventListener('gmp-click', () => {
                          if (openInfoWindow) openInfoWindow.close();
                          iw.open({ map: googleMap, anchor: marker });
                          openInfoWindow = iw;
                        });
                        
                        iw.open({ map: googleMap, anchor: marker });
                        openInfoWindow = iw;
                        
                      } catch (err) {
                        console.error('❌ [Places API (New)] 取得地點詳情失敗：', err);
                      }
                    });
                    
                    dropdown.appendChild(item);
                  });
                  
                  dropdown.style.display = 'block';
                  
                } catch (err) {
                  console.error('❌ [Places API (New)] Autocomplete 失敗：', err);
                }
              }, 300);
            });

            // 行為 2：點擊搜尋按鈕後多點顯示
            searchBtn.addEventListener('click', async () => {
              const query = input.value.trim();
              if (!query) return;
              
              dropdown.style.display = 'none';
              
              console.log(`🔍 [Places API (New)] 開始搜尋：${query}`);
              searchBtn.disabled = true;
              searchBtn.textContent = '搜尋中...';
              
              try {
                const bounds = googleMap.getBounds();
                const { places } = await Place.searchByText({
                  textQuery: query,
                  fields: ['displayName', 'formattedAddress', 'location', 'id'],
                  locationRestriction: bounds,
                  language: 'zh-TW',
                  maxResultCount: 20
                });
                
                console.log(`🟢 [Places API (New)] 搜尋成功，找到 ${places?.length || 0} 個結果`);
                
                // 清除上次搜尋標記
                searchMarkers.forEach(m => m.map = null);
                searchMarkers = [];
                if (openInfoWindow) openInfoWindow.close();
                
                if (!places || places.length === 0) {
                  alert('在此區域找不到相關地點，請換個關鍵字或移動地圖試試！');
                  return;
                }
                
                // 建立所有結果的標記
                const resultBounds = new window.google.maps.LatLngBounds();
                
                places.forEach((place) => {
                  if (!place.location) return;
                  
                  const lat = place.location.lat();
                  const lng = place.location.lng();
                  const displayName = place.displayName || '';
                  const formattedAddress = place.formattedAddress || '';
                  const placeId = place.id || '';
                  
                  const pin = new window.google.maps.marker.PinElement({
                    background: "#4A90D9",
                    borderColor: "white",
                    glyphColor: "white",
                    scale: 1.2
                  });
                  
                  const marker = new AdvancedMarkerElement({
                    map: googleMap,
                    position: place.location,
                    title: displayName,
                    content: pin.element
                  });
                  
                  resultBounds.extend(place.location);
                  searchMarkers.push(marker);
                  
                  const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(displayName)}&query_place_id=${placeId}`;
                  
                  const iw = new window.google.maps.InfoWindow({
                    content: `
                      <div style="font-family:serif;padding:8px;min-width:180px;">
                        <div style="font-weight: bold; margin-bottom: 4px;">${place.displayName}</div>
                        <div style="font-size: 12px; color: #666; margin-bottom: 10px;">${place.formattedAddress}</div>
                        <div style="display:flex;gap:8px;">
                          <button onclick="window.addSpotFromSearch(
                            '${String(place.displayName).replace(/'/g, "\\'")}',
                            '${String(place.formattedAddress).replace(/'/g, "\\'")}',
                            ${lat},
                            ${lng},
                            '${placeId}'
                          )" style="
                            background:#8B7355;color:white;border:none;
                            padding:6px 14px;border-radius:16px;
                            font-size:12px;cursor:pointer;
                            flex: 1;
                          ">＋ 加入行程</button>
                          <a href="${mapsUrl}" target="_blank" style="
                            background:white;color:#8B7355;border:1px solid #8B7355;
                            padding:5px 14px;border-radius:16px;
                            font-size:12px;cursor:pointer;text-decoration:none;
                            display:inline-flex;align-items:center;justify-content:center;
                            flex: 1;
                          ">🗺 Google Maps</a>
                        </div>
                      </div>
                    `
                  });
                  
                  marker.addEventListener('gmp-click', () => {
                    if (openInfoWindow) openInfoWindow.close();
                    iw.open({ map: googleMap, anchor: marker });
                    openInfoWindow = iw;
                  });
                });
                
                // 調整地圖縮放以顯示所有標記
                if (places.length > 1) {
                  googleMap.fitBounds(resultBounds);
                } else if (places.length === 1) {
                  googleMap.setCenter(places[0].location);
                  googleMap.setZoom(15);
                }
                
              } catch (err) {
                console.error("❌ [Places API (New)] 搜尋失敗：", err);
                alert('搜尋發生錯誤，請稍後再試');
              } finally {
                searchBtn.disabled = false;
                searchBtn.textContent = '搜尋';
              }
            });
            
            // 支援 Enter 鍵搜尋
            input.addEventListener('keypress', (e) => {
              if (e.key === 'Enter') {
                e.preventDefault();
                searchBtn.click();
              }
            });
            
            // 點擊外部關閉選單
            document.addEventListener('click', (e) => {
              if (dropdown && searchContainer && !searchContainer.contains(e.target)) {
                dropdown.style.display = 'none';
              }
            });
            
          } else {
            console.warn("⚠️ [Places API (New)] 在 DOM 中找不到 #travel-search-input 或相關元素。");
          }
        }
      } catch (err) {
        console.error('❌ [Places API (New)] 初始化過程發生未預期的錯誤：', err);
      }

      console.log('🗺️ Google Map 初始化成功！');
    }

    function getSpotIcon(spot) {
      if (spot.spot_subtype_id) {
        const subtype = spotSubtypesCache.find(st => st.id === spot.spot_subtype_id);
        if (subtype) return subtype.emoji;
      }
      if (spot.spot_type_id) {
        const type = spotTypesCache.find(t => t.id === spot.spot_type_id);
        if (type) return type.emoji;
      }
      return '📍';
    }

    // --- 自訂 HTML Marker (改用 AdvancedMarkerElement) ---
    function createCustomMarker(spot) {
      if (!googleMap || !window.google || !window.google.maps.marker) return null;

      const lat = parseFloat(spot.lat);
      const lng = parseFloat(spot.lng);
      if (isNaN(lat) || isNaN(lng)) return null;

      const emoji = getSpotIcon(spot);

      // 建立自訂的內容元素
      const markerContent = document.createElement('div');
      markerContent.className = `custom-map-marker ${spot.status}`;
      markerContent.style.cursor = 'pointer';
      
      let isChainStore = false;
      if (spot.spot_type_id) {
        const type = spotTypesCache.find(t => t.id === spot.spot_type_id);
        if (type && type.is_chain_store) isChainStore = true;
      }
      if (spot.spot_subtype_id) {
        const subtype = spotSubtypesCache.find(st => st.id === spot.spot_subtype_id);
        if (subtype && subtype.is_chain_store) isChainStore = true;
      }
      if (isChainStore) {
        markerContent.classList.add('is-chain-store');
      }
      
      // 評價點綴
      let ratingDot = '';
      if (spot.status === 'visited' && spot.rating) {
        markerContent.classList.add(`rating-card-${spot.rating}`);
        ratingDot = `<span class="marker-rating-dot rating-dot-${spot.rating}"></span>`;
      }

      markerContent.innerHTML = `
        <div class="marker-circle">
          <span class="marker-emoji">${emoji}</span>
        </div>
        ${ratingDot}
      `;

      const marker = new window.google.maps.marker.AdvancedMarkerElement({
        map: googleMap,
        position: { lat, lng },
        content: markerContent,
        title: spot.name,
        gmpClickable: true
      });

      // 監聽點擊，打開氣泡資訊視窗
      marker.addEventListener('gmp-click', (e) => {
        console.log('景點 Marker 被點擊：', spot.name);
        if (e && typeof e.stopPropagation === 'function') {
          e.stopPropagation(); // 阻止冒泡到地圖，避免觸發新增景點
        } else if (e && e.domEvent && typeof e.domEvent.stopPropagation === 'function') {
          e.domEvent.stopPropagation();
        }

        if (openInfoWindow) {
          openInfoWindow.close();
        }

        let subtypeLabel = '';
        if (spot.spot_subtype_id) {
          const subtype = spotSubtypesCache.find(st => st.id === spot.spot_subtype_id);
          if (subtype) {
            subtypeLabel = subtype.name;
          }
        }

        const mapsUrl = spot.place_id
          ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(spot.name)}&query_place_id=${spot.place_id}`
          : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(spot.name + ' ' + spot.address)}`;

        const iwContent = `
<div style="
  font-family: inherit;
  width: 240px;
  max-height: 320px;
  overflow-y: auto;
  padding: 16px;
  background: #FDFCF8;
  border-radius: 12px;
  color: #3a2e24;
">
  <!-- 標題列 -->
  <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
    <span style="font-size:20px;">${emoji}</span>
    <div>
      <div style="font-weight:700; font-size:15px; color:#3a2e24;">${spot.name}</div>
      ${subtypeLabel ? `<span style="font-size:11px; background:#f0ebe3; color:#8B7355; padding:2px 8px; border-radius:20px; display:inline-block; margin-top:4px;">${subtypeLabel}</span>` : ''}
    </div>
  </div>
  
  <!-- 資訊列 -->
  ${spot.address ? `
  <div style="display:flex; gap:6px; margin-bottom:8px; font-size:13px; color:#5a4a35;">
    <span>📍</span><span style="line-height:1.4;">${spot.address}</span>
  </div>` : ''}
  
  ${spot.open_hours ? `
  <div style="display:flex; gap:6px; margin-bottom:8px; font-size:13px; color:#5a4a35;">
    <span>🕐</span><span style="line-height:1.4;">${spot.open_hours}</span>
  </div>` : ''}
  
  ${spot.price ? `
  <div style="display:flex; gap:6px; margin-bottom:8px; font-size:13px; color:#5a4a35;">
    <span>💰</span><span style="line-height:1.4;">${spot.price}</span>
  </div>` : ''}
  
  ${spot.note ? `
  <div style="display:flex; gap:6px; margin-bottom:12px; font-size:13px; color:#5a4a35;">
    <span>📝</span><span style="line-height:1.4;">${linkifyText(spot.note)}</span>
  </div>` : ''}
  
  <!-- 按鈕列 -->
  <div style="display:flex; gap:8px; margin-top:12px; border-top:1px solid #e8ddd0; padding-top:12px;">
    <a href="${mapsUrl}" target="_blank" style="
      flex:1; text-align:center; padding:7px;
      background:#f0ebe3; color:#8B7355;
      border-radius:8px; font-size:12px;
      text-decoration:none; font-weight:600;
    ">🗺 Google Maps</a>
    ${isAdminUser ? `
    <button onclick="window.openSpotModal('${spot.id}')" style="
      flex:1; padding:7px;
      background:#8B7355; color:white;
      border:none; border-radius:8px;
      font-size:12px; cursor:pointer; font-weight:600;
    ">✏️ 編輯</button>` : ''}
  </div>
</div>
        `;

        openInfoWindow = new window.google.maps.InfoWindow({
          content: iwContent
        });

        openInfoWindow.open({ map: googleMap, anchor: marker });
      });

      return marker;
    }

    // --- 調整地圖視野 ---
    function fitMapToSpots(filteredSpots) {
      if (!googleMap) return;
      const bounds = new window.google.maps.LatLngBounds();
      let validSpotsCount = 0;

      filteredSpots.forEach(spot => {
        const lat = parseFloat(spot.lat);
        const lng = parseFloat(spot.lng);
        if (!isNaN(lat) && !isNaN(lng)) {
          bounds.extend(new window.google.maps.LatLng(lat, lng));
          validSpotsCount++;
        }
      });

      if (validSpotsCount > 0) {
        // 延遲一下確保投影計算正常
        setTimeout(() => {
          if (googleMap) {
            if (validSpotsCount === 1) {
              googleMap.setCenter(bounds.getCenter());
              googleMap.setZoom(14);
            } else {
              googleMap.fitBounds(bounds);
              // 避免地圖靠得太近
              const listener = googleMap.addListener('bounds_changed', () => {
                if (googleMap.getZoom() > 16) googleMap.setZoom(16);
                window.google.maps.event.removeListener(listener);
              });
            }
          }
        }, 300);
      } else {
        // 無景點時重設為東京
        googleMap.setCenter({ lat: 35.6762, lng: 139.6503 });
        googleMap.setZoom(12);
      }
    }

    // --- 更新地圖上的 Markers ---
    function updateMapMarkers(filteredSpots) {
      // 1. 清除舊 Markers
      mapMarkers.forEach(marker => {
        if (marker.map !== undefined) marker.map = null;
        else if (marker.setMap) marker.setMap(null);
      });
      mapMarkers = [];

      if (openInfoWindow) {
        openInfoWindow.close();
        openInfoWindow = null;
      }

      if (!googleMap) return;

      // 2. 建立新 Markers
      filteredSpots.forEach(spot => {
        const lat = parseFloat(spot.lat);
        const lng = parseFloat(spot.lng);
        if (!isNaN(lat) && !isNaN(lng)) {
          const marker = createCustomMarker(spot);
          if (marker) {
            mapMarkers.push(marker);
          }
        }
      });
    }

    // --- 依照分類與狀態篩選景點，並重繪地圖與列表 ---
    function filterAndRenderSpots(shouldFitBounds = false) {
      const container = document.getElementById('spots-cards-container');
      if (!container) return;

      // 1. 篩選目前行程且符合 Category 與 Status 的景點
      let filtered = spotsCache.filter(spot => String(spot.trip_id) === String(currentTripId));

      // 狀態篩選 (想去 / 已去)
      filtered = filtered.filter(spot => spot.status === selectedStatusFilter);

      // 類型篩選 (全部 / 景點 / 飲食 / 購物 / 住宿)
      if (selectedCategoryFilter !== 'all') {
        filtered = filtered.filter(spot => spot.spot_type_id === selectedCategoryFilter);
      }

      // 子類型篩選
      if (selectedSubcategoryFilter !== 'all') {
        filtered = filtered.filter(spot => spot.spot_subtype_id === selectedSubcategoryFilter);
      }

      // 搜尋篩選 (名稱、地址、備註)
      const searchInput = document.getElementById('saved-spots-search');
      if (searchInput) {
        const searchQuery = searchInput.value.trim().toLowerCase();
        if (searchQuery) {
          filtered = filtered.filter(spot => {
            return (spot.name && spot.name.toLowerCase().includes(searchQuery)) ||
                   (spot.note && spot.note.toLowerCase().includes(searchQuery)) ||
                   (spot.address && spot.address.toLowerCase().includes(searchQuery));
          });
        }
      }

      // 地圖標記渲染過濾：如果不是行程模式，且不顯示連鎖店，就把連鎖店濾掉
      let mapFiltered = filtered;
      if (!showChainStores) {
        mapFiltered = filtered.filter(spot => {
          let isChainStore = false;
          if (spot.spot_type_id) {
            const type = spotTypesCache.find(t => t.id === spot.spot_type_id);
            if (type && type.is_chain_store) isChainStore = true;
          }
          if (spot.spot_subtype_id) {
            const subtype = spotSubtypesCache.find(st => st.id === spot.spot_subtype_id);
            if (subtype && subtype.is_chain_store) isChainStore = true;
          }
          return !isChainStore;
        });
      }

      // 2. 更新地圖標記 (Aesthetic & Interactive Map)
      updateMapMarkers(mapFiltered);

      // 3. 調整地圖視野 (僅在初始載入或切換行程時)
      if (shouldFitBounds) {
        fitMapToSpots(mapFiltered);
      }

      // 4. 繪製景點清單
      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            這趟行程的篩選條件下，目前沒有任何景點紀錄。
          </div>
        `;
        return;
      }

      let html = '';
      filtered.forEach(spot => {
        // 評價標籤
        let ratingBadge = '';
        if (spot.status === 'visited' && spot.rating) {
          const ratingLabels = {
            recommend: '推薦',
            maybe: '有空可去',
            not_recommend: '不推'
          };
          ratingBadge = `<span class="badge-rating ${spot.rating}">${ratingLabels[spot.rating] || ''}</span>`;
        }

        // 開放時間與價格
        let metaText = '';
        if (spot.open_hours) metaText += `⏰ ${spot.open_hours}`;
        if (spot.price) {
          if (metaText) metaText += ' | ';
          metaText += `💰 ${spot.price}`;
        }
        const metaRow = metaText ? `<div class="spot-meta">${metaText}</div>` : '';

        // 照片預覽列
        let imagesRow = '';
        if (spot.images && spot.images.length > 0) {
          imagesRow = `<div class="spot-images-row">`;
          spot.images.forEach(imgUrl => {
            imagesRow += `<img src="${imgUrl}" alt="${spot.name}" class="spot-image-thumb" />`;
          });
          imagesRow += `</div>`;
        }

        // 管理員按鈕 (編輯/刪除)
        const adminActions = isAdminUser ? `
          <div class="spot-admin-actions">
            <button class="btn-spot-icon edit" data-action="edit-spot" data-spot-id="${spot.id}" title="編輯景點">
              <i class="ti ti-pencil"></i>
            </button>
            <button class="btn-spot-icon delete" data-action="delete-spot" data-spot-id="${spot.id}" title="刪除景點">
              <i class="ti ti-trash"></i>
            </button>
          </div>
        ` : '';

        const statusText = spot.status === 'visited' ? '已去' : '想去';
        
        let subtypeBadge = '';
        if (spot.spot_subtype_id) {
          const subtype = spotSubtypesCache.find(st => st.id === spot.spot_subtype_id);
          if (subtype) {
            subtypeBadge = `<span class="badge-status" style="background-color: var(--travel-bg); color: var(--travel-text-muted); border: 1px solid var(--travel-border); margin-left: 6px;">${subtype.emoji} ${subtype.name}</span>`;
          }
        }

        html += `
          <div class="spot-card ${spot.status}" data-spot-id="${spot.id}">
            <div class="spot-card-icon">
              ${getSpotIcon(spot)}
            </div>
            <div class="spot-card-main">
              <div class="spot-title-row">
                <h4 class="spot-name">${spot.name}</h4>
                <span class="badge-status ${spot.status}">${statusText}</span>
                ${subtypeBadge}
                ${ratingBadge}
              </div>
              ${metaRow}
              ${spot.note ? `<p class="spot-note">${linkifyText(spot.note)}</p>` : ''}
              ${imagesRow}
            </div>
            ${adminActions}
          </div>
        `;
      });

      container.innerHTML = html;

      // 4. 綁定列表內的點擊與管理事件
      // 點擊照片放大 Lightbox
      container.querySelectorAll('.spot-image-thumb').forEach(img => {
        img.addEventListener('click', (e) => {
          const src = e.currentTarget.src;
          const lightbox = document.getElementById('lightbox');
          const lightboxImg = document.getElementById('lightbox-img');
          if (lightbox && lightboxImg) {
            lightboxImg.src = src;
            lightbox.style.display = 'flex';
            document.body.classList.add('modal-open');
          }
        });
      });

      // 點擊卡片地圖置中
      container.querySelectorAll('.spot-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // 如果點擊的是按鈕或照片，不要觸發地圖移動
          const target = e.target;
          if (target.closest('.spot-admin-actions') || target.closest('.spot-image-thumb')) {
            return;
          }

          const spotId = e.currentTarget.dataset.spotId;
          const spot = spotsCache.find(s => String(s.id) === String(spotId));
          if (spot && googleMap) {
            const lat = parseFloat(spot.lat);
            const lng = parseFloat(spot.lng);
            if (!isNaN(lat) && !isNaN(lng)) {
              googleMap.panTo({ lat, lng });
              googleMap.setZoom(16);
            }
          }
        });
      });

    }

    // --- 切換行程行程標籤 ---
    function selectTrip(tripId) {
      currentTripId = tripId;
      window.currentTripId = tripId;
      window.dispatchEvent(new CustomEvent('trip-changed', { detail: { tripId } }));

      // 1. 更新行程標籤 UI
      const tabsList = document.getElementById('trips-tab-list');
      tabsList?.querySelectorAll('.trip-tab').forEach(tab => {
        if (tab.dataset.tripId === tripId) {
          tab.classList.add('active');
          
          // 更新標題
          const titleEl = document.getElementById('current-trip-title');
          const tripName = tab.dataset.tripName || '';
          const tripDesc = tab.dataset.tripDesc || '';
          if (titleEl) {
            titleEl.innerHTML = `📍 ${tripName} <span style="font-size: 0.85rem; font-weight:400; color: var(--travel-text-muted); display:block; margin-top:4px;">${tripDesc}</span>`;
          }
        } else {
          tab.classList.remove('active');
        }
      });

      // 2. 重繪該行程景點
      filterAndRenderSpots(true);

      // 3. 若目前為行程模式，則重新載入天數
      if (currentMode === 'itinerary') {
        loadTripDays();
      }
    }

    // ==========================================
    // 6. 身分驗證與管理員介面切換
    // ==========================================
    async function initAuthAndData() {
      // 1. 先從資料庫拉取最新資料 (確保資料一致性)
      const { data: trips } = await supabase.from('trips').select('*').order('created_at', { ascending: true });
      const { data: spots } = await supabase.from('spots').select('*').order('created_at', { ascending: false });
      const { data: spotTypes } = await supabase.from('spot_types').select('*').order('created_at', { ascending: true });
      const { data: spotSubtypes } = await supabase.from('spot_subtypes').select('*').order('created_at', { ascending: true });

      tripsCache = trips || [];
      spotsCache = spots || [];
      spotTypesCache = spotTypes || [];
      spotSubtypesCache = spotSubtypes || [];
      
      renderCategoryFilters();
      renderSpotCategoryOptions();

      // 2. 決定預選的行程
      if (tripsCache.length > 0) {
        currentTripId = tripsCache[0].id;
      }

      // 3. 地圖載入完畢後初始化
      await googleMapsPromise;
      await initGoogleMap();

      // 4. 偵測管理員登入狀態
      
      const topAuthGuest = document.getElementById('top-auth-guest');
      const topAuthUser = document.getElementById('top-auth-user');
      
      document.getElementById('btn-top-logout')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.reload();
      });

      function updateAuthUI(currentSession) {
        if (currentSession && currentSession.user.email === adminEmail) {
          isAdminUser = true;
          document.querySelectorAll('.admin-only').forEach(el => {
            el.style.display = 'inline-flex';
          });
          if (topAuthGuest) topAuthGuest.style.display = 'none';
          if (topAuthUser) topAuthUser.style.display = 'block';

          console.log('🔑 管理員已登入，啟用前台管理介面。');
        } else {
          isAdminUser = false;
          document.querySelectorAll('.admin-only').forEach(el => {
            el.style.display = 'none';
          });
          if (topAuthGuest) topAuthGuest.style.display = 'block';
          if (topAuthUser) topAuthUser.style.display = 'none';
        }
      }

      window.addEventListener('auth-state-changed', async (e) => {
        const { event, session: currentSession } = e.detail;
        if (event === 'SIGNED_IN' || event === 'INITIAL_SESSION') {
          updateAuthUI(currentSession);
        }
        if (event === 'SIGNED_OUT') {
          updateAuthUI(null);
        }
      });

      // 5. 初次繪製
      if (currentTripId) {
        selectTrip(currentTripId);
      } else {
        // 沒有行程時顯示空狀態
        const container = document.getElementById('spots-cards-container');
        if (container) {
          container.innerHTML = `
            <div class="empty-state">
              目前沒有行程，請點選「新增行程」開始建立。
            </div>
          `;
        }
      }
    }

    // ==========================================
    // 7. 每日行程 (Itinerary Mode) 邏輯
    // ==========================================
    let currentMode = 'map'; // 'map' or 'itinerary'
    let tripDaysCache = [];
    let daySpotsCache = [];
    let currentDayId = null;
    let itineraryMarkers = [];
    let itineraryPolyline = null;

    function initItineraryEvents() {
      const btnMap = document.getElementById('btn-mode-map');
      const btnItinerary = document.getElementById('btn-mode-itinerary');
      
      btnMap?.addEventListener('click', () => toggleMode('map'));
      btnItinerary?.addEventListener('click', () => toggleMode('itinerary'));

      const btnAddDay = document.getElementById('btn-add-day');
      btnAddDay?.addEventListener('click', addTripDay);

      const btnOpenWishlist = document.getElementById('btn-open-wishlist-modal');
      btnOpenWishlist?.addEventListener('click', openWishlistModal);

      const btnCloseWishlist = document.getElementById('btn-wishlist-modal-close');
      btnCloseWishlist?.addEventListener('click', closeWishlistModal);

      document.getElementById('btn-spot-detail-close')?.addEventListener('click', () => {
        document.getElementById('spot-detail-modal').classList.remove('show');
        document.body.classList.remove('modal-open');
      });
      
      // 事件委派：天數列表
      const daysList = document.getElementById('itinerary-days-list');
      daysList?.addEventListener('click', async (e) => {
        const delBtn = e.target.closest('.btn-day-delete');
        if (delBtn) {
          e.stopPropagation();
          const dayId = delBtn.dataset.id;
          if (confirm('確定要刪除這一天嗎？將會一併移除該天的景點安排。')) {
            await deleteTripDay(dayId);
          }
          return;
        }
        
        const upBtn = e.target.closest('.btn-day-up');
        if (upBtn && !upBtn.disabled) {
          e.stopPropagation();
          await moveTripDay(upBtn.dataset.id, -1);
          return;
        }

        const downBtn = e.target.closest('.btn-day-down');
        if (downBtn && !downBtn.disabled) {
          e.stopPropagation();
          await moveTripDay(downBtn.dataset.id, 1);
          return;
        }
        
        const dayBtn = e.target.closest('.day-btn');
        if (dayBtn) {
          selectTripDay(dayBtn.dataset.id);
        }
      });
      
      // 事件委派：景點列表
      const spotsList = document.getElementById('itinerary-spots-list');
      spotsList?.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btn-itinerary-action');
        if (btn) {
          if (!isAdminUser) return;
          const daySpotId = btn.dataset.id;
          if (btn.classList.contains('delete')) {
            if (confirm('確定從行程中移除此景點？')) {
              await removeSpotFromDay(daySpotId);
            }
          } else if (btn.classList.contains('move-up')) {
            await moveSpotOrder(daySpotId, -1);
          } else if (btn.classList.contains('move-down')) {
            await moveSpotOrder(daySpotId, 1);
          }
          return;
        }

        // 點擊卡片顯示詳情
        const spotItem = e.target.closest('.itinerary-spot-item');
        if (spotItem) {
          const dsId = spotItem.dataset.id;
          const ds = daySpotsCache.find(d => d.id == dsId);
          if (ds && ds.spot) {
            openSpotDetailModal(ds.spot);
          }
        }
      });

      // 想去清單搜尋
      const wishlistSearchInput = document.getElementById('wishlist-search-input');
      wishlistSearchInput?.addEventListener('input', (e) => {
        const keyword = e.target.value.toLowerCase().trim();
        const items = document.querySelectorAll('#wishlist-select-container .wishlist-item');
        items.forEach(item => {
          const searchText = (item.dataset.searchText || '').toLowerCase();
          if (searchText.includes(keyword)) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    async function toggleMode(mode) {
      if (currentMode === mode) return;
      currentMode = mode;
      
      const btnMap = document.getElementById('btn-mode-map');
      const btnItinerary = document.getElementById('btn-mode-itinerary');
      
      const searchBar = document.querySelector('.travel-search-bar');
      const filterBar = document.querySelector('.travel-filter-bar');
      const spotsListSec = document.querySelector('.spots-list-section');
      const itineraryView = document.getElementById('itinerary-mode-view');
      
      if (mode === 'map') {
        btnMap.classList.add('active');
        btnItinerary.classList.remove('active');
        
        searchBar.style.display = 'block';
        filterBar.style.display = 'flex';
        spotsListSec.style.display = 'block';
        itineraryView.style.display = 'none';
        
        clearItineraryMap();
        filterAndRenderSpots(); // 恢復原始地圖與列表
      } else {
        btnMap.classList.remove('active');
        btnItinerary.classList.add('active');
        
        searchBar.style.display = 'none';
        filterBar.style.display = 'none';
        spotsListSec.style.display = 'none';
        itineraryView.style.display = 'flex';
        
        console.log('切換為行程模式，正在清除原始 Marker...');
        clearMapMarkers(); // 清除原始地圖 markers
        console.log('載入行程天數...');
        await loadTripDays();
      }
    }

    async function loadTripDays() {
      if (!currentTripId) return;
      const { data, error } = await supabase
        .from('trip_days')
        .select('*')
        .eq('trip_id', currentTripId)
        .order('day_number', { ascending: true });
        
      if (error) {
        console.error('載入行程天數失敗:', error);
        return;
      }
      
      tripDaysCache = data || [];
      renderTripDays();
      
      if (tripDaysCache.length > 0) {
        selectTripDay(tripDaysCache[0].id);
      } else {
        currentDayId = null;
        document.getElementById('itinerary-day-title').textContent = '請先新增天數';
        document.getElementById('itinerary-spots-list').innerHTML = '<div class="empty-state">尚無行程天數，請點選左側「新增一天」</div>';
        clearItineraryMap();
      }
    }

    function renderTripDays() {
      const list = document.getElementById('itinerary-days-list');
      if (!list) return;
      
      let html = '';
      tripDaysCache.forEach((day, index) => {
        const isActive = day.id === currentDayId;
        const isFirst = index === 0;
        const isLast = index === tripDaysCache.length - 1;
        html += `
          <div class="day-btn-wrapper" style="display: flex; align-items: center; gap: 4px; flex-wrap: nowrap;">
            <button class="day-btn ${isActive ? 'active' : ''}" data-id="${day.id}" style="flex-grow: 1; min-width: 80px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 10px 8px;">
              第 ${day.day_number} 天
            </button>
            ${isAdminUser ? `
              <button class="btn-day-up admin-only" data-id="${day.id}" title="向上移" style="background: none; border: none; font-size: 1rem; cursor: pointer; padding: 2px; color: var(--travel-text-muted); opacity: ${isFirst ? '0.3' : '0.6'}; transition: opacity 0.2s;" ${isFirst ? 'disabled' : ''} onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='${isFirst ? '0.3' : '0.6'}'"><i class="ti ti-arrow-up"></i></button>
              <button class="btn-day-down admin-only" data-id="${day.id}" title="向下移" style="background: none; border: none; font-size: 1rem; cursor: pointer; padding: 2px; color: var(--travel-text-muted); opacity: ${isLast ? '0.3' : '0.6'}; transition: opacity 0.2s; margin-right: 0px;" ${isLast ? 'disabled' : ''} onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='${isLast ? '0.3' : '0.6'}'"><i class="ti ti-arrow-down"></i></button>
              <button class="btn-day-delete admin-only" data-id="${day.id}" title="刪除" style="font-size: 1rem; padding: 2px;"><i class="ti ti-trash"></i></button>
            ` : ''}
          </div>
        `;
      });
      list.innerHTML = html;
    }

    async function addTripDay() {
      if (!currentTripId) {
        showToast('請先選擇或建立旅行行程');
        return;
      }
      const nextDayNum = tripDaysCache.length > 0 
        ? Math.max(...tripDaysCache.map(d => d.day_number)) + 1 
        : 1;
        
      const { data, error } = await supabase
        .from('trip_days')
        .insert([{ trip_id: currentTripId, day_number: nextDayNum }])
        .select()
        .single();
        
      if (error) {
        alert('新增天數失敗: ' + error.message);
        return;
      }
      
      tripDaysCache.push(data);
      renderTripDays();
      selectTripDay(data.id);
      showToast('已新增第 ' + nextDayNum + ' 天');
    }

    async function deleteTripDay(dayId) {
      const { error } = await supabase.from('trip_days').delete().eq('id', dayId);
      if (error) {
        alert('刪除天數失敗: ' + error.message);
        return;
      }
      showToast('已刪除');
      if (currentDayId === dayId) currentDayId = null;
      await loadTripDays();
    }

    async function moveTripDay(dayId, direction) {
      const currentIndex = tripDaysCache.findIndex(d => d.id === dayId);
      if (currentIndex < 0) return;
      const targetIndex = currentIndex + direction;
      if (targetIndex < 0 || targetIndex >= tripDaysCache.length) return;
      
      const currentDay = tripDaysCache[currentIndex];
      const targetDay = tripDaysCache[targetIndex];
      
      const currentNum = currentDay.day_number;
      const targetNum = targetDay.day_number;
      
      // 更新暫存以求即時反應
      currentDay.day_number = targetNum;
      targetDay.day_number = currentNum;
      tripDaysCache.sort((a, b) => a.day_number - b.day_number);
      renderTripDays();
      
      // 批次更新資料庫
      const { error } = await supabase
        .from('trip_days')
        .upsert([
          { id: currentDay.id, trip_id: currentDay.trip_id, day_number: targetNum },
          { id: targetDay.id, trip_id: targetDay.trip_id, day_number: currentNum }
        ]);
        
      if (error) {
        console.error('排序更新失敗', error);
        await loadTripDays(); // 還原
      }
    }

    async function selectTripDay(dayId) {
      currentDayId = dayId;
      renderTripDays(); // 更新 active 狀態
      
      const day = tripDaysCache.find(d => d.id === dayId);
      if (day) {
        const titleEl = document.getElementById('itinerary-day-title');
        if (titleEl) titleEl.textContent = `第 ${day.day_number} 天 行程`;
      }
      
      await loadDaySpots(dayId);
    }

    async function loadDaySpots(dayId) {
      if (!dayId) return;
      const { data, error } = await supabase
        .from('day_spots')
        .select('*')
        .eq('day_id', dayId)
        .order('order_index', { ascending: true });
        
      if (error) {
        console.error('載入景點安排失敗:', error);
        return;
      }
      
      // 合併 spotsCache 資料
      daySpotsCache = (data || []).map(ds => {
        // Spot ID comparison issues: DOM IDs or string IDs vs BigInt IDs
        // Supabase returns string for UUID and bigint. JS handles string comparison well.
        // It's safer to use double equals or string conversion.
        const spotInfo = spotsCache.find(s => s.id == ds.spot_id) || {};
        return { ...ds, spot: spotInfo };
      }).filter(ds => ds.spot && ds.spot.id); // 過濾掉已被刪除的景點
      
      renderDaySpots();
      renderItineraryMap();
    }

    function renderDaySpots() {
      const list = document.getElementById('itinerary-spots-list');
      if (!list) return;
      
      if (daySpotsCache.length === 0) {
        list.innerHTML = '<div class="empty-state">當天尚無景點，請點選「從想去清單選擇」加入。</div>';
        return;
      }
      
      let html = '';
      daySpotsCache.forEach((ds, index) => {
        const spot = ds.spot;
        const typeInfo = spotTypesCache.find(t => t.id == spot.spot_type_id) || { emoji: '📍' };
        
        html += `
          <div class="itinerary-spot-item" data-id="${ds.id}" style="cursor: pointer;">
            <div class="spot-order-badge">${index + 1}</div>
            <div class="spot-emoji">${typeInfo.emoji}</div>
            <div class="spot-info">
              <div class="spot-name">${spot.name}</div>
              <div class="spot-note">${spot.address || ''}</div>
            </div>
            ${isAdminUser ? `
              <div class="spot-actions admin-only">
                ${index > 0 ? `<button class="btn-itinerary-action move-up" data-id="${ds.id}"><i class="ti ti-arrow-up"></i></button>` : `<div style="width: 28px;"></div>`}
                ${index < daySpotsCache.length - 1 ? `<button class="btn-itinerary-action move-down" data-id="${ds.id}"><i class="ti ti-arrow-down"></i></button>` : `<div style="width: 28px;"></div>`}
                <button class="btn-itinerary-action delete" data-id="${ds.id}"><i class="ti ti-x"></i></button>
              </div>
            ` : ''}
          </div>
        `;
      });
      list.innerHTML = html;
    }

    function openWishlistModal() {
      if (!currentTripId || !currentDayId) return;
      const modal = document.getElementById('wishlist-modal');
      const container = document.getElementById('wishlist-select-container');
      
      // 取得此行程所有的景點
      const tripSpots = spotsCache.filter(s => s.trip_id == currentTripId);
      
      if (tripSpots.length === 0) {
        container.innerHTML = '<div class="empty-state">此行程尚未建立任何景點。請先切換至地圖模式新增景點。</div>';
      } else {
        let html = '';
        tripSpots.forEach(spot => {
          // 檢查是否已在當天
          const isAdded = daySpotsCache.some(ds => ds.spot_id == spot.id);
          const typeInfo = spotTypesCache.find(t => t.id == spot.spot_type_id) || { emoji: '📍' };
          const searchText = ((spot.name || '') + ' ' + (spot.note || '') + ' ' + (spot.address || '')).replace(/"/g, '&quot;');
          
          html += `
            <div class="wishlist-item ${isAdded ? 'disabled' : ''}" data-spot-id="${spot.id}" data-search-text="${searchText}">
              <div class="spot-emoji">${typeInfo.emoji}</div>
              <div class="spot-info">
                <div class="spot-name">${spot.name}</div>
                <div class="spot-note" style="color: ${spot.status==='visited'?'var(--travel-primary)':'#f5a623'};">
                  ${spot.status === 'visited' ? '已去' : '想去'}
                </div>
              </div>
              ${isAdded ? '<div style="color: #999; font-size: 0.8rem;">已加入</div>' : '<i class="ti ti-plus" style="color: var(--travel-primary);"></i>'}
            </div>
          `;
        });
        container.innerHTML = html;
        
        // 綁定點擊新增事件
        container.querySelectorAll('.wishlist-item:not(.disabled)').forEach(item => {
          item.addEventListener('click', () => {
            const spotId = item.dataset.spotId;
            addSpotToDay(spotId);
            closeWishlistModal();
          });
        });
      }
      
      // 清空並恢復搜尋狀態
      const searchInput = document.getElementById('wishlist-search-input');
      if (searchInput) {
        searchInput.value = '';
      }
      
      modal.classList.add('show');
      document.body.classList.add('modal-open');
    }

    function closeWishlistModal() {
      const modal = document.getElementById('wishlist-modal');
      if(modal) {
        modal.classList.remove('show');
        document.body.classList.remove('modal-open');
      }
    }

