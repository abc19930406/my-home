    async function addSpotToDay(spotId) {
      const nextOrder = daySpotsCache.length > 0 
        ? Math.max(...daySpotsCache.map(ds => ds.order_index)) + 1 
        : 0;
        
      const { data, error } = await supabase
        .from('day_spots')
        .insert([{ day_id: currentDayId, spot_id: spotId, order_index: nextOrder }])
        .select()
        .single();
        
      if (error) {
        alert('加入行程失敗: ' + error.message);
        return;
      }
      showToast('已加入行程');
      await loadDaySpots(currentDayId);
    }

    async function removeSpotFromDay(daySpotId) {
      const { error } = await supabase.from('day_spots').delete().eq('id', daySpotId);
      if (error) {
        alert('移除失敗: ' + error.message);
        return;
      }
      showToast('已移除');
      await loadDaySpots(currentDayId);
    }

    async function moveSpotOrder(daySpotId, direction) {
      const currentIndex = daySpotsCache.findIndex(ds => ds.id == daySpotId);
      if (currentIndex < 0) return;
      const targetIndex = currentIndex + direction;
      if (targetIndex < 0 || targetIndex >= daySpotsCache.length) return;
      
      const currentItem = daySpotsCache[currentIndex];
      const targetItem = daySpotsCache[targetIndex];
      
      const currentOrder = currentItem.order_index;
      const targetOrder = targetItem.order_index;
      
      // 更新本地暫存以求即時反應
      currentItem.order_index = targetOrder;
      targetItem.order_index = currentOrder;
      daySpotsCache.sort((a, b) => a.order_index - b.order_index);
      renderDaySpots();
      
      // 批次更新資料庫
      const { error } = await supabase
        .from('day_spots')
        .upsert([
          { id: currentItem.id, day_id: currentItem.day_id, spot_id: currentItem.spot_id, order_index: targetOrder },
          { id: targetItem.id, day_id: targetItem.day_id, spot_id: targetItem.spot_id, order_index: currentOrder }
        ]);
        
      if (error) {
        console.error('排序更新失敗', error);
        await loadDaySpots(currentDayId); // 還原
      } else {
        renderItineraryMap();
      }
    }

    function clearItineraryMap() {
      console.log('清除行程專屬 Marker 與 Polyline...');
      itineraryMarkers.forEach(m => {
        if (m.map !== undefined) m.map = null;
        else if (m.setMap) m.setMap(null);
      });
      itineraryMarkers = [];
      if (itineraryPolyline) {
        itineraryPolyline.setMap(null);
        itineraryPolyline = null;
      }
    }

    function clearMapMarkers() {
      console.log('執行 clearMapMarkers, 數量:', typeof mapMarkers !== 'undefined' ? mapMarkers.length : 0);
      if (typeof mapMarkers !== 'undefined') {
        mapMarkers.forEach(marker => {
          if (marker.map !== undefined) marker.map = null;
          else if (marker.setMap) marker.setMap(null);
        });
      }
    }

    async function renderItineraryMap() {
      clearItineraryMap();
      if (!googleMap || daySpotsCache.length === 0) return;

      const pathCoords = [];
      const bounds = new window.google.maps.LatLngBounds();

      const { AdvancedMarkerElement, PinElement } = await window.google.maps.importLibrary("marker");

      daySpotsCache.forEach((ds, index) => {
        const lat = parseFloat(ds.spot.lat);
        const lng = parseFloat(ds.spot.lng);
        if (isNaN(lat) || isNaN(lng)) return;
        
        const pos = { lat, lng };
        pathCoords.push(pos);
        bounds.extend(pos);

        // 自訂藍色數字圓形標記
        const markerContent = document.createElement('div');
        markerContent.style.width = '30px';
        markerContent.style.height = '30px';
        markerContent.style.backgroundColor = '#FFFFFF';
        markerContent.style.border = '2px solid var(--travel-primary)';
        markerContent.style.borderRadius = '50%';
        markerContent.style.display = 'flex';
        markerContent.style.alignItems = 'center';
        markerContent.style.justifyContent = 'center';
        markerContent.style.color = 'var(--travel-primary)';
        markerContent.style.fontWeight = 'bold';
        markerContent.style.fontSize = '14px';
        markerContent.style.boxShadow = '0 2px 6px rgba(0,0,0,0.2)';
        markerContent.textContent = (index + 1).toString();

        const marker = new AdvancedMarkerElement({
          map: googleMap,
          position: pos,
          content: markerContent,
          title: ds.spot.name
        });
        
        itineraryMarkers.push(marker);
      });

      // 繪製連線
      itineraryPolyline = new window.google.maps.Polyline({
        path: pathCoords,
        geodesic: true,
        strokeColor: 'var(--travel-primary)',
        strokeOpacity: 0.8,
        strokeWeight: 3,
        strokePattern: 'dashed',
        icons: [{
          icon: {
            path: 'M 0,-1 0,1',
            strokeOpacity: 1,
            scale: 3
          },
          offset: '0',
          repeat: '15px'
        }],
      });
      
      // 為了達到真正的虛線效果，strokeOpacity 需為 0，改由 icons 顯示
      itineraryPolyline.setOptions({ strokeOpacity: 0 });
      itineraryPolyline.setMap(googleMap);

      console.log('行程地圖繪製完成，包含座標數:', pathCoords.length);
      if (pathCoords.length > 0) {
        console.log('執行 fitBounds', bounds.toJSON());
        googleMap.fitBounds(bounds);
        // 若只有一個點，縮放會太大
        if (pathCoords.length === 1) {
          console.log('只有一個景點，手動設定 zoom = 14');
          googleMap.setZoom(14);
        } else {
          // 在 fitBounds 後加一點 padding，確保不會貼齊邊緣
          setTimeout(() => {
            console.log('fitBounds 完成');
          }, 100);
        }
      }
    }

    // --- 初始化事件監聽 ---
    const initEvents = () => {
      // 載入資料與身分驗證
      initAuthAndData();
      initItineraryEvents();

      // 0. 綁定編輯與刪除景點事件 (Event Delegation)
      const spotsContainer = document.getElementById('spots-cards-container');
      if (spotsContainer) {
        spotsContainer.addEventListener('click', async (e) => {
          if (!isAdminUser) return;
          
          const editBtn = e.target.closest('[data-action="edit-spot"]');
          if (editBtn) {
            e.stopPropagation();
            const spotId = editBtn.dataset.spotId;
            openSpotModal(spotId);
            return;
          }

          const deleteBtn = e.target.closest('[data-action="delete-spot"]');
          if (deleteBtn) {
            e.stopPropagation();
            const spotId = deleteBtn.dataset.spotId;
            if (!spotId) return;
            
            if (confirm('確定要刪除此景點嗎？刪除後將無法復原！')) {
              const { error } = await supabase.from('spots').delete().eq('id', spotId);
              if (!error) {
                showToast('景點已刪除！');
                spotsCache = spotsCache.filter(s => String(s.id) !== String(spotId));
                filterAndRenderSpots();
                triggerBuildWebhook();
              } else {
                alert('刪除失敗：' + error.message);
              }
            }
          }
        });
      }

      // 1. 綁定行程標籤點擊事件
      const tabsList = document.getElementById('trips-tab-list');
      tabsList?.addEventListener('click', (e) => {
        const tab = e.target.closest('.trip-tab');
        if (tab) {
          const id = tab.dataset.tripId;
          if (id) selectTrip(id);
        }
      });

      // 1.5 綁定已儲存景點搜尋事件
      const savedSpotsSearch = document.getElementById('saved-spots-search');
      const btnClearSavedSearch = document.getElementById('btn-clear-saved-search');
      
      if (savedSpotsSearch && btnClearSavedSearch) {
        savedSpotsSearch.addEventListener('input', (e) => {
          btnClearSavedSearch.style.display = e.target.value.trim() ? 'block' : 'none';
          filterAndRenderSpots();
        });
        
        btnClearSavedSearch.addEventListener('click', () => {
          savedSpotsSearch.value = '';
          btnClearSavedSearch.style.display = 'none';
          filterAndRenderSpots();
        });
      }

      // 2. 綁定類型篩選點擊事件
      const catGroup = document.getElementById('category-filter-group');
      catGroup?.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (btn) {
          catGroup.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedCategoryFilter = btn.dataset.category || 'all';
          selectedSubcategoryFilter = 'all'; // 類別改變時，重設子層過濾條件
          renderSubcategoryFilters(); // 更新第二層過濾列
          filterAndRenderSpots();
        }
      });

      // 2.5 綁定子類型篩選點擊事件
      const subCatGroup = document.getElementById('subcategory-filter-group');
      subCatGroup?.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (btn) {
          subCatGroup.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedSubcategoryFilter = btn.dataset.subcategory || 'all';
          filterAndRenderSpots();
        }
      });

      // 3. 綁定狀態篩選點擊事件 (想去 / 已去)
      const btnWant = document.getElementById('filter-status-want');
      const btnVisited = document.getElementById('filter-status-visited');
      
      btnWant?.addEventListener('click', () => {
        btnVisited?.classList.remove('active');
        btnWant.classList.add('active');
        selectedStatusFilter = 'want';
        filterAndRenderSpots();
      });

      btnVisited?.addEventListener('click', () => {
        btnWant?.classList.remove('active');
        btnVisited.classList.add('active');
        selectedStatusFilter = 'visited';
        filterAndRenderSpots();
      });

      const toggleChain = document.getElementById('toggle-chain-stores');
      if (toggleChain) {
        toggleChain.addEventListener('change', (e) => {
          showChainStores = e.target.checked;
          filterAndRenderSpots();
        });
      }

      // Lightbox 關閉監聽
      const lightbox = document.getElementById('lightbox');
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxOverlay = document.getElementById('lightbox-overlay');
      const closeLightbox = () => {
        if (lightbox) {
          lightbox.style.display = 'none';
          document.body.classList.remove('modal-open');
        }
      };
      lightboxClose?.addEventListener('click', closeLightbox);
      lightboxOverlay?.addEventListener('click', closeLightbox);

      // ==========================================
      // 7. Modal 互動與控制：行程 (Trips)
      // ==========================================
      const tripModal = document.getElementById('trip-modal');
      const btnAddTrip = document.getElementById('btn-add-trip');
      const btnTripClose = document.getElementById('btn-trip-modal-close');
      const btnTripCancel = document.getElementById('btn-trip-cancel');
      const tripForm = document.getElementById('trip-form');
      const tripEmojiGroup = document.getElementById('trip-emoji-selector');
      const tripSelectedEmojiInput = document.getElementById('trip-selected-emoji');

      const tripModalTitle = document.getElementById('trip-modal-title');

      btnAddTrip?.addEventListener('click', () => {
        tripForm.reset();
        document.getElementById('form-trip-id').value = '';
        if (tripModalTitle) tripModalTitle.textContent = '＋ 新增旅行行程';
        tripSelectedEmojiInput.value = '🌸';
        tripEmojiGroup?.querySelectorAll('.emoji-option').forEach(opt => {
          opt.classList.remove('selected');
          if (opt.dataset.emoji === '🌸') opt.classList.add('selected');
        });
        tripModal?.classList.add('show');
        document.body.classList.add('modal-open');
      });

      const btnEditTrip = document.getElementById('btn-edit-trip');
      btnEditTrip?.addEventListener('click', () => {
        if (!currentTripId) return;
        const trip = tripsCache.find(t => String(t.id) === String(currentTripId));
        if (!trip) return;
        
        tripForm.reset();
        document.getElementById('form-trip-id').value = trip.id;
        if (tripModalTitle) tripModalTitle.textContent = '✏️ 編輯行程';
        
        document.getElementById('trip-name').value = trip.name || '';
        document.getElementById('trip-description').value = trip.description || '';
        
        const emojiToSelect = trip.emoji || '🌸';
        tripSelectedEmojiInput.value = emojiToSelect;
        
        tripEmojiGroup?.querySelectorAll('.emoji-option').forEach(opt => {
          opt.classList.remove('selected');
          if (opt.dataset.emoji === emojiToSelect) {
            opt.classList.add('selected');
          }
        });
        
        // 如果該 emoji 不在清單中，可以考慮加入它，但目前假設都在 emoji-selector 或是 fallback
        const hasEmoji = Array.from(tripEmojiGroup?.querySelectorAll('.emoji-option') || []).some(o => o.dataset.emoji === emojiToSelect);
        if (!hasEmoji && tripEmojiGroup) {
          const newOpt = document.createElement('span');
          newOpt.className = 'emoji-option selected';
          newOpt.dataset.emoji = emojiToSelect;
          newOpt.textContent = emojiToSelect;
          tripEmojiGroup.prepend(newOpt);
        }

        tripModal?.classList.add('show');
        document.body.classList.add('modal-open');
      });

      const closeTripModal = () => {
        tripModal?.classList.remove('show');
        document.body.classList.remove('modal-open');
      };
      btnTripClose?.addEventListener('click', closeTripModal);
      btnTripCancel?.addEventListener('click', closeTripModal);

      // Emoji 選擇
      tripEmojiGroup?.addEventListener('click', (e) => {
        const opt = e.target.closest('.emoji-option');
        if (opt) {
          tripEmojiGroup.querySelectorAll('.emoji-option').forEach(o => o.classList.remove('selected'));
          opt.classList.add('selected');
          tripSelectedEmojiInput.value = opt.dataset.emoji || '🌸';
        }
      });

      // 行程表單提交 (新增或編輯)
      tripForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const tripId = document.getElementById('form-trip-id').value;
        const name = document.getElementById('trip-name').value.trim();
        const emoji = tripSelectedEmojiInput.value;
        const description = document.getElementById('trip-description').value.trim();

        if (!name) return;

        const payload = { name, emoji, description };

        try {
          let savedTrip;
          if (tripId) {
            // 更新
            const { data, error } = await supabase
              .from('trips')
              .update(payload)
              .eq('id', tripId)
              .select()
              .single();
            if (error) throw error;
            savedTrip = data;
            
            // 更新快取
            tripsCache = tripsCache.map(t => String(t.id) === String(tripId) ? savedTrip : t);
            showToast('行程更新成功！');
          } else {
            // 新增
            const { data, error } = await supabase
              .from('trips')
              .insert([payload])
              .select()
              .single();
            if (error) throw error;
            savedTrip = data;
            
            // 更新快取
            tripsCache.push(savedTrip);
            showToast('行程建立成功！');
          }

          closeTripModal();

          // 重新繪製行程滾動條
          let tabsHtml = '';
          tripsCache.forEach(t => {
            tabsHtml += `
              <button class="trip-tab" data-trip-id="${t.id}" data-trip-name="${t.name}" data-trip-desc="${t.description || ''}">
                <span>${t.emoji}</span> ${t.name}
              </button>
            `;
          });
          const listEl = document.getElementById('trips-tab-list');
          if (listEl) listEl.innerHTML = tabsHtml;

          // 選中新建立/更新的行程
          selectTrip(savedTrip.id);
          triggerBuildWebhook();
        } catch (err) {
          alert('行程儲存失敗：' + err.message);
        }
      });

      // ==========================================
      // 8. Modal 互動與控制：景點 (Spots)
      // ==========================================
      const spotModal = document.getElementById('spot-modal');
      const btnOpenSpotModal = document.getElementById('btn-open-spot-modal');
      const btnSpotClose = document.getElementById('btn-spot-modal-close');
      const btnSpotCancel = document.getElementById('btn-spot-cancel');
      const spotForm = document.getElementById('spot-form');
      const spotCategorySelect = document.getElementById('spot-category');
      const spotStatusSelect = document.getElementById('spot-status');
      const spotRatingGroup = document.getElementById('spot-rating-group');
      const spotAddressInput = document.getElementById('spot-address');
      const geoStatusIndicator = document.getElementById('geo-status');
      const spotLatInput = document.getElementById('spot-lat');
      const spotLngInput = document.getElementById('spot-lng');

      // 類型變更連動
      spotCategorySelect?.addEventListener('change', (e) => {
        renderSpotSubcategoryOptions(); // 動態更新子類型選項
      });

      // 狀態變更連動評價顯隱
      spotStatusSelect?.addEventListener('change', (e) => {
        const status = e.target.value;
        if (spotRatingGroup) {
          spotRatingGroup.style.display = status === 'visited' ? 'flex' : 'none';
        }
      });

      // 實作全域新增景點 Modal 控制器，支援帶入經緯度與地址
      openAddSpotModal = (initialData) => {
        if (!currentTripId) {
          alert('請先建立行程！');
          return;
        }
        spotForm.reset();
        document.getElementById('spot-modal-title').textContent = '＋ 新增景點';
        document.getElementById('form-spot-id').value = '';
        document.getElementById('form-spot-place-id').value = '';

        // 清空頁面頂部的搜尋框並清除搜尋標記
        const searchInput = document.getElementById('travel-search-input');
        if (searchInput) searchInput.value = '';
        clearSearchMarkers();

        uploadedImagesCache = [];
        renderSpotImagePreviews();

        // 預設分類
        if (spotTypesCache.length > 0) {
          spotCategorySelect.value = spotTypesCache[0].id;
          renderSpotSubcategoryOptions();
        }

        if (spotRatingGroup) spotRatingGroup.style.display = 'none';

        if (initialData) {
          document.getElementById('spot-name').value = initialData.name || '';
          spotAddressInput.value = initialData.address || '';
          spotLatInput.value = initialData.lat.toString();
          spotLngInput.value = initialData.lng.toString();
          if (initialData.place_id) {
            document.getElementById('form-spot-place-id').value = initialData.place_id;
          }
          
          if (geoStatusIndicator) {
            geoStatusIndicator.style.display = 'flex';
            geoStatusIndicator.className = 'geo-status-indicator success';
            geoStatusIndicator.innerHTML = `🟢 地圖定位成功！(經:${initialData.lng.toFixed(4)}, 緯:${initialData.lat.toFixed(4)})`;
          }
        } else {
          document.getElementById('spot-name').value = '';
          spotAddressInput.value = '';
          spotLatInput.value = '';
          spotLngInput.value = '';
          if (geoStatusIndicator) geoStatusIndicator.style.display = 'none';
        }

        spotModal?.classList.add('show');
        document.body.classList.add('modal-open');
      };

      const btnCancelSpot = document.getElementById('btn-cancel-spot');
      const btnSaveSpot = document.getElementById('btn-save-spot');

      // 開啟新增 Modal
      btnOpenSpotModal?.addEventListener('click', () => {
        openAddSpotModal();
      });

      const closeSpotModal = () => {
        spotModal?.classList.remove('show');
        document.body.classList.remove('modal-open');
      };
      btnSpotClose?.addEventListener('click', closeSpotModal);
      btnCancelSpot?.addEventListener('click', closeSpotModal);

      // ==========================================
      // 9. Geocoding 自動定位地址經緯度
      // ==========================================
      async function performGeocoding(address) {
        if (!address || !geoStatusIndicator || !window.google || !window.google.maps) return;

        geoStatusIndicator.style.display = 'flex';
        geoStatusIndicator.className = 'geo-status-indicator loading';
        geoStatusIndicator.textContent = '🧭 定位經緯度中...';

        try {
          const geocoder = new window.google.maps.Geocoder();
          geocoder.geocode({ address }, (results, status) => {
            if (status === 'OK' && results && results.length > 0) {
              const location = results[0].geometry.location;
              spotLatInput.value = location.lat().toString();
              spotLngInput.value = location.lng().toString();

              geoStatusIndicator.className = 'geo-status-indicator success';
              geoStatusIndicator.innerHTML = `🟢 解析成功！(經:${location.lng().toFixed(4)}, 緯:${location.lat().toFixed(4)})`;
              console.log(`🧭 Geocoding 解析成功: ${location.lat()}, ${location.lng()}`);

              // 地圖平滑移動置中並縮放
              if (googleMap) {
                googleMap.setCenter(location);
                googleMap.setZoom(15);
              }
            } else {
              geoStatusIndicator.className = 'geo-status-indicator error';
              geoStatusIndicator.textContent = '🔴 定位解析失敗，請手動確認地址是否正確。';
              spotLatInput.value = '';
              spotLngInput.value = '';
              console.warn('🧭 Geocoding 失敗：', status);
            }
          });
        } catch (err) {
          geoStatusIndicator.className = 'geo-status-indicator error';
          geoStatusIndicator.textContent = '🔴 定位解析失敗，請手動確認地址是否正確。';
          spotLatInput.value = '';
          spotLngInput.value = '';
          console.warn('🧭 Geocoding 失敗：', err);
        }
      }

      // 地址欄失去焦點時觸發 Geocoding
      spotAddressInput?.addEventListener('blur', () => {
        const address = spotAddressInput.value.trim();
        if (address) {
          performGeocoding(address);
        }
      });

      // ==========================================
      // 10. 照片上傳至 Supabase Storage
      // ==========================================
      const spotImageFileInput = document.getElementById('spot-image-file');
      const spotImagePreviews = document.getElementById('spot-image-previews');

      spotImageFileInput?.addEventListener('change', async (e) => {
        const files = e.target.files;
        if (!files || files.length === 0) return;

        showToast('正在上傳照片...');

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          
          // 限制只允許圖片
          if (!file.type.startsWith('image/')) continue;

          // 命名規範：以 UUID 建立檔名，並放至 bucket 中
          const fileExt = file.name.split('.').pop();
          const fileName = `${crypto.randomUUID()}.${fileExt}`;
          const filePath = `${fileName}`;

          try {
            // 上傳至 Supabase Storage Bucket 'post_images' 或是 'travel_images'
            let targetBucket = 'travel_images';
            
            let { data, error } = await supabase.storage
              .from(targetBucket)
              .upload(filePath, file);

            if (error) {
              // Fallback 到 post_images 如果 travel_images 無法存取
              targetBucket = 'post_images';
              const fallbackUpload = await supabase.storage
                .from(targetBucket)
                .upload(filePath, file);
              if (fallbackUpload.error) throw fallbackUpload.error;
              data = fallbackUpload.data;
            }

            // 取得公開讀取網址
            const { data: { publicUrl } } = supabase.storage
              .from(targetBucket)
              .getPublicUrl(filePath);

            uploadedImagesCache.push(publicUrl);
            showToast('照片上傳成功！');
          } catch (err) {
            alert('圖片上傳失敗：' + err.message);
          }
        }

        // 重繪預覽
        renderSpotImagePreviews();
      });

      function renderSpotImagePreviews() {
        if (!spotImagePreviews) return;

        let html = '';
        uploadedImagesCache.forEach((url, idx) => {
          html += `
            <div class="upload-preview-item">
              <img src="${url}" alt="preview" />
              <button type="button" class="btn-remove-preview" data-idx="${idx}">&times;</button>
            </div>
          `;
        });
        spotImagePreviews.innerHTML = html;

        // 綁定移除照片事件
        spotImagePreviews.querySelectorAll('.btn-remove-preview').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(e.currentTarget.dataset.idx || '0');
            uploadedImagesCache.splice(idx, 1);
            renderSpotImagePreviews();
          });
        });
      }

      // ==========================================
      // 11. 景點編輯載入與表單提交
      // ==========================================
      async function openSpotModal(spotId) {
        const spot = spotsCache.find(s => String(s.id) === String(spotId));
        if (!spot) return;

        spotForm.reset();
        document.getElementById('spot-modal-title').textContent = '✏️ 編輯景點';
        document.getElementById('form-spot-id').value = spot.id;
        document.getElementById('form-spot-place-id').value = spot.place_id || '';

        // 清空頁面頂部的搜尋框
        const searchInput = document.getElementById('travel-search-input');
        if (searchInput) searchInput.value = '';

        if (geoStatusIndicator) geoStatusIndicator.style.display = 'none';

        // 帶入欄位值
        document.getElementById('spot-name').value = spot.name || '';
        spotCategorySelect.value = spot.spot_type_id || (spotTypesCache.length > 0 ? spotTypesCache[0].id : '');
        
        renderSpotSubcategoryOptions();
        const spotSubtypeSelect = document.getElementById('spot-subtype');
        if (spotSubtypeSelect && spot.spot_subtype_id) {
          spotSubtypeSelect.value = spot.spot_subtype_id;
        }
        
        spotAddressInput.value = spot.address || '';
        spotLatInput.value = spot.lat ? spot.lat.toString() : '';
        spotLngInput.value = spot.lng ? spot.lng.toString() : '';

        document.getElementById('spot-hours').value = spot.open_hours || '';
        document.getElementById('spot-price').value = spot.price || '';
        document.getElementById('spot-note').value = spot.note || '';
        
        spotStatusSelect.value = spot.status || 'want';
        
        if (spotRatingGroup) {
          spotRatingGroup.style.display = spot.status === 'visited' ? 'flex' : 'none';
        }
        document.getElementById('spot-rating').value = spot.rating || '';

        // 圖片載入
        uploadedImagesCache = spot.images ? [...spot.images] : [];
        renderSpotImagePreviews();

        spotModal?.classList.add('show');
        document.body.classList.add('modal-open');
      }
      window.openSpotModal = openSpotModal;

      // 攔截原表單的 submit 行為
      spotForm?.addEventListener('submit', (e) => {
        e.preventDefault();
      });

      // 點擊儲存按鈕執行景點儲存邏輯 (新增或編輯)
      btnSaveSpot?.addEventListener('click', async () => {
        const spotId = document.getElementById('form-spot-id').value;
        const placeId = document.getElementById('form-spot-place-id').value || null;
        const nameEl = document.getElementById('spot-name');
        const name = nameEl.value.trim();
        const spotTypeId = spotCategorySelect.value;
        const spotSubtypeSelect = document.getElementById('spot-subtype');
        const spotSubtypeId = (spotSubtypeSelect && spotSubtypeSelect.value) ? spotSubtypeSelect.value : null;
        const address = spotAddressInput.value.trim();
        
        // 手動驗證必填欄位
        if (!name) {
          alert('請填寫景點名稱！');
          nameEl.focus();
          return;
        }
        if (!address) {
          alert('請填寫景點地址！');
          spotAddressInput.focus();
          return;
        }

        // 確保有經緯度
        let lat = parseFloat(spotLatInput.value);
        let lng = parseFloat(spotLngInput.value);

        if (isNaN(lat) || isNaN(lng)) {
          // 如果沒有自動定位，嘗試同步做最後一次 geocoding
          showToast('正在進行最終定位偵測...');
          await performGeocoding(address);
          lat = parseFloat(spotLatInput.value);
          lng = parseFloat(spotLngInput.value);

          if (isNaN(lat) || isNaN(lng)) {
            alert('無法取得經緯度，請確認地址後重新輸入！');
            return;
          }
        }

        const open_hours = document.getElementById('spot-hours').value.trim();
        const price = document.getElementById('spot-price').value.trim();
        const note = document.getElementById('spot-note').value.trim();
        const status = spotStatusSelect.value;
        const rating = status === 'visited' ? document.getElementById('spot-rating').value : null;
        const images = uploadedImagesCache;

        const spotPayload = {
          trip_id: currentTripId,
          name,
          place_id: placeId,
          spot_type_id: spotTypeId,
          spot_subtype_id: spotSubtypeId,
          address,
          lat,
          lng,
          open_hours,
          price,
          note,
          status,
          rating,
          images
        };
        
        console.log('📝 [Save Spot] 準備儲存的景點資料:', spotPayload);
        console.log('📝 [Save Spot] 當前選擇的行程 ID (currentTripId):', currentTripId);

        try {
          if (spotId) {
            // 編輯
            console.log(`📝 [Save Spot] 正在更新景點 ID: ${spotId}`);
            const { data, error } = await supabase
              .from('spots')
              .update(spotPayload)
              .eq('id', spotId)
              .select()
              .single();

            if (error) {
              console.error('❌ [Save Spot] Supabase Update Error:', error);
              throw error;
            }

            console.log('🟢 [Save Spot] 更新成功，回傳資料:', data);
            showToast('景點修改成功！');
            // 更新快取
            spotsCache = spotsCache.map(s => String(s.id) === String(spotId) ? data : s);
          } else {
            // 新增
            console.log('📝 [Save Spot] 正在新增景點...');
            const { data, error } = await supabase
              .from('spots')
              .insert([spotPayload])
              .select()
              .single();

            if (error) {
              console.error('❌ [Save Spot] Supabase Insert Error:', error);
              throw error;
            }

            console.log('🟢 [Save Spot] 新增成功，回傳資料:', data);
            showToast('景點建立成功！');
            // 更新快取
            spotsCache.unshift(data);
          }

          closeSpotModal();
          filterAndRenderSpots();
          triggerBuildWebhook();
        } catch (err) {
          console.error('❌ [Save Spot] 儲存景點發生例外錯誤:', err);
          alert('儲存景點失敗：' + err.message);
        }
      });

      // 點擊背景遮罩關閉行程 Modal
      tripModal?.addEventListener('click', (e) => {
        if (e.target === tripModal) {
          closeTripModal();
        }
      });

      // 點擊背景遮罩關閉景點 Modal
      spotModal?.addEventListener('click', (e) => {
        if (e.target === spotModal) {
          closeSpotModal();
        }
      });

      // ==========================================
      // 12. 景點類型管理 Modal
      // ==========================================
      const typeModal = document.getElementById('type-management-modal');
      const btnManageTypes = document.getElementById('btn-manage-types');
      const btnTypeModalClose = document.getElementById('btn-type-modal-close');
      const typeListContainer = document.getElementById('type-list-container');
      const addTypeForm = document.getElementById('add-type-form');

      const renderTypeManagementList = () => {
        if (!typeListContainer) return;
        
        // 紀錄目前的展開狀態，以便重新渲染後維持
        const openState = new Set();
        typeListContainer.querySelectorAll('.subtypes-container').forEach(container => {
          if (container.style.display === 'block') {
            const li = container.closest('li');
            const toggleBtn = li.querySelector('.btn-toggle-subtypes');
            if (toggleBtn && toggleBtn.dataset.typeId) {
              openState.add(toggleBtn.dataset.typeId);
            }
          }
        });

        let html = '';
        spotTypesCache.forEach(type => {
          const subtypes = spotSubtypesCache.filter(st => st.spot_type_id === type.id);
          const isOpen = openState.has(type.id) || false;
          
          let subtypesHtml = '';
          subtypes.forEach(st => {
            subtypesHtml += `
              <div style="display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; margin-top: 6px; background: #fafafa; border-radius: 6px; border: 1px solid #eee;">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                  <span>${st.emoji}</span>
                  <span>${st.name}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <label style="display: flex; align-items: center; gap: 4px; font-size: 0.75rem; cursor: pointer; color: #666; margin: 0;">
                    <input type="checkbox" class="toggle-subtype-chain" data-id="${st.id}" ${st.is_chain_store ? 'checked' : ''} /> 連鎖店
                  </label>
                  <button class="btn-spot-icon delete btn-delete-subtype" data-id="${st.id}" title="刪除子類型" style="width: 28px; height: 28px; background: #fff5f5; color: #e03131; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                    <i class="ti ti-trash" style="font-size: 1rem;"></i>
                  </button>
                </div>
              </div>
            `;
          });

          // 行內新增子分類的表單
          subtypesHtml += `
            <form class="add-subtype-form" data-type-id="${type.id}" style="display: flex; gap: 8px; margin-top: 8px; align-items: center;">
              <input type="text" class="subtype-emoji-input" placeholder="📍" style="width: 48px; text-align: center; border: 1px solid var(--travel-border); border-radius: 6px;" required />
              <input type="text" class="subtype-name-input" placeholder="新增子類型..." style="flex: 1; border: 1px solid var(--travel-border); border-radius: 6px; padding: 4px 8px;" required />
              <label style="display: flex; align-items: center; gap: 4px; font-size: 0.75rem; cursor: pointer; color: #666; margin: 0; white-space: nowrap;">
                <input type="checkbox" class="subtype-chain-input" /> 連鎖店
              </label>
              <button type="submit" style="background: var(--travel-primary); color: white; border: none; border-radius: 6px; padding: 4px 12px; cursor: pointer; font-size: 0.85rem; white-space: nowrap;">新增</button>
            </form>
          `;

          html += `
            <li style="margin-bottom: 8px; list-style: none;">
              <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px; background: white; border-radius: 8px; border: 1px solid var(--travel-border);">
                <div style="display: flex; align-items: center; gap: 12px; cursor: pointer; flex: 1;" class="btn-toggle-subtypes" data-type-id="${type.id}">
                  <span class="toggle-icon" style="font-size: 0.8rem; color: #999; display: inline-block; width: 16px;">${isOpen ? '▼' : '▶'}</span>
                  <span style="font-size: 1.5rem;">${type.emoji}</span>
                  <span style="font-weight: 500;">${type.name}</span>
                  ${type.is_chain_store ? '<span style="font-size: 0.75rem; color: #888; border: 1px solid #ddd; padding: 0 4px; border-radius: 4px; margin-left: 6px;">連鎖</span>' : ''}
                </div>
                <button class="btn-spot-icon delete btn-delete-type" data-id="${type.id}" title="刪除主類型" style="width: 32px; height: 32px; background: #fff5f5; color: #e03131; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                  <i class="ti ti-trash"></i>
                </button>
              </div>
              <div class="subtypes-container" style="display: ${isOpen ? 'block' : 'none'}; padding-left: 24px; padding-top: 4px; padding-right: 8px; padding-bottom: 8px;">
                ${subtypesHtml}
              </div>
            </li>
          `;
        });
        typeListContainer.innerHTML = html;

        // 綁定主分類展開收合
        typeListContainer.querySelectorAll('.btn-toggle-subtypes').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const container = e.currentTarget.closest('li').querySelector('.subtypes-container');
            const icon = e.currentTarget.querySelector('.toggle-icon');
            if (container.style.display === 'none') {
              container.style.display = 'block';
              icon.textContent = '▼';
            } else {
              container.style.display = 'none';
              icon.textContent = '▶';
            }
          });
        });

        // 綁定刪除類型按鈕
        typeListContainer.querySelectorAll('.btn-delete-type').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = e.currentTarget.dataset.id;
            
            // 檢查是否被景點使用
            const spotsUsingThisType = spotsCache.filter(s => s.spot_type_id === id);
            if (spotsUsingThisType.length > 0) {
              alert(`無法刪除！目前有 ${spotsUsingThisType.length} 個景點正在使用此類型。請先將這些景點改為其他類型。`);
              return;
            }

            if (confirm('確定要刪除這個景點類型嗎？（這將會同時刪除其下的所有子類型）')) {
              try {
                const { error } = await supabase.from('spot_types').delete().eq('id', id);
                if (error) throw error;
                
                spotTypesCache = spotTypesCache.filter(t => t.id !== id);
                spotSubtypesCache = spotSubtypesCache.filter(st => st.spot_type_id !== id);
                renderTypeManagementList();
                renderCategoryFilters();
                renderSpotCategoryOptions();
                showToast('已刪除類型');
              } catch (err) {
                alert('刪除失敗: ' + err.message);
              }
            }
          });
        });

        // 綁定連鎖店 checkbox
        typeListContainer.querySelectorAll('.toggle-subtype-chain').forEach(checkbox => {
          checkbox.addEventListener('change', async (e) => {
            const id = e.currentTarget.dataset.id;
            const isChecked = e.currentTarget.checked;
            try {
              const { error } = await supabase
                .from('spot_subtypes')
                .update({ is_chain_store: isChecked })
                .eq('id', id);
              if (error) throw error;
              
              // 更新快取
              const st = spotSubtypesCache.find(s => s.id === id);
              if (st) st.is_chain_store = isChecked;
              
              filterAndRenderSpots(); // 更新地圖標記
              showToast('已更新連鎖店設定');
            } catch (err) {
              e.currentTarget.checked = !isChecked; // 還原
              alert('更新失敗: ' + err.message);
            }
          });
        });

        // 綁定刪除子類型按鈕
        typeListContainer.querySelectorAll('.btn-delete-subtype').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = e.currentTarget.dataset.id;
            
            const spotsUsingThisSubtype = spotsCache.filter(s => s.spot_subtype_id === id);
            if (spotsUsingThisSubtype.length > 0) {
              alert(`無法刪除！目前有 ${spotsUsingThisSubtype.length} 個景點正在使用此子類型。請先將這些景點改為其他子類型。`);
              return;
            }

            if (confirm('確定要刪除這個子類型嗎？')) {
              try {
                const { error } = await supabase.from('spot_subtypes').delete().eq('id', id);
                if (error) throw error;
                
                spotSubtypesCache = spotSubtypesCache.filter(st => st.id !== id);
                renderTypeManagementList();
                renderSubcategoryFilters();
                renderSpotSubcategoryOptions();
                showToast('已刪除子類型');
              } catch (err) {
                alert('刪除失敗: ' + err.message);
              }
            }
          });
        });

        // 綁定新增子類型表單
        typeListContainer.querySelectorAll('.add-subtype-form').forEach(form => {
          const typeId = form.dataset.typeId; // 用 closure 傳入，避免 e.currentTarget 在 await 後變 null

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            // 在事件內直接用 closure 的 form 參考，不再使用 e.currentTarget 或 DOM 爬樹
            const emoji = form.querySelector('.subtype-emoji-input').value.trim();
            const name = form.querySelector('.subtype-name-input').value.trim();
            const chainInput = form.querySelector('.subtype-chain-input');
            const is_chain_store = chainInput ? chainInput.checked : false;
            
            if (!name || !emoji) return;

            try {
              const { data, error } = await supabase
                .from('spot_subtypes')
                .insert([{ spot_type_id: typeId, name, emoji, is_chain_store }])
                .select()
                .single();

              if (error) throw error;
              
              spotSubtypesCache.push(data);
              
              // 重新渲染 (renderTypeManagementList 內部會自動保存當前 display: block 的展開狀態)
              renderTypeManagementList();
              renderSubcategoryFilters();
              renderSpotSubcategoryOptions();
              showToast('新增子類型成功');
            } catch (err) {
              alert('新增失敗: ' + err.message);
            }
          });
        });
      };

      btnManageTypes?.addEventListener('click', () => {
        renderTypeManagementList();
        typeModal?.classList.add('show');
        document.body.classList.add('modal-open');
      });

      const closeTypeModal = () => {
        typeModal?.classList.remove('show');
        document.body.classList.remove('modal-open');
      };
      
      btnTypeModalClose?.addEventListener('click', closeTypeModal);
      typeModal?.addEventListener('click', (e) => {
        if (e.target === typeModal) closeTypeModal();
      });

      addTypeForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emojiInput = document.getElementById('new-type-emoji');
        const nameInput = document.getElementById('new-type-name');
        const chainInput = document.getElementById('new-type-chain');
        const emoji = emojiInput.value.trim();
        const name = nameInput.value.trim();
        const is_chain_store = chainInput ? chainInput.checked : false;
        
        if (!name || !emoji) return;

        try {
          const { data, error } = await supabase
            .from('spot_types')
            .insert([{ name, emoji, is_chain_store }])
            .select()
            .single();

          if (error) throw error;
          
          spotTypesCache.push(data);
          emojiInput.value = '';
          nameInput.value = '';
          if (chainInput) chainInput.checked = false;
          
          renderTypeManagementList();
          renderCategoryFilters();
          renderSpotCategoryOptions();
          showToast('新增類型成功');
        } catch (err) {
          alert('新增失敗: ' + err.message);
        }
      });

      // ESC 鍵關閉所有 Modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeTripModal();
          closeSpotModal();
          closeLightbox();
          closeTypeModal();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEvents);
    } else {
      initEvents();
    }
  })();
</script>
