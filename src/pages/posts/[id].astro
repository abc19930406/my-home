---
import Layout from '../../layouts/Layout.astro';
import Starfield from '../../components/Starfield.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { supabase } from '../../lib/supabase-client';
import { marked } from 'marked';
import '../../styles/posts.css';

const { id } = Astro.params;

// SSR 一律以 anon key 查詢:RLS 生效後,匿名/無 session 的 SSR 只查得到 public 文章。
// 查不到(不論是真的不存在、或無權限)一律不揭露差異,交由下方渲染成「需要登入」外殼。
const { data: post } = await supabase
  .from('posts')
  .select('*')
  .eq('id', id)
  .single();

const htmlContent = post
  ? await marked.parse((post.content || '').replace(/\n/g, '\n\n'))
  : '';

// 資料庫存的是 post_media 內的路徑，不是網址；SSR 當下換成 1 小時有效的簽名網址供渲染
// RLS 生效後：public 文章的媒體 anon 可讀；非 public 走不到這裡（SSR 已抓不到 post）
// 統一成單一 photos 陣列（不論原本是 image_urls 多張或 image_url 單張），瀑布流與燈箱共用同一份資料
let photos: string[] = [];
if (post) {
  const paths = post.image_urls && post.image_urls.length > 0
    ? post.image_urls
    : (post.image_url ? [post.image_url] : []);
  if (paths.length > 0) {
    const results = await Promise.all(
      paths.map((path: string) => supabase.storage.from('post_media').createSignedUrl(path, 3600))
    );
    photos = results.map((r) => r.data?.signedUrl).filter((u): u is string => !!u);
  }
}

// 媒體項目（YouTube / 短片 / 錄音）：影片類（youtube + clip）依 sort_order 合併一組，錄音另成一組
type VideoItem = { kind: 'youtube'; id: string } | { kind: 'clip'; url: string };
let videoItems: VideoItem[] = [];
let audioItems: string[] = [];
if (post) {
  const { data: mediaItems } = await supabase
    .from('post_media_items')
    .select('*')
    .eq('post_id', post.id)
    .order('sort_order', { ascending: true });

  if (mediaItems && mediaItems.length > 0) {
    const clipPaths = mediaItems.filter((m) => m.kind === 'clip').map((m) => m.value as string);
    const audioPaths = mediaItems.filter((m) => m.kind === 'audio').map((m) => m.value as string);

    const clipSigned = await Promise.all(
      clipPaths.map((p) => supabase.storage.from('post_media').createSignedUrl(p, 3600))
    );
    const clipUrlMap: Record<string, string> = {};
    clipPaths.forEach((p, i) => { clipUrlMap[p] = clipSigned[i].data?.signedUrl || ''; });

    const audioSigned = await Promise.all(
      audioPaths.map((p) => supabase.storage.from('post_media').createSignedUrl(p, 3600))
    );
    const audioUrlMap: Record<string, string> = {};
    audioPaths.forEach((p, i) => { audioUrlMap[p] = audioSigned[i].data?.signedUrl || ''; });

    videoItems = mediaItems
      .filter((m) => m.kind === 'youtube' || m.kind === 'clip')
      .map((m) =>
        m.kind === 'youtube'
          ? ({ kind: 'youtube', id: m.value } as VideoItem)
          : ({ kind: 'clip', url: clipUrlMap[m.value] } as VideoItem)
      )
      .filter((v) => v.kind === 'youtube' || !!v.url);

    audioItems = mediaItems
      .filter((m) => m.kind === 'audio')
      .map((m) => audioUrlMap[m.value])
      .filter((u) => !!u);
  }
}

const visibilityMap = {
  public: { text: '公開', color: 'var(--tag-public)' },
  friends: { text: '朋友', color: 'var(--tag-friends)' },
  private: { text: '私人', color: 'var(--tag-private)' }
};
---

<Layout title={post?.title || '短文'}>
  <div class="bg-layer bg-day"></div>
  <div class="bg-layer bg-night"></div>
  <div class="halo-sun"></div>
  <div class="halo-moon"></div>
  <Starfield />

  <div class="posts-body">
    <div class="notebook-container">
      <div class="notebook-spine"></div>
      <div class="notebook-page">
        <div class="notebook-content">
          <nav class="posts-nav">
            <a href="/posts" class="nav-link">← 返回短文集</a>
          </nav>

          {post ? (
            <article id="post-article">
              <div class="post-detail-header">
                <div class="post-tag" style={`border-color: ${visibilityMap[post.visibility].color}; color: ${visibilityMap[post.visibility].color};`}>
                  {visibilityMap[post.visibility].text}
                </div>
                <h1 class="post-detail-title">{post.title}</h1>
                <div class="post-detail-meta">
                  {post.weather && <span>{post.weather} ・ </span>}
                  <span>{new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
                  <span> ・ 閱讀約 {post.reading_time} 分鐘</span>
                </div>
              </div>

              {photos.length > 0 && (
                <div class="post-waterfall" id="post-waterfall">
                  {photos.map((url: string, index: number) => (
                    <button type="button" class="post-photo" data-index={index} aria-label={`放大檢視第 ${index + 1} 張照片`}>
                      <img src={url} alt={post.title} width="400" height="400" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}

              <div class="post-detail-content" id="post-body">
                <div set:html={htmlContent} />
              </div>

              {videoItems.length > 0 && (
                <div class="post-video-section">
                  {videoItems.map((v) => (
                    v.kind === 'youtube' ? (
                      <div class="post-video-embed">
                        <iframe
                          src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                          title="YouTube 影片"
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                        ></iframe>
                      </div>
                    ) : (
                      <video class="post-video-clip" src={v.url} controls preload="metadata" />
                    )
                  ))}
                </div>
              )}

              {audioItems.length > 0 && (
                <div class="post-audio-section">
                  {audioItems.map((url: string) => (
                    <audio class="post-audio-item" src={url} controls preload="metadata" />
                  ))}
                </div>
              )}
            </article>
          ) : (
            <div id="post-locked" class="post-locked-shell">
              <p class="empty-state">🔒 此文章需要登入檢視</p>
              <a href={`/login?from=/posts/${id}`} id="post-login-link" class="btn-post-login">🔑 登入</a>
              <div id="post-client-container"></div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- 燈箱：常駐於頁面，不論照片是 SSR 渲染或前端動態注入皆共用同一個 -->
    <div id="post-lightbox" class="post-lightbox-overlay">
      <button type="button" id="post-lightbox-close" class="post-lightbox-close" aria-label="關閉">&times;</button>
      <button type="button" id="post-lightbox-prev" class="post-lightbox-arrow post-lightbox-prev" aria-label="上一張">&#10094;</button>
      <img id="post-lightbox-img" class="post-lightbox-img" src="" alt="" />
      <button type="button" id="post-lightbox-next" class="post-lightbox-arrow post-lightbox-next" aria-label="下一張">&#10095;</button>
      <div id="post-lightbox-counter" class="post-lightbox-counter"></div>
    </div>

    <ThemeToggle />
  </div>
</Layout>

<script define:vars={{ id }} is:inline>
  // 1. 處理主題 (防止閃爍)
  const savedTheme = localStorage.getItem('tcr-theme') || 'day';
  document.documentElement.classList.toggle('theme-night', savedTheme === 'night');
  document.body.classList.add('posts-page');
  window.__POST_ID__ = id;
</script>

<script>
  import { getSupabaseBrowserClient } from '../../lib/supabase-browser.js';
  const supabase = getSupabaseBrowserClient();

  // 燈箱：事件委派在 document 上，不論 .post-waterfall 是 SSR 渲染或前端動態注入皆能捕捉點擊
  // 三種關閉路徑（關閉鈕、點遮罩空白處、ESC）皆會清除 body.modal-open
  function initLightbox() {
    const lightbox = document.getElementById('post-lightbox');
    const lightboxImg = document.getElementById('post-lightbox-img');
    const counter = document.getElementById('post-lightbox-counter');
    const closeBtn = document.getElementById('post-lightbox-close');
    const prevBtn = document.getElementById('post-lightbox-prev');
    const nextBtn = document.getElementById('post-lightbox-next');
    if (!lightbox || !lightboxImg) return;

    let photoUrls = [];
    let currentIndex = 0;

    function render() {
      lightboxImg.src = photoUrls[currentIndex];
      lightboxImg.alt = `照片 ${currentIndex + 1} / ${photoUrls.length}`;
      if (counter) counter.textContent = `${currentIndex + 1} / ${photoUrls.length}`;
      lightbox.classList.toggle('single', photoUrls.length <= 1);
    }

    function openLightbox(index) {
      const waterfall = document.getElementById('post-waterfall');
      if (!waterfall) return;
      photoUrls = Array.from(waterfall.querySelectorAll('img')).map((img) => img.src);
      if (photoUrls.length === 0) return;
      currentIndex = index;
      render();
      lightbox.classList.add('show');
      document.body.classList.add('modal-open');
    }

    function closeLightbox() {
      lightbox.classList.remove('show');
      document.body.classList.remove('modal-open');
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + photoUrls.length) % photoUrls.length;
      render();
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % photoUrls.length;
      render();
    }

    document.addEventListener('click', (e) => {
      const photoBtn = e.target.closest('.post-photo');
      if (photoBtn) {
        const index = parseInt(photoBtn.dataset.index || '0');
        openLightbox(index);
      }
    });

    // 關閉路徑 1：關閉鈕
    closeBtn?.addEventListener('click', closeLightbox);

    // 關閉路徑 2：點遮罩空白處（排除點在圖片或按鈕本身）
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // 關閉路徑 3：ESC 鍵；同時支援左右鍵切換
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('show')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // 手機手指滑動切換：水平位移超過門檻且大於垂直位移才視為切換手勢
    let touchStartX = 0;
    let touchStartY = 0;

    lightbox.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      touchStartX = t.clientX;
      touchStartY = t.clientY;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) showNext();
        else showPrev();
      }
    }, { passive: true });
  }

  // 動態載入 marked(CDN,鎖定確切版本,與 npm 端一致),只有需要前端渲染 Markdown 時才載入
  function waitForMarked() {
    return new Promise((resolve) => {
      if (window.__markedParse) return resolve(window.__markedParse);
      const s = document.createElement('script');
      s.type = 'module';
      s.textContent = `
        import { marked } from 'https://cdn.jsdelivr.net/npm/marked@18.0.3/+esm';
        window.__markedParse = marked.parse;
        window.dispatchEvent(new Event('marked-ready'));
      `;
      document.head.appendChild(s);
      window.addEventListener('marked-ready', () => resolve(window.__markedParse), { once: true });
    });
  }

  const postLocked = document.getElementById('post-locked');
  initLightbox();

  if (!postLocked) {
    // SSR 已成功渲染 public 文章,瀑布流已在 HTML 內，燈箱已就緒
  } else {
    // SSR 抓不到(無權限或不存在):登入後以使用者自己的 session 重新查詢,RLS 自動判權
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return; // 保持「需要登入」提示原樣

      const { data: post } = await supabase
        .from('posts')
        .select('*')
        .eq('id', window.__POST_ID__)
        .single();

      const container = document.getElementById('post-client-container');
      const loginLink = document.getElementById('post-login-link');
      const lockedMsg = postLocked.querySelector('.empty-state');

      if (!post) {
        if (lockedMsg) lockedMsg.textContent = '⚠️ 無權限或文章不存在';
        if (loginLink) loginLink.style.display = 'none';
        return;
      }

      const markedParse = await waitForMarked();
      const htmlContent = await markedParse((post.content || '').replace(/\n/g, '\n\n'));

      const visibilityMap = {
        public: { text: '公開', color: 'var(--tag-public)' },
        friends: { text: '朋友', color: 'var(--tag-friends)' },
        private: { text: '私人', color: 'var(--tag-private)' }
      };
      const v = visibilityMap[post.visibility] || visibilityMap.private;

      // 資料庫存的是 post_media 內的路徑，用目前登入者的 session 換簽名網址（RLS 自動判權）
      // 統一成單一路徑陣列，跟 SSR 端一樣一律渲染成瀑布流
      const paths = post.image_urls && post.image_urls.length > 0
        ? post.image_urls
        : (post.image_url ? [post.image_url] : []);
      let imagesHtml = '';
      if (paths.length > 0) {
        const signResults = await Promise.all(
          paths.map((path) => supabase.storage.from('post_media').createSignedUrl(path, 3600))
        );
        const signedUrls = signResults.map((r) => r.data?.signedUrl).filter(Boolean);
        if (signedUrls.length > 0) {
          imagesHtml = '<div class="post-waterfall" id="post-waterfall">' +
            signedUrls.map((url, i) =>
              `<button type="button" class="post-photo" data-index="${i}" aria-label="放大檢視第 ${i + 1} 張照片"><img src="${url}" alt="${post.title}" width="400" height="400" loading="lazy" /></button>`
            ).join('') +
            '</div>';
        }
      }

      // 媒體項目：用目前登入者的 session 換簽名網址（RLS 自動判權），影片類（youtube+clip）一組、錄音一組
      const { data: mediaItems } = await supabase
        .from('post_media_items')
        .select('*')
        .eq('post_id', post.id)
        .order('sort_order', { ascending: true });

      let videoHtml = '';
      let audioHtml = '';
      if (mediaItems && mediaItems.length > 0) {
        const clipPaths = mediaItems.filter((m) => m.kind === 'clip').map((m) => m.value);
        const clipSigned = await Promise.all(
          clipPaths.map((p) => supabase.storage.from('post_media').createSignedUrl(p, 3600))
        );
        const clipUrlMap = {};
        clipPaths.forEach((p, i) => { clipUrlMap[p] = clipSigned[i].data?.signedUrl || ''; });

        const audioPaths = mediaItems.filter((m) => m.kind === 'audio').map((m) => m.value);
        const audioSigned = await Promise.all(
          audioPaths.map((p) => supabase.storage.from('post_media').createSignedUrl(p, 3600))
        );
        const audioUrlMap = {};
        audioPaths.forEach((p, i) => { audioUrlMap[p] = audioSigned[i].data?.signedUrl || ''; });

        const videoParts = mediaItems
          .filter((m) => m.kind === 'youtube' || m.kind === 'clip')
          .map((m) => {
            if (m.kind === 'youtube') {
              return `<div class="post-video-embed"><iframe src="https://www.youtube-nocookie.com/embed/${m.value}" title="YouTube 影片" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>`;
            }
            const url = clipUrlMap[m.value];
            return url ? `<video class="post-video-clip" src="${url}" controls preload="metadata"></video>` : '';
          })
          .filter(Boolean);
        if (videoParts.length > 0) {
          videoHtml = '<div class="post-video-section">' + videoParts.join('') + '</div>';
        }

        const audioParts = mediaItems
          .filter((m) => m.kind === 'audio')
          .map((m) => {
            const url = audioUrlMap[m.value];
            return url ? `<audio class="post-audio-item" src="${url}" controls preload="metadata"></audio>` : '';
          })
          .filter(Boolean);
        if (audioParts.length > 0) {
          audioHtml = '<div class="post-audio-section">' + audioParts.join('') + '</div>';
        }
      }

      if (container) {
        container.innerHTML = `
          <div class="post-detail-header">
            <div class="post-tag" style="border-color: ${v.color}; color: ${v.color};">${v.text}</div>
            <h1 class="post-detail-title">${post.title}</h1>
            <div class="post-detail-meta">
              ${post.weather ? post.weather + ' ・ ' : ''}${new Date(post.created_at).toLocaleDateString('zh-TW')} ・ 閱讀約 ${post.reading_time} 分鐘
            </div>
          </div>
          ${imagesHtml}
          <div class="post-detail-content" id="post-body">${htmlContent}</div>
          ${videoHtml}
          ${audioHtml}
        `;
      }

      if (lockedMsg) lockedMsg.remove();
      if (loginLink) loginLink.style.display = 'none';
      // 燈箱已在頁面載入時透過事件委派就緒，動態注入的 .post-photo 不需要再次初始化
    })();
  }
</script>

<style>

  .nav-page-num {
    color: var(--nb-text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .post-detail-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .post-tag {
    display: inline-block;
    padding: 2px 12px;
    border: 1px solid;
    border-radius: 4px;
    font-size: 0.75rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .post-detail-title {
    color: var(--nb-text-title);
    font-size: 2.2rem;
    margin: 0.5rem 0 1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .post-detail-meta {
    color: var(--nb-text-muted);
    font-size: 0.9rem;
    font-weight: 300;
  }

  .post-detail-content {
    color: var(--nb-text-body);
    font-weight: 300;
    line-height: 2.1;
    font-size: 1.05rem;
    word-break: break-word;
  }

  .post-detail-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-detail-content :global(strong) {
    font-weight: 500;
    color: var(--nb-text-title);
  }

  .post-detail-content :global(em) {
    font-style: italic;
    opacity: 0.9;
  }

  .loading-content {
    text-align: center;
    padding: 2rem;
    color: var(--nb-text-muted);
    font-style: italic;
  }

  .post-locked-shell {
    text-align: center;
    padding: 3rem 1rem;
  }

  .btn-post-login {
    display: inline-block;
    margin-top: 1rem;
    padding: 8px 20px;
    border-radius: 20px;
    background: var(--nb-text-title);
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
  }
</style>
