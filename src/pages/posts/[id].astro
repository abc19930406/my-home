---
import Layout from '../../layouts/Layout.astro';
import Starfield from '../../components/Starfield.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { supabase } from '../../lib/supabase-client';
import { marked } from 'marked';
import '../../styles/posts.css';

export async function getStaticPaths() {
  // Build Time: 抓取所有文章（包含私有，但我們只會靜態渲染公開內容）
  const { data: posts, error } = await supabase
    .from('posts')
    .select('id, created_at')
    .order('created_at', { ascending: true });

  if (error || !posts) return [];

  return posts.map((post, index) => ({
    params: { id: post.id.toString() },
    props: { pageNum: index + 1 }, // 第 N 頁
  }));
}

const { id } = Astro.params;
const { pageNum } = Astro.props;

// Build Time: 嘗試抓取內容 (僅針對 public 文章)
let post = null;
let htmlContent = '';

try {
  const { data, error } = await supabase
    .from('posts')
    .select('*')
    .eq('id', id)
    .single();

  if (!error && data) {
    if (data.visibility === 'public') {
      post = data;
      htmlContent = await marked.parse(data.content || '');
    } else {
      // 非公開文章，僅保留 meta 資料，內容留空等客戶端抓取
      post = { ...data, content: '' }; 
    }
  }
} catch (err) {
  console.warn('⚠️ Build Warning: 單篇短文 Supabase 連線失敗。');
}

const visibilityMap = {
  public: { text: '公開', color: 'var(--tag-public)' },
  friends: { text: '朋友', color: 'var(--tag-friends)' },
  private: { text: '私人', color: 'var(--tag-private)' }
};
---

<Layout title={post?.title || '載入中...'}>
  <div class="bg-layer bg-day"></div>
  <div class="bg-layer bg-night"></div>
  <div class="halo-sun"></div>
  <div class="halo-moon"></div>
  <Starfield />

  <div class="posts-body">
    <div class="notebook-container">
      <div class="notebook-spine"></div>
      <div class="notebook-page">
        <div class="notebook-content">
          <nav class="posts-nav">
            <a href="/posts" class="nav-link">← 返回短文集</a>
            <span class="nav-page-num">第 {pageNum} 頁</span>
          </nav>

          <article id="post-article">
            {post ? (
              <>
                <div class="post-detail-header">
                  <div class="post-tag" style={`border-color: ${visibilityMap[post.visibility].color}; color: ${visibilityMap[post.visibility].color};`}>
                    {visibilityMap[post.visibility].text}
                  </div>
                  <h1 class="post-detail-title">{post.title}</h1>
                  <div class="post-detail-meta">
                    {post.weather && <span>{post.weather} ・ </span>}
                    <span>{new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
                    <span> ・ 閱讀約 {post.reading_time} 分鐘</span>
                  </div>
                </div>

                {post.image_url && (
                  <div class="post-image-container">
                    <img src={post.image_url} alt={post.title} class="post-main-image" />
                  </div>
                )}

                <div class="post-detail-content" id="post-body">
                  {post.visibility === 'public' ? (
                    <div set:html={htmlContent} />
                  ) : (
                    <div class="loading-content">
                      <p>🔒 此內容僅限權限使用者查看，正在驗證身分...</p>
                    </div>
                  )}
                </div>
              </>
            ) : (
              <p class="empty-state">找不到這篇文章</p>
            )}
          </article>
        </div>
      </div>
    </div>

    <ThemeToggle />
  </div>
</Layout>

<script is:inline define:vars={{ postId: id, initialVisibility: post?.visibility }}>
  // 1. 處理主題 (防止閃爍)
  const savedTheme = localStorage.getItem('tcr-theme') || 'day';
  document.documentElement.classList.toggle('theme-night', savedTheme === 'night');
  document.body.classList.add('posts-page');
</script>

<script>
  import { supabase } from '../../lib/supabase-client';
  import { marked } from 'marked';

  const postId = window.location.pathname.split('/').pop();
  const postBody = document.getElementById('post-body');

  async function checkAndFetchContent() {
    // 如果是 public 文章且已有內容，就不需要再次抓取
    if (postBody && !postBody.querySelector('.loading-content')) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      if (postBody) postBody.innerHTML = '<p class="empty-state">🔒 請先登入管理員帳號以查看此文章</p>';
      return;
    }

    const { data, error } = await supabase
      .from('posts')
      .select('content')
      .eq('id', postId)
      .single();

    if (!error && data && postBody) {
      const html = await marked.parse(data.content);
      postBody.innerHTML = `<div>${html}</div>`;
    } else if (error) {
      if (postBody) postBody.innerHTML = '<p class="empty-state">權限不足或載入失敗</p>';
    }
  }

  checkAndFetchContent();
</script>

<style>

  .nav-page-num {
    color: var(--nb-text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .post-detail-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .post-tag {
    display: inline-block;
    padding: 2px 12px;
    border: 1px solid;
    border-radius: 4px;
    font-size: 0.75rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .post-detail-title {
    color: var(--nb-text-title);
    font-size: 2.2rem;
    margin: 0.5rem 0 1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .post-detail-meta {
    color: var(--nb-text-muted);
    font-size: 0.9rem;
    font-weight: 300;
  }

  .post-image-container {
    margin: 2rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .post-main-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-detail-content {
    color: var(--nb-text-body);
    font-weight: 300;
    line-height: 2.1;
    font-size: 1.05rem;
    word-break: break-word;
  }

  .post-detail-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-detail-content :global(strong) {
    font-weight: 500;
    color: var(--nb-text-title);
  }

  .post-detail-content :global(em) {
    font-style: italic;
    opacity: 0.9;
  }

  .loading-content {
    text-align: center;
    padding: 2rem;
    color: var(--nb-text-muted);
    font-style: italic;
  }
</style>
