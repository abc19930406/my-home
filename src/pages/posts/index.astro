---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Starfield from '../../components/Starfield.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { supabase } from '../../lib/supabase-client';
import '../../styles/posts.css';

// 1. Build Time: 抓取 public 文章
let publicPosts = [];
try {
  const { data, error } = await supabase
    .from('posts')
    .select('*')
    .eq('visibility', 'public')
    .order('created_at', { ascending: false });
    
  if (!error && data) {
    // 封面縮圖：資料庫存的是 post_media 路徑，取第一張換成簽名網址；photoCount 供徽章顯示張數
    publicPosts = await Promise.all(
      data.map(async (post) => {
        const paths = post.image_urls && post.image_urls.length > 0
          ? post.image_urls
          : (post.image_url ? [post.image_url] : []);
        let coverUrl = null;
        if (paths.length > 0) {
          const { data: signedData } = await supabase.storage.from('post_media').createSignedUrl(paths[0], 3600);
          coverUrl = signedData?.signedUrl || null;
        }
        return { ...post, coverUrl, photoCount: paths.length };
      })
    );
  }
} catch (err) {
  console.warn('⚠️ Build Warning: 短文列表 Supabase 連線失敗，將顯示空列表。');
}

---

<Layout title="短文列表 | The Corner Table">
  <div class="top-right-auth-container">
    <div id="top-auth-guest" style="display: none;">
      <a href="/login?from=/posts" class="btn-top-auth">🔑 登入</a>
    </div>
    <div id="top-auth-user" style="display: none;">
      <button id="btn-top-logout" class="btn-top-auth">登出</button>
    </div>
  </div>
  <div class="bg-layer bg-day"></div>
  <div class="bg-layer bg-night"></div>
  <div class="halo-sun"></div>
  <style is:global>
  html, body { background-color: transparent !important; }
</style>
<div class="halo-moon"></div>
  <Starfield />

  <div class="notebook-container">
    <div class="notebook-spine"></div>
    <div class="notebook-page">
        <div class="notebook-content">
          <nav class="posts-nav">
            <a href="/" class="nav-link">← 返回首頁</a>
          </nav>

          <h1 class="page-title">日嚐</h1>

          <!-- 管理員操作：新增短文按鈕 + 管理分類 + 搜尋 -->
          <div class="admin-header-actions admin-only" style="display: none;">
            <button id="open-add-form" class="btn-add-post">
              <span>＋ 新增短文</span>
            </button>
            <button id="open-category-modal" class="btn-manage-category">🏷️ 管理分類</button>
          </div>

          <div class="posts-search-bar admin-only" style="display: none;">
            <input type="text" id="posts-search-input" placeholder="🔍 搜尋標題／內文／分類／標籤..." />
            <button type="button" id="posts-search-clear" class="btn-search-clear" style="display: none;">清除篩選</button>
          </div>

          <!-- 管理員操作：新增短文表單 -->
          <div id="add-post-section" class="add-post-section" style="display: none;">
            <div class="admin-form-card">
              <form id="post-form">
                <input type="hidden" id="post-id" />
                <div class="form-row">
                  <div class="form-group">
                    <label>標題</label>
                    <input type="text" id="post-title" required placeholder="標題..." />
                  </div>
                  <div class="form-group">
                    <label>天氣與地點</label>
                    <input type="text" id="post-weather" placeholder="晴・台南" />
                  </div>
                </div>
                <div class="form-group">
                  <label>正文 (Markdown)</label>
                  <textarea id="post-content" rows="8" required placeholder="寫點什麼..."></textarea>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>分類</label>
                    <select id="post-category">
                      <option value="">（無分類）</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>發文時間</label>
                    <input type="datetime-local" id="post-created-at" />
                  </div>
                </div>
                <div class="form-group">
                  <label>標籤（輸入後按 Enter 新增，可自建或選既有）</label>
                  <input type="text" id="post-tags-input" list="post-tags-datalist" placeholder="輸入標籤名稱..." />
                  <datalist id="post-tags-datalist"></datalist>
                  <div id="post-tags-chips" class="post-tags-chips"></div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>權限</label>
                    <select id="post-visibility">
                      <option value="public">公開</option>
                      <option value="friends">朋友</option>
                      <option value="private">私人</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>照片 (選填，支援多張)</label>
                    <input type="file" id="post-image" accept="image/*" multiple />
                    <input type="hidden" id="post-image-urls" />
                  </div>
                </div>
                <div id="image-previews-container" class="image-previews-grid" style="display: none; margin-bottom: 1rem;">
                  <!-- JS 動態插入預覽圖 -->
                </div>
                <div class="form-group">
                  <label>媒體（YouTube 影片 / 短片 / 錄音，選填）</label>
                  <div class="media-add-row">
                    <input type="text" id="media-youtube-url" placeholder="貼上 YouTube 網址" />
                    <button type="button" id="btn-add-youtube" class="btn-add-media">＋ YouTube</button>
                  </div>
                  <div class="media-add-row">
                    <label for="media-clip-input" class="btn-add-media btn-file-label">＋ 短片（50MB 內）</label>
                    <input type="file" id="media-clip-input" accept="video/*" style="display: none;" />
                  </div>
                  <div class="media-add-row">
                    <label for="media-audio-input" class="btn-add-media btn-file-label">＋ 錄音</label>
                    <input type="file" id="media-audio-input" accept="audio/*,.m4a,.caf,.aac,.mp3,.wav" style="display: none;" />
                  </div>
                </div>
                <div id="media-list-container" class="media-list" style="display: none;">
                  <!-- JS 動態插入已加入的媒體項目 -->
                </div>
                <div class="form-actions">
                  <button type="button" id="close-add-form" class="btn-cancel">取消</button>
                  <button type="submit" id="save-post-btn" class="btn-submit">發布文章</button>
                </div>
              </form>
            </div>
          </div>

          <div id="posts-container" class="post-list">
            {publicPosts.map((post) => (
              <div class="post-item" data-id={post.id}>
                {post.coverUrl && (
                  <div class="post-cover">
                    <img src={post.coverUrl} alt={post.title} width="400" height="300" loading="lazy" />
                    {post.photoCount > 1 && <span class="post-cover-badge">{post.photoCount} 張</span>}
                  </div>
                )}
                <div class="post-header">
                  <div class={`visibility-dot dot-${post.visibility}`} title="公開"></div>
                  <a href={`/posts/${post.id}`} class="post-title-link">{post.title}</a>
                </div>
                <div class="post-meta">
                  {post.weather && <span>{post.weather} ・ </span>}
                  <span>{new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
                  <span> ・ 閱讀約 {post.reading_time} 分鐘</span>
                </div>
                <p class="post-preview">{post.content.replace(/[*_#\[\]()]/g, '').substring(0, 80)}...</p>
                
                <!-- 管理員操作：編輯/刪除按鈕 -->
                <div class="post-item-actions admin-only" style="display: none;">
                  <button class="btn-inline-edit" data-post={JSON.stringify(post)}>編輯</button>
                  <button class="btn-inline-delete" data-id={post.id}>刪除</button>
                </div>
              </div>
            ))}
            
            {publicPosts.length === 0 && <p class="empty-state" id="empty-msg">尚無公開短文</p>}
          </div>


        </div>
      </div>
    </div>

    <!-- 管理員操作：分類管理 Modal（刻意放在 .notebook-container 外——該容器內層有 backdrop-filter，
         會讓子孫的 position:fixed 改成相對該容器定位而非相對視窗，Modal 會跑位） -->
    <div id="post-category-modal" class="post-modal-overlay" style="display: none;">
      <div class="post-modal-box">
        <div class="post-modal-header">
          <h3>管理分類</h3>
          <button id="btn-post-category-close" class="post-modal-close" aria-label="關閉">&times;</button>
        </div>
        <div class="post-modal-body">
          <form id="post-category-form" class="post-category-form">
            <input type="hidden" id="post-category-id" />
            <input type="text" id="post-category-name" required placeholder="分類名稱" />
            <button type="button" id="btn-post-category-cancel-edit" class="btn-cancel" style="display: none;">取消編輯</button>
            <button type="submit" id="btn-post-category-submit" class="btn-submit">新增分類</button>
          </form>
          <div id="post-categories-list" class="post-categories-list"></div>
        </div>
      </div>
    </div>

    <ThemeToggle />
    <div id="toast" class="toast"></div>
  </Layout>

<script>
  import { getSupabaseBrowserClient } from '../../lib/supabase-browser.js';
  const supabase = getSupabaseBrowserClient();

  // 觸發重新部署:改經後端 API 驗證管理員身分,hook 網址不再暴露於前端
  async function triggerDeploy() {
    try {
      const { data: { session: s } } = await supabase.auth.getSession();
      if (!s) return;
      await fetch('/api/trigger-deploy', {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + s.access_token },
      });
    } catch (err) {
      console.warn('無法觸發重新部署：', err);
    }
  }

  const toast = document.getElementById('toast');

  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.setAttribute('style', [
      'display: block',
      'position: fixed',
      'bottom: 20px',
      'left: 50%',
      'transform: translateX(-50%)',
      'background: rgba(0,0,0,0.8)',
      'color: #fff',
      'padding: 8px 16px',
      'border-radius: 20px',
      'z-index: 1000'
    ].join('; '));
    setTimeout(() => { if (toast) toast.style.display = 'none'; }, 3000);
  }

  // 1. 處理主題初始化
  const savedTheme = localStorage.getItem('tcr-theme') || 'day';
  document.documentElement.classList.toggle('theme-night', savedTheme === 'night');
  document.body.classList.add('posts-page');

  // --- 共用 Modal 機制：按鈕／背景／ESC 三條關閉路徑收斂到同一個函式 ---
  let currentOpenModal: HTMLElement | null = null;
  let currentModalOnClose: (() => void) | null = null;

  function openModal(modalEl: HTMLElement, onClose?: () => void) {
    modalEl.style.display = 'flex';
    document.body.classList.add('modal-open');
    currentOpenModal = modalEl;
    currentModalOnClose = onClose || null;
  }

  function closeCurrentModal() {
    if (!currentOpenModal) return;
    currentOpenModal.style.display = 'none';
    document.body.classList.remove('modal-open');
    const cb = currentModalOnClose;
    currentOpenModal = null;
    currentModalOnClose = null;
    if (cb) cb();
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentOpenModal) closeCurrentModal();
  });

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // --- 分類／標籤／文章 記憶體 cache（管理員登入後載入，供表單下拉、卡片徽章、搜尋使用）---
  let categoriesCache: any[] = [];
  let tagsCache: any[] = [];
  let tagMapByPostId: Map<string, string[]> = new Map(); // post_id -> tag_id[]
  let postsCache: any[] = [];
  let pendingTagIds: string[] = []; // 目前表單裡的標籤（chip）id 清單

  // 2. 權限檢查：如果是管理員，顯示管理功能
  const topAuthGuest = document.getElementById('top-auth-guest');
  const topAuthUser = document.getElementById('top-auth-user');
  
  document.getElementById('btn-top-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  async function checkAdmin() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      document.querySelectorAll('.admin-only').forEach(el => {
        (el as HTMLElement).style.display = 'flex';
      });
      if (topAuthGuest) topAuthGuest.style.display = 'none';
      if (topAuthUser) topAuthUser.style.display = 'block';
      return true;
    }
    if (topAuthGuest) topAuthGuest.style.display = 'block';
    if (topAuthUser) topAuthUser.style.display = 'none';
    return false;
  }

  // 3. 處理表單邏輯
  const openAddFormBtn = document.getElementById('open-add-form');
  const closeAddFormBtn = document.getElementById('close-add-form');
  const addPostSection = document.getElementById('add-post-section');
  const postForm = document.getElementById('post-form') as HTMLFormElement;
  const savePostBtn = document.getElementById('save-post-btn');
  const imagePreviewContainer = document.getElementById('image-previews-container');
  const postImageInput = document.getElementById('post-image') as HTMLInputElement;

  openAddFormBtn?.addEventListener('click', () => {
    if (addPostSection) addPostSection.style.display = 'block';
    openAddFormBtn.style.display = 'none';
    // 新增文章預設帶入「現在」的發文時間；若是從編輯狀態意外觸發（post-id 有值）則不覆蓋
    const idInput = document.getElementById('post-id') as HTMLInputElement;
    const createdAtInput = document.getElementById('post-created-at') as HTMLInputElement;
    if (!idInput.value && createdAtInput && !createdAtInput.value) {
      createdAtInput.value = toDatetimeLocalValue(new Date());
    }
  });

  closeAddFormBtn?.addEventListener('click', () => {
    resetForm();
  });

  function toDatetimeLocalValue(date: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  }

  function resetForm() {
    if (addPostSection) addPostSection.style.display = 'none';
    if (openAddFormBtn) openAddFormBtn.style.display = 'flex';
    postForm.reset();
    (document.getElementById('post-id') as HTMLInputElement).value = '';
    (document.getElementById('post-created-at') as HTMLInputElement).value = toDatetimeLocalValue(new Date());
    currentImageUrls = [];
    currentImagePaths = [];
    renderPreviews();
    pendingMediaItems = [];
    deletedMediaIds = [];
    renderMediaList();
    pendingTagIds = [];
    renderTagChips();
    if (savePostBtn) {
      savePostBtn.textContent = '發布文章';
      (savePostBtn as HTMLButtonElement).disabled = false;
    }
  }

  // currentImagePaths：存進資料庫的實際值（post_media 內的路徑，非網址）
  // currentImageUrls：僅供畫面預覽用的簽名網址（1 小時後失效，不落地儲存）
  let currentImageUrls: string[] = [];
  let currentImagePaths: string[] = [];

  // 輔助函數：由儲存路徑陣列算出封面簽名網址與張數，供列表卡片使用
  async function getCoverInfo(paths: string[]) {
    if (!paths || paths.length === 0) return { coverUrl: null, photoCount: 0 };
    const { data } = await supabase.storage.from('post_media').createSignedUrl(paths[0], 3600);
    return { coverUrl: data?.signedUrl || null, photoCount: paths.length };
  }

  // ============================================================
  // 分類（post_categories）管理
  // ============================================================
  let editingCategoryId: string | null = null;

  function populateCategorySelect() {
    const sel = document.getElementById('post-category') as HTMLSelectElement | null;
    if (!sel) return;
    const current = sel.value;
    sel.innerHTML = '<option value="">（無分類）</option>' +
      categoriesCache.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
    sel.value = current;
  }

  function populateTagsDatalist() {
    const dl = document.getElementById('post-tags-datalist');
    if (!dl) return;
    dl.innerHTML = tagsCache.map((t) => `<option value="${escapeHtml(t.name)}"></option>`).join('');
  }

  async function loadCategories() {
    const { data, error } = await supabase.from('post_categories').select('*').order('sort_order', { ascending: true });
    if (error) { console.warn('loadCategories failed:', error); return; }
    categoriesCache = data || [];
    populateCategorySelect();
    renderCategoriesList();
  }

  async function loadTags() {
    const { data, error } = await supabase.from('post_tags').select('*').order('name', { ascending: true });
    if (error) { console.warn('loadTags failed:', error); return; }
    tagsCache = data || [];
    populateTagsDatalist();
  }

  async function loadTagMap() {
    const { data, error } = await supabase.from('post_tag_map').select('*');
    if (error) { console.warn('loadTagMap failed:', error); return; }
    tagMapByPostId = new Map();
    for (const row of data || []) {
      // posts.id 是 bigint，Supabase 回傳是 number；統一轉成 string 當 Map key，
      // 避免跟 HTML input（.value 永遠是 string）比對時因型別不同而永遠查不到
      const key = String(row.post_id);
      const list = tagMapByPostId.get(key) || [];
      list.push(row.tag_id);
      tagMapByPostId.set(key, list);
    }
  }

  function resetCategoryForm() {
    editingCategoryId = null;
    (document.getElementById('post-category-form') as HTMLFormElement)?.reset();
    const submitBtn = document.getElementById('btn-post-category-submit');
    if (submitBtn) submitBtn.textContent = '新增分類';
    const cancelBtn = document.getElementById('btn-post-category-cancel-edit');
    if (cancelBtn) cancelBtn.style.display = 'none';
  }

  function renderCategoriesList() {
    const listEl = document.getElementById('post-categories-list');
    if (!listEl) return;
    listEl.innerHTML = categoriesCache.map((c, idx) => `
      <div class="post-category-row" data-id="${c.id}">
        <span class="post-category-row-name">${escapeHtml(c.name)}</span>
        <div class="post-category-row-actions">
          <button class="btn-post-category-up" data-id="${c.id}" ${idx === 0 ? 'disabled' : ''}>↑</button>
          <button class="btn-post-category-down" data-id="${c.id}" ${idx === categoriesCache.length - 1 ? 'disabled' : ''}>↓</button>
          <button class="btn-post-category-edit" data-id="${c.id}">編輯</button>
          <button class="btn-post-category-delete" data-id="${c.id}">刪除</button>
        </div>
      </div>
    `).join('');
  }

  document.getElementById('btn-post-category-cancel-edit')?.addEventListener('click', resetCategoryForm);

  document.getElementById('post-category-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('post-category-name') as HTMLInputElement).value.trim();
    if (!name) return;

    if (editingCategoryId) {
      const { data, error } = await supabase.from('post_categories').update({ name }).eq('id', editingCategoryId).select();
      if (error) { alert('更新失敗：' + error.message); return; }
      if (!data || data.length === 0) { alert('沒有任何資料被更新，可能已被刪除或沒有權限。'); return; }
    } else {
      const maxOrder = categoriesCache.reduce((max, c) => Math.max(max, c.sort_order || 0), 0);
      const { data, error } = await supabase.from('post_categories').insert({ name, sort_order: maxOrder + 1 }).select();
      if (error) { alert('新增失敗：' + error.message); return; }
      if (!data || data.length === 0) { alert('新增失敗，沒有取得新資料。'); return; }
    }
    resetCategoryForm();
    await loadCategories();
    // 分類名稱可能已顯示在文章卡片徽章上，一併重繪保持同步
    await refreshPostsList();
  });

  document.getElementById('post-categories-list')?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const editBtn = target.closest('.btn-post-category-edit') as HTMLElement | null;
    const deleteBtn = target.closest('.btn-post-category-delete') as HTMLElement | null;
    const upBtn = target.closest('.btn-post-category-up') as HTMLElement | null;
    const downBtn = target.closest('.btn-post-category-down') as HTMLElement | null;

    if (editBtn) {
      const id = editBtn.dataset.id;
      const row = categoriesCache.find((c) => c.id === id);
      if (!row) return;
      editingCategoryId = row.id;
      (document.getElementById('post-category-name') as HTMLInputElement).value = row.name;
      const submitBtn = document.getElementById('btn-post-category-submit');
      if (submitBtn) submitBtn.textContent = '儲存修改';
      const cancelBtn = document.getElementById('btn-post-category-cancel-edit');
      if (cancelBtn) cancelBtn.style.display = 'inline-block';
      return;
    }

    if (deleteBtn) {
      const id = deleteBtn.dataset.id;
      const row = categoriesCache.find((c) => c.id === id);
      if (!row || !id) return;
      const ok = confirm(`刪除分類「${row.name}」後，此分類下的文章將變為無分類，不會被刪除。確定要刪除嗎？`);
      if (!ok) return;
      const { data, error } = await supabase.from('post_categories').delete().eq('id', id).select();
      if (error) { alert('刪除失敗：' + error.message); return; }
      if (!data || data.length === 0) { alert('沒有任何資料被刪除，可能已被刪除或沒有權限。'); return; }
      if (editingCategoryId === id) resetCategoryForm();
      await loadCategories();
      // 該分類下的文章 category_id 已被資料庫的 ON DELETE SET NULL 改掉，重繪讓徽章跟著消失
      await refreshPostsList();
      return;
    }

    if (upBtn || downBtn) {
      const id = (upBtn || downBtn)!.dataset.id;
      const idx = categoriesCache.findIndex((c) => c.id === id);
      if (idx === -1) return;
      const swapIdx = upBtn ? idx - 1 : idx + 1;
      if (swapIdx < 0 || swapIdx >= categoriesCache.length) return;
      const a = categoriesCache[idx];
      const b = categoriesCache[swapIdx];
      const [resA, resB] = await Promise.all([
        supabase.from('post_categories').update({ sort_order: b.sort_order }).eq('id', a.id).select(),
        supabase.from('post_categories').update({ sort_order: a.sort_order }).eq('id', b.id).select(),
      ]);
      if (resA.error || resB.error) { alert('排序更新失敗：' + (resA.error?.message || resB.error?.message)); return; }
      if (!resA.data?.length || !resB.data?.length) {
        alert('排序沒有完整更新，可能其中一筆已被刪除或沒有權限，將重新載入清單確認現況。');
      }
      await loadCategories();
    }
  });

  const categoryModal = document.getElementById('post-category-modal');
  document.getElementById('open-category-modal')?.addEventListener('click', () => {
    if (categoryModal) openModal(categoryModal, resetCategoryForm);
  });
  document.getElementById('btn-post-category-close')?.addEventListener('click', closeCurrentModal);
  categoryModal?.addEventListener('click', (e) => {
    if (e.target === categoryModal) closeCurrentModal();
  });

  // ============================================================
  // 標籤（post_tags）chip 輸入
  // ============================================================
  function renderTagChips() {
    const container = document.getElementById('post-tags-chips');
    if (!container) return;
    container.innerHTML = pendingTagIds.map((tagId) => {
      const tag = tagsCache.find((t) => t.id === tagId);
      const name = tag ? tag.name : '（未知標籤）';
      return `<span class="post-tag-chip" data-tag-id="${tagId}">${escapeHtml(name)}<button type="button" class="post-tag-chip-remove" data-tag-id="${tagId}">&times;</button></span>`;
    }).join('');
  }

  document.getElementById('post-tags-chips')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.post-tag-chip-remove') as HTMLElement | null;
    if (!btn) return;
    const tagId = btn.dataset.tagId;
    pendingTagIds = pendingTagIds.filter((id) => id !== tagId);
    renderTagChips();
  });

  async function addTagByName(rawName: string) {
    const name = rawName.trim();
    if (!name) return;
    // 大小寫不敏感比對既有標籤，避免建立近似重複的標籤
    let tag = tagsCache.find((t) => t.name.toLowerCase() === name.toLowerCase());
    if (!tag) {
      const { data, error } = await supabase.from('post_tags').insert({ name }).select().single();
      if (error) {
        // 併發情況下可能剛好被其他請求建立，退而查詢既有的
        const { data: existing } = await supabase.from('post_tags').select('*').ilike('name', name).maybeSingle();
        if (!existing) { alert('新增標籤失敗：' + error.message); return; }
        tag = existing;
        tagsCache.push(tag);
      } else {
        tag = data;
        tagsCache.push(tag);
      }
      populateTagsDatalist();
    }
    if (!pendingTagIds.includes(tag.id)) {
      pendingTagIds.push(tag.id);
      renderTagChips();
    }
  }

  document.getElementById('post-tags-input')?.addEventListener('keydown', async (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const input = e.target as HTMLInputElement;
    await addTagByName(input.value);
    input.value = '';
  });

  // 比對編輯前後的標籤 id 清單，刪除被移除的關聯、新增新加入的關聯；新文章（beforeIds 為空陣列）則全部新增
  async function syncPostTags(postIdRaw: string | number, beforeIds: string[]) {
    // postsCache/DB 回傳的 post.id 是 number（bigint），表單 hidden input 讀出來是 string；
    // 統一轉成 string 再操作，避免與 tagMapByPostId 的 string key 型別不一致而誤判成「沒有變化」
    const postId = String(postIdRaw);
    const afterIds = pendingTagIds;
    const toRemove = beforeIds.filter((id) => !afterIds.includes(id));
    const toAdd = afterIds.filter((id) => !beforeIds.includes(id));

    for (const tagId of toRemove) {
      await supabase.from('post_tag_map').delete().eq('post_id', postId).eq('tag_id', tagId);
    }
    if (toAdd.length > 0) {
      const { error } = await supabase
        .from('post_tag_map')
        .insert(toAdd.map((tagId) => ({ post_id: postId, tag_id: tagId })));
      if (error) alert('部分標籤關聯儲存失敗：' + error.message);
    }
    tagMapByPostId.set(postId, [...afterIds]);
  }

  // --- 媒體區塊（YouTube / 短片 / 錄音） ---
  // dbId 有值代表這筆已存在資料庫（編輯既有文章時載入），儲存時用來判斷 UPDATE 還是 INSERT
  let pendingMediaItems: any[] = [];
  let deletedMediaIds: string[] = [];
  const MAX_CLIP_SIZE = 50 * 1024 * 1024; // 50MB

  const mediaListContainer = document.getElementById('media-list-container');
  const mediaYoutubeUrlInput = document.getElementById('media-youtube-url') as HTMLInputElement;
  const btnAddYoutube = document.getElementById('btn-add-youtube');
  const mediaClipInput = document.getElementById('media-clip-input') as HTMLInputElement;
  const mediaAudioInput = document.getElementById('media-audio-input') as HTMLInputElement;

  const mediaKindLabel: Record<string, string> = { youtube: 'YouTube', clip: '短片', audio: '錄音' };

  function renderMediaList() {
    if (!mediaListContainer) return;
    if (pendingMediaItems.length === 0) {
      mediaListContainer.style.display = 'none';
      mediaListContainer.innerHTML = '';
      return;
    }
    mediaListContainer.style.display = 'flex';
    mediaListContainer.innerHTML = pendingMediaItems.map((item, index) => `
      <div class="media-list-item" data-index="${index}">
        <span class="media-kind-tag">${mediaKindLabel[item.kind]}</span>
        <span class="media-label">${item.label}</span>
        <button type="button" class="btn-media-up" data-index="${index}" title="上移" ${index === 0 ? 'disabled' : ''}>↑</button>
        <button type="button" class="btn-media-down" data-index="${index}" title="下移" ${index === pendingMediaItems.length - 1 ? 'disabled' : ''}>↓</button>
        <button type="button" class="btn-media-remove" data-index="${index}" title="移除">×</button>
      </div>
    `).join('');

    mediaListContainer.querySelectorAll('.btn-media-remove').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
        const removed = pendingMediaItems.splice(index, 1)[0];
        if (removed?.dbId) deletedMediaIds.push(removed.dbId);
        renderMediaList();
      });
    });
    mediaListContainer.querySelectorAll('.btn-media-up').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
        if (index <= 0) return;
        const tmp = pendingMediaItems[index - 1];
        pendingMediaItems[index - 1] = pendingMediaItems[index];
        pendingMediaItems[index] = tmp;
        renderMediaList();
      });
    });
    mediaListContainer.querySelectorAll('.btn-media-down').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
        if (index >= pendingMediaItems.length - 1) return;
        const tmp = pendingMediaItems[index + 1];
        pendingMediaItems[index + 1] = pendingMediaItems[index];
        pendingMediaItems[index] = tmp;
        renderMediaList();
      });
    });
  }

  function parseYouTubeId(url: string) {
    const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return match ? match[1] : null;
  }

  btnAddYoutube?.addEventListener('click', () => {
    const url = mediaYoutubeUrlInput.value.trim();
    if (!url) return;
    const videoId = parseYouTubeId(url);
    if (!videoId) {
      alert('YouTube 網址格式不正確，請確認貼上的是完整的影片網址');
      return;
    }
    pendingMediaItems.push({ kind: 'youtube', value: videoId, label: `YouTube：${videoId}` });
    mediaYoutubeUrlInput.value = '';
    renderMediaList();
  });

  async function uploadMediaFile(file: File, kind: 'clip' | 'audio', label: string) {
    const existingId = (document.getElementById('post-id') as HTMLInputElement).value;
    const folder = existingId || 'pending';
    const fileName = `${Math.random().toString(36).substring(2)}.${file.name.split('.').pop()}`;
    const filePath = `${folder}/${fileName}`;

    showToast(`正在上傳${label}...`);
    const { error } = await supabase.storage.from('post_media').upload(filePath, file);
    if (error) {
      alert(`${label}上傳失敗：${error.message}`);
      return;
    }
    pendingMediaItems.push({ kind, value: filePath, label: file.name });
    renderMediaList();
    showToast(`${label}上傳完成`);
  }

  mediaClipInput?.addEventListener('change', async (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files || files.length === 0) return;
    const file = files[0];
    if (file.size > MAX_CLIP_SIZE) {
      alert('短片上限 50MB，較長影片請改用 YouTube 連結');
      mediaClipInput.value = '';
      return;
    }
    await uploadMediaFile(file, 'clip', '短片');
    mediaClipInput.value = '';
  });

  mediaAudioInput?.addEventListener('change', async (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files || files.length === 0) return;
    await uploadMediaFile(files[0], 'audio', '錄音');
    mediaAudioInput.value = '';
  });

  function renderPreviews() {
    if (!imagePreviewContainer) return;
    if (currentImageUrls.length > 0) {
      imagePreviewContainer.style.display = 'grid';
      imagePreviewContainer.innerHTML = currentImageUrls.map((url, index) => `
        <div class="preview-item">
          <img src="${url}" />
          <button type="button" class="btn-remove-img" data-index="${index}">×</button>
        </div>
      `).join('');

      // 綁定移除按鈕
      imagePreviewContainer.querySelectorAll('.btn-remove-img').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
          currentImageUrls.splice(index, 1);
          currentImagePaths.splice(index, 1);
          renderPreviews();
        });
      });
    } else {
      imagePreviewContainer.style.display = 'none';
    }
  }

  // 圖片上傳：私有 bucket post_media，路徑為 {post_id}/{檔名}；
  // 新增文章時 id 尚未存在，先存進 pending/ 暫存資料夾，送出表單成功拿到 id 後再搬移歸位
  postImageInput?.addEventListener('change', async (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files || files.length === 0) return;

    showToast(`正在上傳 ${files.length} 張圖片...`);

    const existingId = (document.getElementById('post-id') as HTMLInputElement).value;
    const folder = existingId || 'pending';

    for (const file of Array.from(files)) {
      const fileName = `${Math.random().toString(36).substring(2)}.${file.name.split('.').pop()}`;
      const filePath = `${folder}/${fileName}`;

      const { error } = await supabase.storage.from('post_media').upload(filePath, file);
      if (error) {
        alert('上傳失敗：' + error.message);
        continue;
      }

      const { data: signedData, error: signError } = await supabase.storage
        .from('post_media')
        .createSignedUrl(filePath, 3600);
      if (signError || !signedData) {
        alert('產生預覽網址失敗：' + (signError?.message || '未知錯誤'));
        continue;
      }

      currentImagePaths.push(filePath);
      currentImageUrls.push(signedData.signedUrl);
    }

    renderPreviews();
    showToast('圖片上傳完成');
  });

  // 提交表單
  postForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (savePostBtn) (savePostBtn as HTMLButtonElement).disabled = true;

    const id = (document.getElementById('post-id') as HTMLInputElement).value;
    const title = (document.getElementById('post-title') as HTMLInputElement).value;
    const content = (document.getElementById('post-content') as HTMLTextAreaElement).value;
    const weather = (document.getElementById('post-weather') as HTMLInputElement).value;
    const visibility = (document.getElementById('post-visibility') as HTMLSelectElement).value;
    const reading_time = Math.max(1, Math.ceil(content.length / 300));
    const category_id = (document.getElementById('post-category') as HTMLSelectElement).value || null;
    const createdAtLocal = (document.getElementById('post-created-at') as HTMLInputElement).value;
    const created_at = createdAtLocal ? new Date(createdAtLocal).toISOString() : undefined;

    const postData: any = { title, content, weather, visibility, reading_time, category_id };
    if (created_at) postData.created_at = created_at;

    // 存進資料庫的是 post_media 內的路徑，不是網址（簽名網址會過期，不能落地儲存）
    postData.image_urls = currentImagePaths;
    // 為了向下相容，將第一張圖路徑存入單數欄位
    if (currentImagePaths.length > 0) {
      postData.image_url = currentImagePaths[0];
    }

    let error;
    let newPost: any = null;
    let noPermission = false;

    console.log('發送的 Payload:', postData);

    if (id) {
      // 加 .select() 是為了拿到實際受影響的列：RLS 擋下 UPDATE 時不會回傳錯誤，只會影響 0 筆，
      // 若只看 error 會誤判成功（此專案已多次遇過同一個坑）
      const { data: updateData, error: err } = await supabase
        .from('posts')
        .update(postData)
        .eq('id', id)
        .select();
      error = err;
      if (!err && (!updateData || updateData.length === 0)) noPermission = true;
    } else {
      const { data, error: err } = await supabase.from('posts').insert([postData]).select().single();
      error = err;
      newPost = data;
    }

    if (error) {
      console.error('Supabase 儲存錯誤:', error);
      alert(`儲存失敗: ${error.message || '未知錯誤'}`);
      if (savePostBtn) (savePostBtn as HTMLButtonElement).disabled = false;
    } else if (noPermission) {
      alert('沒有權限或資料不存在，未實際變更');
      if (savePostBtn) (savePostBtn as HTMLButtonElement).disabled = false;
    } else {
      // 靜默觸發重新部署
      triggerDeploy();

      if (id) {
        // 同步媒體項目：先刪除被移除的，已存在的更新排序，新增的寫入資料庫
        for (const delId of deletedMediaIds) {
          await supabase.from('post_media_items').delete().eq('id', delId);
        }
        for (let i = 0; i < pendingMediaItems.length; i++) {
          const m = pendingMediaItems[i];
          if (m.dbId) {
            // 加 .select() 是為了拿到實際受影響的列：RLS 擋下 UPDATE 時不會回傳錯誤，只會影響 0 筆，
            // 若只看 error 會誤判成功（此專案已多次遇過同一個坑）
            const { data: updateData, error: updateError } = await supabase
              .from('post_media_items')
              .update({ sort_order: i })
              .eq('id', m.dbId)
              .select();
            if (updateError) {
              alert('媒體排序更新失敗：' + updateError.message);
            } else if (!updateData || updateData.length === 0) {
              alert('媒體排序更新失敗：沒有權限或項目不存在（實際未變更），請重新整理頁面確認現況');
            }
          } else {
            const { error: mediaError } = await supabase
              .from('post_media_items')
              .insert({ post_id: id, kind: m.kind, value: m.value, sort_order: i });
            if (mediaError) alert('部分媒體項目儲存失敗：' + mediaError.message);
          }
        }
        deletedMediaIds = [];

        // 同步標籤關聯
        await syncPostTags(id, tagMapByPostId.get(id) || []);

        showToast('已更新');
      } else if (newPost) {
        // 新文章的照片先前存在 pending/ 暫存資料夾，現在已拿到真正的 id，搬移歸位
        if (currentImagePaths.some((p) => p.startsWith('pending/'))) {
          const finalPaths: string[] = [];
          for (const p of currentImagePaths) {
            if (p.startsWith('pending/')) {
              const fileName = p.split('/').pop();
              const newPath = `${newPost.id}/${fileName}`;
              const { error: moveError } = await supabase.storage.from('post_media').move(p, newPath);
              finalPaths.push(moveError ? p : newPath);
            } else {
              finalPaths.push(p);
            }
          }
          const { error: fixupError } = await supabase
            .from('posts')
            .update({ image_urls: finalPaths, image_url: finalPaths[0] || null })
            .eq('id', newPost.id);
          if (fixupError) {
            console.warn('照片搬移後更新資料庫失敗：', fixupError);
          } else {
            newPost.image_urls = finalPaths;
            newPost.image_url = finalPaths[0] || null;
          }
        }

        // 新文章的短片/錄音先前可能存在 pending/ 暫存資料夾，搬移歸位；YouTube 項目不涉及檔案，直接寫入
        for (let i = 0; i < pendingMediaItems.length; i++) {
          const m = pendingMediaItems[i];
          if ((m.kind === 'clip' || m.kind === 'audio') && m.value.startsWith('pending/')) {
            const fileName = m.value.split('/').pop();
            const newPath = `${newPost.id}/${fileName}`;
            const { error: moveError } = await supabase.storage.from('post_media').move(m.value, newPath);
            if (!moveError) m.value = newPath;
          }
          const { error: mediaError } = await supabase
            .from('post_media_items')
            .insert({ post_id: newPost.id, kind: m.kind, value: m.value, sort_order: i });
          if (mediaError) alert('部分媒體項目儲存失敗：' + mediaError.message);
        }

        // 同步標籤關聯（新文章，先前沒有任何關聯）
        await syncPostTags(newPost.id, []);

        showToast('已發布');
      }

      resetForm();
      // 儲存成功後直接重新抓一次資料重繪，取代先前「手動一塊塊修 DOM」的做法——
      // 這樣分類/標籤徽章、排序、卡片內容都保證跟資料庫一致，也不用重新整理頁面就能看到最新狀態；
      // 若目前有搜尋字串，refreshPostsList() 內部會重新套用，不會被洗掉
      await refreshPostsList();
    }
  });

  // 輔助函數：生成文章 HTML；coverUrl 為預先算好的簽名網址，photoCount 為照片張數
  function createPostHtml(post: any, isAdmin: boolean, coverUrl: string | null = null, photoCount: number = 0) {
    return `
      <div class="post-item" data-id="${post.id}" data-created-at="${post.created_at}">
        ${coverUrl ? `
          <div class="post-cover">
            <img src="${coverUrl}" alt="${post.title}" width="400" height="300" loading="lazy" />
            ${photoCount > 1 ? `<span class="post-cover-badge">${photoCount} 張</span>` : ''}
          </div>
        ` : ''}
        <div class="post-header">
          <div class="visibility-dot dot-${post.visibility}" title="${post.visibility === 'public' ? '公開' : post.visibility === 'friends' ? '朋友' : '私人'}"></div>
          <a href="/posts/${post.id}" class="post-title-link">${post.title}</a>
        </div>
        <div class="post-meta">
          ${post.weather ? `<span>${post.weather} ・ </span>` : ''}
          <span>${new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
          <span> ・ 閱讀約 ${post.reading_time} 分鐘</span>
        </div>
        <p class="post-preview">${post.content.replace(/[*_#\[\]()]/g, '').substring(0, 80)}...</p>
        ${isAdmin ? renderCategoryTagBadges(post) : ''}
        ${isAdmin ? `
          <div class="post-item-actions admin-only" style="display: flex;">
            <button class="btn-inline-edit" data-post='${JSON.stringify(post).replace(/'/g, "&apos;")}'>編輯</button>
            <button class="btn-inline-delete" data-id="${post.id}">刪除</button>
          </div>
        ` : ''}
      </div>
    `;
  }

  // 分類／標籤徽章（僅管理員視角渲染，訪客完全看不到，呼應「訪客體驗不變」）；
  // 點擊徽章會把該名稱填入搜尋框並觸發同一套搜尋，不另外維護一套篩選狀態
  function renderCategoryTagBadges(post: any): string {
    const category = post.category_id ? categoriesCache.find((c) => c.id === post.category_id) : null;
    const tagIds = tagMapByPostId.get(String(post.id)) || [];
    const tagNames = tagIds.map((tid) => tagsCache.find((t) => t.id === tid)?.name).filter(Boolean) as string[];
    if (!category && tagNames.length === 0) return '';
    return `
      <div class="post-badges admin-only" style="display: flex;">
        ${category ? `<button type="button" class="post-category-badge" data-filter="${escapeHtml(category.name)}">${escapeHtml(category.name)}</button>` : ''}
        ${tagNames.map((n) => `<button type="button" class="post-tag-badge" data-filter="${escapeHtml(n)}">#${escapeHtml(n)}</button>`).join('')}
      </div>
    `;
  }

  // 列表按鈕事件 (採用事件委派，解決重複詢問問題)
  const postsContainer = document.getElementById('posts-container');
  postsContainer?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    // 編輯功能
    if (target.classList.contains('btn-inline-edit')) {
      const post = JSON.parse(target.dataset.post || '{}');
      (document.getElementById('post-id') as HTMLInputElement).value = post.id;
      (document.getElementById('post-title') as HTMLInputElement).value = post.title;
      (document.getElementById('post-content') as HTMLTextAreaElement).value = post.content;
      (document.getElementById('post-weather') as HTMLInputElement).value = post.weather || '';
      (document.getElementById('post-visibility') as HTMLSelectElement).value = post.visibility;
      (document.getElementById('post-category') as HTMLSelectElement).value = post.category_id || '';
      (document.getElementById('post-created-at') as HTMLInputElement).value = post.created_at
        ? toDatetimeLocalValue(new Date(post.created_at))
        : toDatetimeLocalValue(new Date());
      pendingTagIds = [...(tagMapByPostId.get(String(post.id)) || [])];
      renderTagChips();

      // 載入圖片陣列：資料庫存的是路徑，先轉成簽名網址才能預覽
      currentImagePaths = post.image_urls || (post.image_url ? [post.image_url] : []);
      currentImageUrls = [];
      renderPreviews();
      if (currentImagePaths.length > 0) {
        Promise.all(
          currentImagePaths.map((path: string) =>
            supabase.storage.from('post_media').createSignedUrl(path, 3600)
          )
        ).then((results) => {
          currentImageUrls = results.map((r) => r.data?.signedUrl || '');
          renderPreviews();
        });
      }

      // 載入既有媒體項目
      pendingMediaItems = [];
      deletedMediaIds = [];
      renderMediaList();
      const { data: mediaItems } = await supabase
        .from('post_media_items')
        .select('*')
        .eq('post_id', post.id)
        .order('sort_order', { ascending: true });
      if (mediaItems && mediaItems.length > 0) {
        pendingMediaItems = mediaItems.map((m: any) => ({
          dbId: m.id,
          kind: m.kind,
          value: m.value,
          label: m.kind === 'youtube' ? `YouTube：${m.value}` : m.value.split('/').pop()
        }));
        renderMediaList();
      }

      if (savePostBtn) savePostBtn.textContent = '更新文章';
      if (addPostSection) addPostSection.style.display = 'block';
      if (openAddFormBtn) openAddFormBtn.style.display = 'none';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    // 刪除功能
    if (target.classList.contains('btn-inline-delete')) {
      if (!confirm('確定刪除？')) return;
      const id = target.dataset.id;
      // 加 .select() 是為了拿到實際受影響的列：RLS 擋下 DELETE 時不會回傳錯誤，只會影響 0 筆
      const { data: deleteData, error } = await supabase.from('posts').delete().eq('id', id).select();
      if (error) {
        alert('刪除失敗：' + error.message);
      } else if (!deleteData || deleteData.length === 0) {
        alert('沒有權限或資料不存在，未實際刪除');
      } else {
        showToast('已刪除');
        triggerDeploy();
        tagMapByPostId.delete(id as string);
        await refreshPostsList();
      }
      return;
    }

    // 點分類／標籤徽章：把名稱填入搜尋框並觸發同一套搜尋（不另外維護一套篩選狀態）
    const badge = target.closest('.post-category-badge, .post-tag-badge') as HTMLElement | null;
    if (badge) {
      const searchInput = document.getElementById('posts-search-input') as HTMLInputElement | null;
      if (searchInput) {
        searchInput.value = badge.dataset.filter || '';
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  });

  async function bindActions() {
    await checkAdmin();
    // 事件已委派至 postsContainer，此處僅需處理權限顯示
  }

  // 4. Client Side：登入後改為一次性重抓「全部」文章（public/friends/private，交由 RLS 過濾），
  // 依 created_at 整體排序重繪，取代舊版「private 內容固定插最前面」的作法。
  // 舊版問題：(1) private/friends 內容一律排在所有 public 內容之前，不管實際發布時間；
  // (2) 逐筆 insertAdjacentHTML('afterbegin') 還會讓 private 內容彼此之間的順序反過來。
  // seq 用來避免 onAuthStateChange 短時間內連續觸發多次時，較舊的回應覆蓋較新的畫面（同 trip.astro 的 authUIUpdateSeq 手法）
  let postsRefreshSeq = 0;
  // 依目前資料（postsCache 的子集）渲染卡片列表，供初次載入與搜尋篩選共用，不用每次搜尋都重查資料庫
  async function renderPostsList(list: any[], isAdmin: boolean) {
    const container = document.getElementById('posts-container');
    if (!container) return;

    if (list.length === 0) {
      container.innerHTML = '<p class="empty-state" id="empty-msg">尚無符合的短文</p>';
      return;
    }
    const itemsHtml = await Promise.all(list.map(async (post) => {
      const paths = post.image_urls && post.image_urls.length > 0
        ? post.image_urls
        : (post.image_url ? [post.image_url] : []);
      const { coverUrl, photoCount } = await getCoverInfo(paths);
      return createPostHtml(post, isAdmin, coverUrl, photoCount);
    }));
    container.innerHTML = itemsHtml.join('');
  }

  // 搜尋範圍：標題 + 內文 + 分類名 + 標籤名，純前端比對 postsCache，不重新查詢
  function applyPostsSearch() {
    const input = document.getElementById('posts-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('posts-search-clear');
    const query = (input?.value || '').trim().toLowerCase();
    if (clearBtn) clearBtn.style.display = query ? 'inline-block' : 'none';

    const filtered = !query ? postsCache : postsCache.filter((post) => {
      const category = post.category_id ? categoriesCache.find((c) => c.id === post.category_id) : null;
      const tagIds = tagMapByPostId.get(String(post.id)) || [];
      const tagNames = tagIds.map((tid) => tagsCache.find((t) => t.id === tid)?.name).filter(Boolean) as string[];
      const searchable = [post.title, post.content, category?.name, ...tagNames].filter(Boolean).join(' ').toLowerCase();
      return searchable.includes(query);
    });
    renderPostsList(filtered, true);
  }

  document.getElementById('posts-search-input')?.addEventListener('input', applyPostsSearch);
  document.getElementById('posts-search-clear')?.addEventListener('click', () => {
    const input = document.getElementById('posts-search-input') as HTMLInputElement | null;
    if (input) input.value = '';
    applyPostsSearch();
  });

  async function refreshPostsList() {
    const seq = ++postsRefreshSeq;
    const { data: { session } } = await supabase.auth.getSession();
    // 登入/登出按鈕的顯示狀態不該受「有沒有 session」擋住，兩種情況都要更新
    await checkAdmin();
    if (!session) return;
    const isAdmin = !!session;

    // 分類/標籤/關聯需在渲染卡片前載入完成，卡片上的分類與標籤徽章才查得到名稱
    await Promise.all([loadCategories(), loadTags(), loadTagMap()]);

    const { data, error } = await supabase
      .from('posts')
      .select('*')
      .order('created_at', { ascending: false });

    if (seq !== postsRefreshSeq) return;
    if (error || !data) return;

    postsCache = data;

    if (seq !== postsRefreshSeq) return;

    // 若目前有搜尋字串，重新套用搜尋（而不是直接整批重繪），避免搜尋結果被覆蓋掉——
    // 這支函式除了「使用者按下發布/刪除」會呼叫，Supabase 在視窗重新取得焦點時也可能重發
    // SIGNED_IN 事件間接觸發，若沒有這層保護，正在打字搜尋時畫面會突然跳回顯示全部文章
    const searchInput = document.getElementById('posts-search-input') as HTMLInputElement | null;
    if (searchInput && searchInput.value.trim()) {
      applyPostsSearch();
    } else {
      await renderPostsList(postsCache, isAdmin);
    }

    bindActions();
  }

  // 監聽 Auth 狀態變化，確保登入跳轉後能即時反應
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_IN' || event === 'INITIAL_SESSION') {
      refreshPostsList();
    }
  });

  // 保留初始呼叫作為備用
  refreshPostsList();
</script>
