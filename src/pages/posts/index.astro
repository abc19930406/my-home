---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Starfield from '../../components/Starfield.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { supabase } from '../../lib/supabase-client';
import '../../styles/posts.css';

// 1. Build Time: 抓取 public 文章
let publicPosts = [];
try {
  const { data, error } = await supabase
    .from('posts')
    .select('*')
    .eq('visibility', 'public')
    .order('created_at', { ascending: false });
    
  if (!error && data) {
    publicPosts = data;
  }
} catch (err) {
  console.warn('⚠️ Build Warning: 短文列表 Supabase 連線失敗，將顯示空列表。');
}

---

<Layout title="短文列表 | The Corner Table">
  <div class="top-right-auth-container">
    <div id="top-auth-guest" style="display: none;">
      <a href="/login?from=/posts" class="btn-top-auth">🔑 登入</a>
    </div>
    <div id="top-auth-user" style="display: none;">
      <button id="btn-top-logout" class="btn-top-auth">登出</button>
    </div>
  </div>
  <div class="bg-layer bg-day"></div>
  <div class="bg-layer bg-night"></div>
  <div class="halo-sun"></div>
  <style is:global>
  html, body { background-color: transparent !important; }
</style>
<div class="halo-moon"></div>
  <Starfield />

  <div class="notebook-container">
    <div class="notebook-spine"></div>
    <div class="notebook-page">
        <div class="notebook-content">
          <nav class="posts-nav">
            <a href="/" class="nav-link">← 返回首頁</a>
          </nav>

          <h1 class="page-title">日嚐</h1>

          <!-- 管理員操作：新增短文按鈕 -->
          <div class="admin-header-actions admin-only" style="display: none;">
            <button id="open-add-form" class="btn-add-post">
              <span>＋ 新增短文</span>
            </button>
          </div>

          <!-- 管理員操作：新增短文表單 -->
          <div id="add-post-section" class="add-post-section" style="display: none;">
            <div class="admin-form-card">
              <form id="post-form">
                <input type="hidden" id="post-id" />
                <div class="form-row">
                  <div class="form-group">
                    <label>標題</label>
                    <input type="text" id="post-title" required placeholder="標題..." />
                  </div>
                  <div class="form-group">
                    <label>天氣與地點</label>
                    <input type="text" id="post-weather" placeholder="晴・台南" />
                  </div>
                </div>
                <div class="form-group">
                  <label>正文 (Markdown)</label>
                  <textarea id="post-content" rows="8" required placeholder="寫點什麼..."></textarea>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>權限</label>
                    <select id="post-visibility">
                      <option value="public">公開</option>
                      <option value="friends">朋友</option>
                      <option value="private">私人</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>照片 (選填，支援多張)</label>
                    <input type="file" id="post-image" accept="image/*" multiple />
                    <input type="hidden" id="post-image-urls" />
                  </div>
                </div>
                <div id="image-previews-container" class="image-previews-grid" style="display: none; margin-bottom: 1rem;">
                  <!-- JS 動態插入預覽圖 -->
                </div>
                <div class="form-actions">
                  <button type="button" id="close-add-form" class="btn-cancel">取消</button>
                  <button type="submit" id="save-post-btn" class="btn-submit">發布文章</button>
                </div>
              </form>
            </div>
          </div>

          <div id="posts-container" class="post-list">
            {publicPosts.map((post) => (
              <div class="post-item" data-id={post.id}>
                <div class="post-header">
                  <div class={`visibility-dot dot-${post.visibility}`} title="公開"></div>
                  <a href={`/posts/${post.id}`} class="post-title-link">{post.title}</a>
                </div>
                <div class="post-meta">
                  {post.weather && <span>{post.weather} ・ </span>}
                  <span>{new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
                  <span> ・ 閱讀約 {post.reading_time} 分鐘</span>
                </div>
                <p class="post-preview">{post.content.replace(/[*_#\[\]()]/g, '').substring(0, 80)}...</p>
                
                <!-- 管理員操作：編輯/刪除按鈕 -->
                <div class="post-item-actions admin-only" style="display: none;">
                  <button class="btn-inline-edit" data-post={JSON.stringify(post)}>編輯</button>
                  <button class="btn-inline-delete" data-id={post.id}>刪除</button>
                </div>
              </div>
            ))}
            
            {publicPosts.length === 0 && <p class="empty-state" id="empty-msg">尚無公開短文</p>}
          </div>


        </div>
      </div>
    </div>
    <ThemeToggle />
    <div id="toast" class="toast"></div>
  </Layout>

<script>
  import { supabase } from '../../lib/supabase-client';

  // 觸發重新部署:改經後端 API 驗證管理員身分,hook 網址不再暴露於前端
  async function triggerDeploy() {
    try {
      const { data: { session: s } } = await supabase.auth.getSession();
      if (!s) return;
      await fetch('/api/trigger-deploy', {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + s.access_token },
      });
    } catch (err) {
      console.warn('無法觸發重新部署：', err);
    }
  }

  const toast = document.getElementById('toast');

  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.setAttribute('style', [
      'display: block',
      'position: fixed',
      'bottom: 20px',
      'left: 50%',
      'transform: translateX(-50%)',
      'background: rgba(0,0,0,0.8)',
      'color: #fff',
      'padding: 8px 16px',
      'border-radius: 20px',
      'z-index: 1000'
    ].join('; '));
    setTimeout(() => { if (toast) toast.style.display = 'none'; }, 3000);
  }

  // 1. 處理主題初始化
  const savedTheme = localStorage.getItem('tcr-theme') || 'day';
  document.documentElement.classList.toggle('theme-night', savedTheme === 'night');
  document.body.classList.add('posts-page');

  // 2. 權限檢查：如果是管理員，顯示管理功能
  const topAuthGuest = document.getElementById('top-auth-guest');
  const topAuthUser = document.getElementById('top-auth-user');
  
  document.getElementById('btn-top-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  async function checkAdmin() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      document.querySelectorAll('.admin-only').forEach(el => {
        (el as HTMLElement).style.display = 'flex';
      });
      if (topAuthGuest) topAuthGuest.style.display = 'none';
      if (topAuthUser) topAuthUser.style.display = 'block';
      return true;
    }
    if (topAuthGuest) topAuthGuest.style.display = 'block';
    if (topAuthUser) topAuthUser.style.display = 'none';
    return false;
  }

  // 3. 處理表單邏輯
  const openAddFormBtn = document.getElementById('open-add-form');
  const closeAddFormBtn = document.getElementById('close-add-form');
  const addPostSection = document.getElementById('add-post-section');
  const postForm = document.getElementById('post-form') as HTMLFormElement;
  const savePostBtn = document.getElementById('save-post-btn');
  const imagePreviewContainer = document.getElementById('image-previews-container');
  const postImageInput = document.getElementById('post-image') as HTMLInputElement;

  openAddFormBtn?.addEventListener('click', () => {
    if (addPostSection) addPostSection.style.display = 'block';
    openAddFormBtn.style.display = 'none';
  });

  closeAddFormBtn?.addEventListener('click', () => {
    resetForm();
  });

  function resetForm() {
    if (addPostSection) addPostSection.style.display = 'none';
    if (openAddFormBtn) openAddFormBtn.style.display = 'flex';
    postForm.reset();
    (document.getElementById('post-id') as HTMLInputElement).value = '';
    currentImageUrls = [];
    currentImagePaths = [];
    renderPreviews();
    if (savePostBtn) {
      savePostBtn.textContent = '發布文章';
      (savePostBtn as HTMLButtonElement).disabled = false;
    }
  }

  // currentImagePaths：存進資料庫的實際值（post_media 內的路徑，非網址）
  // currentImageUrls：僅供畫面預覽用的簽名網址（1 小時後失效，不落地儲存）
  let currentImageUrls: string[] = [];
  let currentImagePaths: string[] = [];

  function renderPreviews() {
    if (!imagePreviewContainer) return;
    if (currentImageUrls.length > 0) {
      imagePreviewContainer.style.display = 'grid';
      imagePreviewContainer.innerHTML = currentImageUrls.map((url, index) => `
        <div class="preview-item">
          <img src="${url}" />
          <button type="button" class="btn-remove-img" data-index="${index}">×</button>
        </div>
      `).join('');

      // 綁定移除按鈕
      imagePreviewContainer.querySelectorAll('.btn-remove-img').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
          currentImageUrls.splice(index, 1);
          currentImagePaths.splice(index, 1);
          renderPreviews();
        });
      });
    } else {
      imagePreviewContainer.style.display = 'none';
    }
  }

  // 圖片上傳：私有 bucket post_media，路徑為 {post_id}/{檔名}；
  // 新增文章時 id 尚未存在，先存進 pending/ 暫存資料夾，送出表單成功拿到 id 後再搬移歸位
  postImageInput?.addEventListener('change', async (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files || files.length === 0) return;

    showToast(`正在上傳 ${files.length} 張圖片...`);

    const existingId = (document.getElementById('post-id') as HTMLInputElement).value;
    const folder = existingId || 'pending';

    for (const file of Array.from(files)) {
      const fileName = `${Math.random().toString(36).substring(2)}.${file.name.split('.').pop()}`;
      const filePath = `${folder}/${fileName}`;

      const { error } = await supabase.storage.from('post_media').upload(filePath, file);
      if (error) {
        alert('上傳失敗：' + error.message);
        continue;
      }

      const { data: signedData, error: signError } = await supabase.storage
        .from('post_media')
        .createSignedUrl(filePath, 3600);
      if (signError || !signedData) {
        alert('產生預覽網址失敗：' + (signError?.message || '未知錯誤'));
        continue;
      }

      currentImagePaths.push(filePath);
      currentImageUrls.push(signedData.signedUrl);
    }

    renderPreviews();
    showToast('圖片上傳完成');
  });

  // 提交表單
  postForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (savePostBtn) (savePostBtn as HTMLButtonElement).disabled = true;

    const id = (document.getElementById('post-id') as HTMLInputElement).value;
    const title = (document.getElementById('post-title') as HTMLInputElement).value;
    const content = (document.getElementById('post-content') as HTMLTextAreaElement).value;
    const weather = (document.getElementById('post-weather') as HTMLInputElement).value;
    const visibility = (document.getElementById('post-visibility') as HTMLSelectElement).value;
    const reading_time = Math.max(1, Math.ceil(content.length / 300));

    const postData: any = { title, content, weather, visibility, reading_time };

    // 存進資料庫的是 post_media 內的路徑，不是網址（簽名網址會過期，不能落地儲存）
    postData.image_urls = currentImagePaths;
    // 為了向下相容，將第一張圖路徑存入單數欄位
    if (currentImagePaths.length > 0) {
      postData.image_url = currentImagePaths[0];
    }

    let error;
    let newPost: any = null;

    console.log('發送的 Payload:', postData);

    if (id) {
      const { error: err } = await supabase.from('posts').update(postData).eq('id', id);
      error = err;
    } else {
      const { data, error: err } = await supabase.from('posts').insert([postData]).select().single();
      error = err;
      newPost = data;
    }

    if (error) {
      console.error('Supabase 儲存錯誤:', error);
      alert(`儲存失敗: ${error.message || '未知錯誤'}`);
      if (savePostBtn) (savePostBtn as HTMLButtonElement).disabled = false;
    } else {
      // 靜默觸發重新部署
      triggerDeploy();

      if (id) {
        // 更新 UI
        const item = document.querySelector(`.post-item[data-id="${id}"]`);
        if (item) {
          const postToUpdate = { id, ...postData, created_at: (item as any).dataset.createdAt || new Date().toISOString() };
          item.querySelector('.post-title-link')!.textContent = title;
          item.querySelector('.post-meta')!.innerHTML = `
            ${weather ? `<span>${weather} ・ </span>` : ''}
            <span>${new Date(postToUpdate.created_at).toLocaleDateString('zh-TW')}</span>
            <span> ・ 閱讀約 ${reading_time} 分鐘</span>
          `;
          item.querySelector('.post-preview')!.textContent = content.replace(/[*_#\[\]()]/g, '').substring(0, 80) + '...';
          const editBtn = item.querySelector('.btn-inline-edit') as HTMLElement;
          editBtn.dataset.post = JSON.stringify(postToUpdate);
        }
        showToast('已更新');
      } else if (newPost) {
        // 新文章的照片先前存在 pending/ 暫存資料夾，現在已拿到真正的 id，搬移歸位
        if (currentImagePaths.some((p) => p.startsWith('pending/'))) {
          const finalPaths: string[] = [];
          for (const p of currentImagePaths) {
            if (p.startsWith('pending/')) {
              const fileName = p.split('/').pop();
              const newPath = `${newPost.id}/${fileName}`;
              const { error: moveError } = await supabase.storage.from('post_media').move(p, newPath);
              finalPaths.push(moveError ? p : newPath);
            } else {
              finalPaths.push(p);
            }
          }
          const { error: fixupError } = await supabase
            .from('posts')
            .update({ image_urls: finalPaths, image_url: finalPaths[0] || null })
            .eq('id', newPost.id);
          if (fixupError) {
            console.warn('照片搬移後更新資料庫失敗：', fixupError);
          } else {
            newPost.image_urls = finalPaths;
            newPost.image_url = finalPaths[0] || null;
          }
        }

        // 新增 UI
        const { data: { session } } = await supabase.auth.getSession();
        const html = createPostHtml(newPost, !!session);
        const container = document.getElementById('posts-container');
        const emptyMsg = document.getElementById('empty-msg');
        if (emptyMsg) emptyMsg.style.display = 'none';
        container?.insertAdjacentHTML('afterbegin', html);
        showToast('已發布');
      }

      resetForm();
    }
  });

  // 輔助函數：生成文章 HTML
  function createPostHtml(post: any, isAdmin: boolean) {
    return `
      <div class="post-item" data-id="${post.id}" data-created-at="${post.created_at}">
        <div class="post-header">
          <div class="visibility-dot dot-${post.visibility}" title="${post.visibility === 'public' ? '公開' : post.visibility === 'friends' ? '朋友' : '私人'}"></div>
          <a href="/posts/${post.id}" class="post-title-link">${post.title}</a>
        </div>
        <div class="post-meta">
          ${post.weather ? `<span>${post.weather} ・ </span>` : ''}
          <span>${new Date(post.created_at).toLocaleDateString('zh-TW')}</span>
          <span> ・ 閱讀約 ${post.reading_time} 分鐘</span>
        </div>
        <p class="post-preview">${post.content.replace(/[*_#\[\]()]/g, '').substring(0, 80)}...</p>
        ${isAdmin ? `
          <div class="post-item-actions admin-only" style="display: flex;">
            <button class="btn-inline-edit" data-post='${JSON.stringify(post).replace(/'/g, "&apos;")}'>編輯</button>
            <button class="btn-inline-delete" data-id="${post.id}">刪除</button>
          </div>
        ` : ''}
      </div>
    `;
  }

  // 列表按鈕事件 (採用事件委派，解決重複詢問問題)
  const postsContainer = document.getElementById('posts-container');
  postsContainer?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    // 編輯功能
    if (target.classList.contains('btn-inline-edit')) {
      const post = JSON.parse(target.dataset.post || '{}');
      (document.getElementById('post-id') as HTMLInputElement).value = post.id;
      (document.getElementById('post-title') as HTMLInputElement).value = post.title;
      (document.getElementById('post-content') as HTMLTextAreaElement).value = post.content;
      (document.getElementById('post-weather') as HTMLInputElement).value = post.weather || '';
      (document.getElementById('post-visibility') as HTMLSelectElement).value = post.visibility;
      
      // 載入圖片陣列：資料庫存的是路徑，先轉成簽名網址才能預覽
      currentImagePaths = post.image_urls || (post.image_url ? [post.image_url] : []);
      currentImageUrls = [];
      renderPreviews();
      if (currentImagePaths.length > 0) {
        Promise.all(
          currentImagePaths.map((path: string) =>
            supabase.storage.from('post_media').createSignedUrl(path, 3600)
          )
        ).then((results) => {
          currentImageUrls = results.map((r) => r.data?.signedUrl || '');
          renderPreviews();
        });
      }
      
      if (savePostBtn) savePostBtn.textContent = '更新文章';
      if (addPostSection) addPostSection.style.display = 'block';
      if (openAddFormBtn) openAddFormBtn.style.display = 'none';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    // 刪除功能
    if (target.classList.contains('btn-inline-delete')) {
      if (!confirm('確定刪除？')) return;
      const id = target.dataset.id;
      const { error } = await supabase.from('posts').delete().eq('id', id);
      if (!error) {
        showToast('已刪除');
        triggerDeploy();
        const item = target.closest('.post-item');
        item?.remove();
      }
    }
  });

  async function bindActions() {
    await checkAdmin();
    // 事件已委派至 postsContainer，此處僅需處理權限顯示
  }

  // 4. Client Side: 抓取私密文章並顯示
  async function fetchPrivatePosts() {
    const { data: { session } } = await supabase.auth.getSession();
    const isAdmin = !!session;

    const { data, error } = await supabase
      .from('posts')
      .select('*')
      .neq('visibility', 'public')
      .order('created_at', { ascending: false });

    if (!error && data && data.length > 0) {
      const container = document.getElementById('posts-container');
      const emptyMsg = document.getElementById('empty-msg');
      if (emptyMsg) emptyMsg.style.display = 'none';

      data.forEach(post => {
        if (document.querySelector(`[data-id="${post.id}"]`)) return;
        const postHtml = createPostHtml(post, isAdmin);
        container?.insertAdjacentHTML('afterbegin', postHtml);
      });
    }
    
    bindActions();
  }

  // 監聽 Auth 狀態變化，確保登入跳轉後能即時反應
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_IN' || event === 'INITIAL_SESSION') {
      fetchPrivatePosts();
    }
  });

  // 保留初始呼叫作為備用
  fetchPrivatePosts();
</script>
