---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/ledger.css';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL ?? '';
---

<Layout title="記帳系統 | The Corner Table">
  <div class="ledger-body">
    <div class="ledger-container">
      <header class="ledger-header">
        <div class="header-top">
          <a href="/" class="nav-back">← Back</a>
          <div class="header-top-right" style="display: flex; gap: 0.5rem; align-items: center;">
            <div id="top-auth-guest" style="display: none;">
              <a href="/login?from=/ledger" class="btn-top-auth">🔑 登入</a>
            </div>
            <button id="btn-manage-categories" class="btn-manage-categories" style="display: none;">⚙️ 管理類別</button>
            <div id="top-auth-user" style="display: none;">
              <button id="btn-top-logout" class="btn-top-auth">登出</button>
            </div>
          </div>
        </div>
        <h1 class="page-title">記帳</h1>
        <p class="page-subtitle">收支紀錄・薪資來源</p>
        <div class="exchange-rate-display">
          <span id="exchange-rate-text">載入匯率中...</span>
          <button id="btn-refresh-rate" class="btn-refresh-rate" title="重新整理匯率">🔄</button>
        </div>
        <div id="manual-rate-container" class="manual-rate-container" style="display: none;">
          <label for="manual-rate-input">手動輸入匯率：1 JPY = </label>
          <input type="number" id="manual-rate-input" class="manual-rate-input" step="0.0001" value="0.22" /> TWD
        </div>
        <hr class="header-divider" />
      </header>

      <!-- 月份導航 -->
      <section class="month-nav">
        <button id="prev-month" class="nav-arrow" title="上個月">
          <i class="ti ti-chevron-left"></i>
        </button>
        <div id="current-month-text" class="current-month-display">
          載入中...
        </div>
        <button id="next-month" class="nav-arrow" title="下個月">
          <i class="ti ti-chevron-right"></i>
        </button>
      </section>

      <!-- 指標卡片 -->
      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">本月收入</div>
          <div id="total-income" class="stat-value income">$0</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">本月支出</div>
          <div id="total-expense" class="stat-value expense">$0</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">本月結餘</div>
          <div id="total-balance" class="stat-value balance">$0</div>
        </div>
      </section>

      <!-- 收入來源分佈 -->
      <section class="distribution-section">
        <h2 class="section-title">收入來源分佈</h2>
        <div id="income-chart" class="distribution-list">
          <!-- JS 動態插入 -->
        </div>
      </section>

      <!-- 支出分類分佈 -->
      <section class="distribution-section">
        <h2 class="section-title">支出分類分佈</h2>
        <div id="expense-chart" class="distribution-list">
          <!-- JS 動態插入 -->
        </div>
        <div id="jpy-stats" class="jpy-stats-section">
          <div class="jpy-stats-text">本月日幣支出合計 <span id="jpy-total-jpy">¥0</span></div>
          <div class="jpy-stats-twd">≈ <span id="jpy-total-twd">NT$ 0</span></div>
        </div>
      </section>

      <!-- 明細列表 -->
      <section class="list-section">
        <div class="list-header">
          <h2 class="section-title">本月明細</h2>
          <button id="btn-add-transaction" class="btn-add">+ 新增</button>
        </div>
        <div id="transaction-list" class="transaction-list">
          <!-- JS 動態插入 -->
        </div>
      </section>

      <!-- 底部連結 -->

    </div>
  </div>

  <!-- 新增/編輯 Modal -->
  <div id="transaction-modal" class="modal-overlay">
    <div class="modal-content">
      <h3 id="modal-title" class="modal-title">新增紀錄</h3>
      <div class="type-switch">
        <button id="type-income" class="type-btn active income" data-type="income">收入</button>
        <button id="type-expense" class="type-btn expense" data-type="expense">支出</button>
      </div>
      <form id="transaction-form">
        <input type="hidden" id="edit-id" />
        <div class="form-group">
          <label for="category-select">分類</label>
          <select id="category-select" class="form-control" required></select>
        </div>
        <div class="form-group">
          <div class="currency-switch" id="currency-switch" style="display: none;">
            <button type="button" class="currency-btn active" data-currency="TWD">台幣 (TWD)</button>
            <button type="button" class="currency-btn" data-currency="JPY">日幣 (JPY)</button>
          </div>
          <label for="amount-input" id="amount-label">金額 (NTD)</label>
          <input type="number" id="amount-input" class="form-control" required placeholder="請輸入金額" />
          <div id="conversion-hint" class="conversion-hint" style="display: none;"></div>
        </div>
        <div class="form-group">
          <label for="date-input">日期</label>
          <input type="date" id="date-input" class="form-control" required />
        </div>
        <div class="form-group">
          <label for="note-input" id="note-label">備註</label>
          <input type="text" id="note-input" class="form-control" placeholder="選填" />
        </div>
        <div class="modal-actions">
          <button type="button" id="btn-delete-transaction" class="btn-delete-record" style="display: none;">刪除</button>
          <button type="button" id="btn-cancel" class="btn-cancel">取消</button>
          <button type="submit" class="btn-save">儲存</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 類別管理 Modal -->
  <div id="category-modal" class="modal-overlay">
    <div class="modal-content category-modal-content">
      <h3 class="modal-title">管理類別</h3>
      <div class="category-tabs">
        <button class="category-tab-btn active" data-tab="income">收入來源</button>
        <button class="category-tab-btn" data-tab="expense">支出分類</button>
      </div>
      
      <div id="category-list-container" class="category-list-container">
        <!-- JS 動態插入 -->
      </div>

      <form id="add-category-form" class="add-category-form">
        <input type="text" id="new-category-input" class="form-control" placeholder="輸入新類別名稱" required />
        <button type="submit" class="btn-add-category">＋ 新增</button>
      </form>

      <div class="modal-actions">
        <button type="button" id="btn-close-category" class="btn-cancel">關閉</button>
      </div>
    </div>
  </div>

  <!-- 其他明細 Modal -->
  <div id="other-details-modal" class="modal-overlay">
    <div class="modal-content other-details-content">
      <h3 id="other-details-title" class="modal-title">其他明細</h3>
      <div id="other-details-list" class="other-details-list">
        <!-- JS 動態插入 -->
      </div>
      <div class="modal-actions">
        <button type="button" id="btn-close-other-details" class="btn-cancel">關閉</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>
</Layout>

<script define:vars={{ supabaseUrl, supabaseAnonKey, adminEmail }}>
(async () => {
  const waitForSupabase = () => new Promise(resolve => {
    if (window._supabaseCreateClient) return resolve();
    window.addEventListener('supabase-ready', resolve, { once: true });
  });
  await waitForSupabase();
  const createClient = window._supabaseCreateClient;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  // 1. 權限保護
  const { data: { session } } = await supabase.auth.getSession();
  const btnManageCategories = document.getElementById('btn-manage-categories');
  const topAuthGuest = document.getElementById('top-auth-guest');
  const topAuthUser = document.getElementById('top-auth-user');

  document.getElementById('btn-top-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  if (!session) {
    if (topAuthGuest) topAuthGuest.style.display = 'block';
    window.location.href = '/login?from=/ledger';
    return;
  }

  // 記帳系統僅管理員本人可用：已登入但非管理員（含白名單朋友/家人帳號）一律導回首頁，
  // 不導去登入頁——問題不是沒登入，是沒有權限（比照 JapanCollection.astro 的 isAdminUser 判斷模式）
  if (session.user.email !== adminEmail) {
    alert('僅管理員可使用記帳系統');
    window.location.href = '/';
    return;
  }

  if (topAuthUser) topAuthUser.style.display = 'block';
  if (btnManageCategories) btnManageCategories.style.display = 'block';

  // 2. 狀態管理
  let currentMonth = new Date(); // 目前選中的月份
  let transactions = [];
  let editingId = null;
  let currentExchangeRate = null;
  let currentCurrency = 'TWD';
  let rawCategories = { income: [], expense: [] };
  let categories = { income: [], expense: [] };

  // 3. UI 元素
  const monthText = document.getElementById('current-month-text');
  const incomeList = document.getElementById('income-chart');
  const expenseList = document.getElementById('expense-chart');
  const listContainer = document.getElementById('transaction-list');
  const totalIncomeEl = document.getElementById('total-income');
  const totalExpenseEl = document.getElementById('total-expense');
  const totalBalanceEl = document.getElementById('total-balance');
  
  const modal = document.getElementById('transaction-modal');
  const form = document.getElementById('transaction-form');
  const typeBtns = document.querySelectorAll('.type-btn');
  const categorySelect = document.getElementById('category-select');
  const amountInput = document.getElementById('amount-input');
  const amountLabel = document.getElementById('amount-label');
  const dateInput = document.getElementById('date-input');
  const noteInput = document.getElementById('note-input');
  const noteLabel = document.getElementById('note-label');
  const deleteBtn = document.getElementById('btn-delete-transaction');
  const toast = document.getElementById('toast');
  
  const categoryModal = document.getElementById('category-modal');
  const btnCloseCategory = document.getElementById('btn-close-category');
  const categoryTabs = document.querySelectorAll('.category-tab-btn');
  const categoryListContainer = document.getElementById('category-list-container');
  const addCategoryForm = document.getElementById('add-category-form');
  const newCategoryInput = document.getElementById('new-category-input');
  let currentCategoryTab = 'income';

  const otherDetailsModal = document.getElementById('other-details-modal');
  const otherDetailsTitle = document.getElementById('other-details-title');
  const otherDetailsList = document.getElementById('other-details-list');
  const btnCloseOtherDetails = document.getElementById('btn-close-other-details');
  
  const rateText = document.getElementById('exchange-rate-text');
  const refreshRateBtn = document.getElementById('btn-refresh-rate');
  const currencySwitch = document.getElementById('currency-switch');
  const currencyBtns = document.querySelectorAll('.currency-btn');
  const conversionHint = document.getElementById('conversion-hint');
  const jpyStatsSection = document.getElementById('jpy-stats');
  const jpyTotalJpyEl = document.getElementById('jpy-total-jpy');
  const jpyTotalTwdEl = document.getElementById('jpy-total-twd');
  const manualRateContainer = document.getElementById('manual-rate-container');
  const manualRateInput = document.getElementById('manual-rate-input');

  // 4. 輔助函數
  const formatDate = (d) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const formatCurrency = (val) => '$' + Math.abs(val).toLocaleString();
  const showToast = (msg) => {
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => toast.style.display = 'none', 2000);
  };

  async function loadCategories() {
    const { data: incData } = await supabase.from('income_categories').select('*').order('sort_order', { ascending: true });
    const { data: expData } = await supabase.from('expense_categories').select('*').order('sort_order', { ascending: true });
    rawCategories.income = incData || [];
    rawCategories.expense = expData || [];
    categories.income = rawCategories.income.map(c => c.name);
    categories.expense = rawCategories.expense.map(c => c.name);
  }

  // 匯率相關
  async function fetchExchangeRate() {
    refreshRateBtn.classList.add('spinning');
    manualRateContainer.style.display = 'none';
    try {
      let rate = null;
      const res = await fetch('/api/exchange-rate');
      if (res.ok) {
        const data = await res.json();
        rate = data.rate || null;
      }

      if (rate) {
        currentExchangeRate = rate;
        const now = new Date();
        const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        rateText.textContent = `目前匯率：1 JPY ≈ ${currentExchangeRate.toFixed(4)} TWD (${timeStr})`;
        calculateConversion();
      } else {
        throw new Error('All APIs failed');
      }
    } catch (e) {
      rateText.textContent = '匯率載入失敗';
      manualRateContainer.style.display = 'flex';
      currentExchangeRate = parseFloat(manualRateInput.value) || 0.22;
      calculateConversion();
    } finally {
      refreshRateBtn.classList.remove('spinning');
    }
  }

  refreshRateBtn.onclick = fetchExchangeRate;
  
  manualRateInput.oninput = (e) => {
    currentExchangeRate = parseFloat(e.target.value) || 0.22;
    calculateConversion();
  };

  // 5. 核心邏輯：載入資料
  async function loadData() {
    const y = currentMonth.getFullYear();
    const m = currentMonth.getMonth();
    monthText.textContent = `${y} 年 ${m + 1} 月`;

    const firstDay = formatDate(new Date(y, m, 1));
    const lastDay = formatDate(new Date(y, m + 1, 0));

    const { data, error } = await supabase
      .from('transactions')
      .select('*')
      .gte('date', firstDay)
      .lte('date', lastDay)
      .order('date', { ascending: false });

    if (error) {
      showToast('載入失敗');
      return;
    }
    transactions = data || [];
    render();
  }

  function render() {
    let incomeSum = 0;
    let expenseSum = 0;
    let monthJpySum = 0;
    let monthJpyTwdSum = 0;
    const incomeMap = {};
    const expenseMap = {};

    transactions.forEach(t => {
      if (t.type === 'income') {
        incomeSum += t.amount;
        incomeMap[t.category] = (incomeMap[t.category] || 0) + t.amount;
      } else {
        expenseSum += t.amount;
        expenseMap[t.category] = (expenseMap[t.category] || 0) + t.amount;
        if (t.currency === 'JPY') {
          monthJpySum += t.amount_jpy || 0;
          monthJpyTwdSum += t.amount;
        }
      }
    });

    // 頂部指標
    totalIncomeEl.textContent = formatCurrency(incomeSum);
    totalExpenseEl.textContent = formatCurrency(expenseSum);
    totalBalanceEl.textContent = formatCurrency(incomeSum - expenseSum);

    // 分佈圖表
    const renderChart = (map, container, total, type) => {
      const sorted = Object.entries(map).sort((a, b) => b[1] - a[1]);
      container.innerHTML = sorted.map(([cat, val]) => {
        const percent = total > 0 ? (val / total * 100) : 0;
        return `
          <div class="chart-item clickable-category" data-category="${cat}" data-type="${type}">
            <div class="chart-info">
              <span>${cat}</span>
              <span>${formatCurrency(val)}</span>
            </div>
            <div class="chart-bar-bg">
              <div class="chart-bar-fill ${type}-bar" style="width: ${percent}%"></div>
            </div>
          </div>
        `;
      }).join('') || '<div class="text-muted">本月尚無紀錄</div>';
    };
    renderChart(incomeMap, incomeList, incomeSum, 'income');
    renderChart(expenseMap, expenseList, expenseSum, 'expense');

    // 日幣統計
    if (monthJpySum > 0) {
      jpyStatsSection.style.display = 'block';
      jpyTotalJpyEl.textContent = `¥${monthJpySum.toLocaleString()}`;
      jpyTotalTwdEl.textContent = `NT$ ${monthJpyTwdSum.toLocaleString()}`;
    } else {
      jpyStatsSection.style.display = 'none';
    }

    // 明細列表
    listContainer.innerHTML = transactions.map(t => {
      const isJPY = t.currency === 'JPY';
      const amountHtml = isJPY
        ? `<div class="item-amount-wrapper">
             <div class="item-amount ${t.type}">${t.type === 'income' ? '+' : '-'}¥${(t.amount_jpy||0).toLocaleString()}</div>
             <div class="item-amount-twd">(NT$ ${t.amount.toLocaleString()})</div>
           </div>`
        : `<div class="item-amount ${t.type}">${t.type === 'income' ? '+' : '-'}${t.amount.toLocaleString()}</div>`;

      return `
      <div class="transaction-item" data-id="${t.id}">
        <div class="item-date">${t.date.split('-').slice(1).join('/')}</div>
        <div class="item-note">${t.note || t.category}</div>
        <div class="item-category">${t.category}</div>
        ${amountHtml}
      </div>
      `;
    }).join('') || '<div class="text-muted" style="text-align:center; padding: 2rem;">本月尚無明細</div>';
  }

  // 分類明細點擊邏輯
  const handleChartClick = (e) => {
    const itemEl = e.target.closest('.clickable-category');
    if (!itemEl) return;
    const cat = itemEl.dataset.category;
    const type = itemEl.dataset.type;
    
    const filtered = transactions.filter(t => t.type === type && t.category === cat);
    otherDetailsTitle.textContent = `${cat}明細 - ${monthText.textContent}`;
    otherDetailsList.innerHTML = filtered.map(t => {
      const amt = t.currency === 'JPY' ? `¥${(t.amount_jpy||0).toLocaleString()} (NT$${t.amount.toLocaleString()})` : `NT$${t.amount.toLocaleString()}`;
      const noteText = t.note ? t.note : '<span class="text-muted">無備註</span>';
      return `
        <div class="other-detail-item">
          <div class="detail-date">${t.date.split('-').slice(1).join('/')}</div>
          <div class="detail-note">${noteText}</div>
          <div class="detail-amount ${t.type}">${t.type === 'income' ? '+' : '-'}${amt}</div>
        </div>
      `;
    }).join('') || '<div class="text-muted text-center" style="padding: 1rem;">無紀錄</div>';
    otherDetailsModal.style.display = 'flex';
  };
  incomeList.onclick = handleChartClick;
  expenseList.onclick = handleChartClick;
  btnCloseOtherDetails.onclick = () => otherDetailsModal.style.display = 'none';

  // 6. Modal 與 表單邏輯
  function openModal(item = null) {
    editingId = item ? item.id : null;
    document.getElementById('modal-title').textContent = item ? '編輯紀錄' : '新增紀錄';
    deleteBtn.style.display = item ? 'block' : 'none';

    const type = item ? item.type : 'expense';
    updateTypeUI(type);
    updateCategories(type, item ? item.category : '');
    
    // 幣別處理
    const itemCurrency = (item && item.currency) ? item.currency : 'TWD';
    setCurrency(itemCurrency);
    
    if (itemCurrency === 'JPY') {
      amountInput.value = item ? item.amount_jpy : '';
    } else {
      amountInput.value = item ? item.amount : '';
    }
    calculateConversion();

    dateInput.value = item ? item.date : formatDate(new Date());
    noteInput.value = item ? item.note : '';
    
    modal.style.display = 'flex';
  }

  function updateTypeUI(type) {
    typeBtns.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.type === type);
    });
    if (type === 'expense') {
      currencySwitch.style.display = 'flex';
    } else {
      currencySwitch.style.display = 'none';
      setCurrency('TWD');
    }
  }

  function updateCategories(type, selectedValue = '') {
    const list = categories[type];
    categorySelect.innerHTML = list.map(c => `<option value="${c}" ${c === selectedValue ? 'selected' : ''}>${c}</option>`).join('');
    checkNoteRequired();
  }

  function checkNoteRequired() {
    const isOther = categorySelect.value === '其他';
    noteLabel.innerHTML = isOther ? '備註 <span style="color:var(--expense-color)">*</span>' : '備註';
    noteInput.required = isOther;
    noteInput.placeholder = isOther ? '請說明具體來源/類別' : '選填';
  }

  function setCurrency(cur) {
    currentCurrency = cur;
    currencyBtns.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.currency === cur);
    });
    if (cur === 'JPY') {
      amountLabel.textContent = '金額 (日幣 ¥)';
      conversionHint.style.display = 'block';
    } else {
      amountLabel.textContent = '金額 (台幣)';
      conversionHint.style.display = 'none';
    }
    calculateConversion();
  }

  function calculateConversion() {
    if (currentCurrency === 'JPY') {
      const val = parseInt(amountInput.value);
      if (!isNaN(val) && currentExchangeRate) {
        const twd = Math.round(val * currentExchangeRate);
        conversionHint.textContent = `≈ NT$ ${twd.toLocaleString()} (匯率 ${currentExchangeRate.toFixed(4)})`;
      } else {
        conversionHint.textContent = '';
      }
    }
  }

  currencyBtns.forEach(btn => {
    btn.onclick = () => setCurrency(btn.dataset.currency);
  });

  amountInput.oninput = calculateConversion;

  categorySelect.onchange = checkNoteRequired;

  typeBtns.forEach(btn => {
    btn.onclick = () => {
      updateTypeUI(btn.dataset.type);
      updateCategories(btn.dataset.type);
    };
  });

  document.getElementById('btn-add-transaction').onclick = () => openModal();
  document.getElementById('btn-cancel').onclick = () => modal.style.display = 'none';

  listContainer.onclick = (e) => {
    const itemEl = e.target.closest('.transaction-item');
    if (itemEl) {
      const id = itemEl.dataset.id;
      const item = transactions.find(t => t.id == id);
      openModal(item);
    }
  };

  form.onsubmit = async (e) => {
    e.preventDefault();
    const type = document.querySelector('.type-btn.active').dataset.type;
    const inputVal = parseInt(amountInput.value);
    
    let amount = inputVal;
    let amount_jpy = null;
    let exchange_rate = null;
    let currency = 'TWD';

    if (currentCurrency === 'JPY') {
      currency = 'JPY';
      amount_jpy = inputVal;
      exchange_rate = currentExchangeRate;
      amount = Math.round(inputVal * (currentExchangeRate || 0.21)); // 若無匯率給個預設值
    }

    const payload = {
      type,
      category: categorySelect.value,
      amount,
      amount_jpy,
      exchange_rate,
      currency,
      date: dateInput.value,
      note: noteInput.value
    };

    let res;
    if (editingId) {
      res = await supabase.from('transactions').update(payload).eq('id', editingId);
    } else {
      res = await supabase.from('transactions').insert(payload);
    }

    if (res.error) {
      showToast('儲存失敗');
    } else {
      showToast('儲存成功');
      modal.style.display = 'none';
      loadData();
    }
  };

  deleteBtn.onclick = async () => {
    if (!confirm('確定要刪除這筆紀錄？')) return;
    const { error } = await supabase.from('transactions').delete().eq('id', editingId);
    if (error) {
      showToast('刪除失敗');
    } else {
      showToast('已刪除');
      modal.style.display = 'none';
      loadData();
    }
  };

  // 管理類別邏輯
  function renderCategoryList() {
    const list = rawCategories[currentCategoryTab];
    categoryListContainer.innerHTML = list.map((c, idx) => `
      <div class="category-manage-item">
        <span class="category-manage-name">${c.name}</span>
        <div class="category-manage-actions">
          <button type="button" class="btn-icon btn-move-up" data-id="${c.id}" data-idx="${idx}" ${idx === 0 ? 'disabled' : ''}>↑</button>
          <button type="button" class="btn-icon btn-move-down" data-id="${c.id}" data-idx="${idx}" ${idx === list.length - 1 ? 'disabled' : ''}>↓</button>
          <button type="button" class="btn-icon btn-edit-cat" data-id="${c.id}" data-name="${c.name}">✎</button>
          <button type="button" class="btn-icon btn-delete-cat" data-id="${c.id}" data-name="${c.name}" ${c.name === '其他' ? 'disabled title="不可刪除預設類別"' : ''}>×</button>
        </div>
      </div>
    `).join('');
  }

  categoryTabs.forEach(btn => {
    btn.onclick = () => {
      categoryTabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCategoryTab = btn.dataset.tab;
      renderCategoryList();
    };
  });

  if (btnManageCategories) {
    btnManageCategories.onclick = () => {
      renderCategoryList();
      categoryModal.style.display = 'flex';
    };
  }
  btnCloseCategory.onclick = () => categoryModal.style.display = 'none';

  categoryListContainer.onclick = async (e) => {
    const table = currentCategoryTab === 'income' ? 'income_categories' : 'expense_categories';
    const list = rawCategories[currentCategoryTab];
    
    if (e.target.classList.contains('btn-move-up') || e.target.classList.contains('btn-move-down')) {
      const idx = parseInt(e.target.dataset.idx);
      const isUp = e.target.classList.contains('btn-move-up');
      const targetIdx = isUp ? idx - 1 : idx + 1;
      
      const item1 = list[idx];
      const item2 = list[targetIdx];
      const tempOrder = item1.sort_order;
      item1.sort_order = item2.sort_order;
      item2.sort_order = tempOrder;
      
      await Promise.all([
        supabase.from(table).update({ sort_order: item1.sort_order }).eq('id', item1.id),
        supabase.from(table).update({ sort_order: item2.sort_order }).eq('id', item2.id)
      ]);
      await loadCategories();
      renderCategoryList();
      return;
    }

    if (e.target.classList.contains('btn-edit-cat')) {
      const id = e.target.dataset.id;
      const oldName = e.target.dataset.name;
      if (oldName === '其他') {
        alert('「其他」為系統預設類別，無法更改名稱。');
        return;
      }
      const newName = prompt('請輸入新的類別名稱：', oldName);
      if (newName && newName.trim() !== '' && newName !== oldName) {
        const { error } = await supabase.from(table).update({ name: newName.trim() }).eq('id', id);
        if (!error) {
          await supabase.from('transactions').update({ category: newName.trim() }).eq('category', oldName).eq('type', currentCategoryTab);
          await loadCategories();
          renderCategoryList();
          loadData();
        } else {
          showToast('修改失敗');
        }
      }
      return;
    }

    if (e.target.classList.contains('btn-delete-cat')) {
      const id = e.target.dataset.id;
      const name = e.target.dataset.name;
      
      const { count } = await supabase.from('transactions').select('*', { count: 'exact', head: true }).eq('category', name).eq('type', currentCategoryTab);
      if (count > 0) {
        alert(`無法刪除：目前有 ${count} 筆紀錄正在使用「${name}」類別。請先修改或刪除這些紀錄。`);
        return;
      }
      
      if (confirm(`確定要刪除類別「${name}」？`)) {
        await supabase.from(table).delete().eq('id', id);
        await loadCategories();
        renderCategoryList();
      }
      return;
    }
  };

  addCategoryForm.onsubmit = async (e) => {
    e.preventDefault();
    const newName = newCategoryInput.value.trim();
    if (!newName) return;
    
    const table = currentCategoryTab === 'income' ? 'income_categories' : 'expense_categories';
    const list = rawCategories[currentCategoryTab];
    const maxOrder = list.length > 0 ? Math.max(...list.map(c => c.sort_order)) : 0;
    
    const { error } = await supabase.from(table).insert({ name: newName, sort_order: maxOrder + 1 });
    if (!error) {
      newCategoryInput.value = '';
      await loadCategories();
      renderCategoryList();
    } else {
      showToast('新增失敗');
    }
  };

  // 7. 月份導航
  document.getElementById('prev-month').onclick = () => {
    currentMonth.setMonth(currentMonth.getMonth() - 1);
    loadData();
  };
  document.getElementById('next-month').onclick = () => {
    currentMonth.setMonth(currentMonth.getMonth() + 1);
    loadData();
  };

  // 8. 初始化
  await loadCategories();
  fetchExchangeRate();
  loadData();
})();
</script>
