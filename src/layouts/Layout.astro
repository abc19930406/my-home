---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="The Corner Table — 一個安靜角落，存放思緒與生活" />
		<!-- Tabler Icons Webfont -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css" />
		<!-- Google Fonts: Noto Serif TC for cafe menu feel -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
		<title>The Corner Table</title>
		
		<!-- PWA -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#2C1E14" />
		<meta name="mobile-web-app-capable" content="yes" />

		<!-- iOS 專用 -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Corner Table" />
		<link rel="apple-touch-icon" href="/icons/icon-180.png" />

		<!-- Service Worker -->
		<script>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/sw.js').catch(err => console.error('SW registration failed:', err));
			}
		</script>
		
		<!-- Supabase 全域載入 -->
		<script type="module">
			import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';
			window._supabaseCreateClient = createClient;
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		background-color: #2C1E14;
		font-family: 'Noto Serif TC', 'Georgia', serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
body.posts-page { background-color: transparent !important; }
</style>
