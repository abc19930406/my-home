---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="The Corner Table — 一個安靜角落，存放思緒與生活" />
		<!-- Tabler Icons Webfont -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css" />
		<!-- Google Fonts: Noto Serif TC for cafe menu feel -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
		<title>The Corner Table</title>
		
		<!-- PWA -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#2C1E14" />
		<meta name="mobile-web-app-capable" content="yes" />

		<!-- iOS 專用 -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Corner Table" />
		<link rel="apple-touch-icon" href="/icons/icon-180.png" />

		<!-- 清除舊版 Service Worker -->
		<script>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.getRegistrations().then(function(registrations) {
					for(let registration of registrations) {
						registration.unregister();
					}
				});
			}
		</script>
		
	</head>
	<body>
		<slot />
		<div id="ptr-spinner" class="ptr-spinner"></div>
		<style>
		  .ptr-spinner {
		    position: fixed;
		    top: 20px;
		    left: 50%;
		    transform: translateX(-50%);
		    width: 32px;
		    height: 32px;
		    border: 3px solid rgba(255, 255, 255, 0.3);
		    border-top: 3px solid rgba(255, 255, 255, 0.8);
		    border-radius: 50%;
		    z-index: 9999;
		    display: none;
		    animation: ptr-spin 1s linear infinite;
		  }
		  @keyframes ptr-spin {
		    0% { transform: translateX(-50%) rotate(0deg); }
		    100% { transform: translateX(-50%) rotate(360deg); }
		  }
		</style>
		<script is:inline>
		  (function() {
		    const spinner = document.getElementById('ptr-spinner');
		    if (!spinner) return;
		    let startY = 0;
		    let startX = 0;
		    let isPulling = false;

		    document.addEventListener('touchstart', (e) => {
		      if (document.body.classList.contains('modal-open')) return;
		      if (window.scrollY <= 0) {
		        startY = e.touches[0].clientY;
		        startX = e.touches[0].clientX;
		        isPulling = true;
		      }
		    }, { passive: true });

		    document.addEventListener('touchmove', (e) => {
		      if (!isPulling) return;
		      const currentY = e.touches[0].clientY;
		      const currentX = e.touches[0].clientX;
		      const deltaY = currentY - startY;
		      const deltaX = Math.abs(currentX - startX);

		      // 避免與橫向滑動衝突
		      if (deltaX > deltaY) {
		        isPulling = false;
		        return;
		      }

		      if (window.scrollY <= 0 && deltaY > 0) {
		        if (deltaY > 20) {
		          spinner.style.display = 'block';
		        }
		      }
		    }, { passive: true });

		    document.addEventListener('touchend', (e) => {
		      if (!isPulling) return;
		      const currentY = e.changedTouches[0].clientY;
		      const deltaY = currentY - startY;

		      if (window.scrollY <= 0 && deltaY > 80) {
		        location.reload();
		      } else {
		        spinner.style.display = 'none';
		      }
		      isPulling = false;
		    });
		  })();
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		background-color: #2C1E14;
		font-family: 'Noto Serif TC', 'Georgia', serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
body.posts-page { background-color: transparent !important; }
</style>
